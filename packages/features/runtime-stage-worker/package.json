{
  "name": "@hierarchidb/runtime-stage-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../tsdown.config.ts",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --project tsconfig.build.json --outDir dist",
    "pretypecheck": "pnpm run build:types",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@hierarchidb/batch-session-ports": "workspace:*"
  },
  "devDependencies": {
    "typescript": "workspace:*",
    "vitest": "^3.2.4"
  }
}
