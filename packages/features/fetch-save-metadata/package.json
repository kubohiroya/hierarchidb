{
  "name": "@hierarchidb/fetch-save-metadata",
  "version": "0.0.1",
  "description": "Fetch and transform metadata from various open data sources",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./output/*": {
      "default": "./output/*"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --project tsconfig.build.json --outDir dist",
    "lint": "eslint src",
    "format": "biome check --write src",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^9.34.0",
    "prettier": "^3.2.5",
    "typescript": "workspace:^5.9.3",
    "undici-types": "^7.15.0"
  },
  "files": [
    "dist",
    "output",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "metadata",
    "gadm",
    "osm",
    "open-data",
    "geo",
    "country"
  ],
  "author": "",
  "license": "MIT"
}
