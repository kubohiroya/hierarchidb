{
  "name": "@hierarchidb/tabular-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "ports": [
        "dist/ports.d.ts"
      ],
      "registry": [
        "dist/registry.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/ports.ts src/registry.ts src/types.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "typescript": "workspace:^5.9.3"
  }
}
