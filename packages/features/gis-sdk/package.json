{
  "name": "@hierarchidb/gis-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/shape-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/vectortile-store": "workspace:*",
    "@mapbox/vector-tile": "^2.0.4",
    "@maplibre/vt-pbf": "^4.0.3",
    "@turf/area": "^7.0.0",
    "@turf/bbox": "^7.0.0",
    "@turf/bbox-polygon": "^7.0.0",
    "@turf/boolean-point-in-polygon": "^7.0.0",
    "@turf/clean-coords": "^7.0.0",
    "@turf/helpers": "^7.0.0",
    "@turf/simplify": "^7.0.0",
    "@turf/turf": "^7.0.0",
    "flatgeobuf": "^4.4.0",
    "geojson-vt": "^3.2.1",
    "pbf": "^4.0.1",
    "typescript-lru-cache": "^2.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/vt-pbf": "^3.1.0",
    "typescript": "workspace:^5.9.3"
  }
}
