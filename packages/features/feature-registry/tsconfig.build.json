{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@hierarchidb/feature-registry": [
        "src/index.ts"
      ],
      "@hierarchidb/feature-registry/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
