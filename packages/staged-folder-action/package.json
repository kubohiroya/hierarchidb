{
  "name": "@hierarchidb/staged-folder-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./map-image-capture-browser-host": {
      "types": "./dist/createMapImageCaptureBrowserActionRunner.d.ts",
      "import": "./dist/createMapImageCaptureBrowserActionRunner.js"
    },
    "./export-file-host": {
      "types": "./dist/createExportFileActionRunner.d.ts",
      "import": "./dist/createExportFileActionRunner.js"
    },
    "./cli": {
      "types": "./dist/runStagedFolderActionCli.d.ts",
      "import": "./dist/runStagedFolderActionCli.js"
    }
  },
  "bin": {
    "hdb-staged-folder-action": "./dist/runStagedFolderActionCliEntry.js"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/createMapImageCaptureBrowserActionRunner.ts src/createExportFileActionRunner.ts src/runStagedFolderActionCli.ts src/runStagedFolderActionCliEntry.ts --config ../../tsdown.config.ts --outDir dist --splitting false --target node18 --format esm --banner.js '#!/usr/bin/env node'",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run --passWithNoTests",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@playwright/test": "^1.58.2",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "workspace:^5.9.3",
    "vitest": "^4.1.0"
  }
}
