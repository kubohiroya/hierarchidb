{
  "name": "@hierarchidb/util",
  "version": "1.0.0",
  "description": "General purpose utility functions for HierarchiDB",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hierarchidb",
    "utilities",
    "helpers"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
