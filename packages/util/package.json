{
  "name": "@hierarchidb/util",
  "version": "1.0.0",
  "description": "General purpose utility functions for HierarchiDB",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "keywords": [
    "hierarchidb",
    "utilities",
    "helpers"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.1.0",
    "tsup": "^8.5.0",
    "typescript": "workspace:^5.9.3",
    "dexie": "4.2.0"
  },
  "peerDependencies": {
    "dexie": "4.2.0"
  },
  "tsup": {
    "external": [
      "dexie"
    ]
  }
}
