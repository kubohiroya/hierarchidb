{
  "name": "@hierarchidb/plugin-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "dist/registry.js",
  "types": "dist/registry.d.ts",
  "files": [
    "dist",
    "generated",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./derivations": {
      "types": "./dist/derivations.d.ts",
      "import": "./dist/derivations.js",
      "default": "./dist/derivations.js"
    },
    "./generated/registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    }
  },
  "devDependencies": {},
  "dependencies": {
    "maplibre-gl": "^5.7.3",
    "@hierarchidb/resolver-plugin": "workspace:*",
    "@hierarchidb/basemap-plugin": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/linker-plugin": "workspace:*",
    "@hierarchidb/location-plugin": "workspace:*",
    "@hierarchidb/route-plugin": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/styler-plugin": "workspace:*",
    "@hierarchidb/timeline-plugin": "workspace:*"
  },
  "scripts": {
    "build": "pnpm run clean && tsdown generated/registry.ts generated/types.ts generated/derivations.ts --config ../../tsdown.config.ts --outDir dist && node ./scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/basemap-plugin#build",
          "@hierarchidb/folder-plugin#build",
          "@hierarchidb/linker-plugin#build",
          "@hierarchidb/location-plugin#build",
          "@hierarchidb/resolver-plugin#build",
          "@hierarchidb/route-plugin#build",
          "@hierarchidb/shape-plugin#build",
          "@hierarchidb/spreadsheet-plugin#build",
          "@hierarchidb/styler-plugin#build",
          "@hierarchidb/timeline-plugin#build"
        ],
        "outputs": [
          "dist/**"
        ]
      }
    }
  },
  "tsdown": {
    "splitting": false,
    "platform": "browser",
    "target": "es2020",
    "external": [
      "@hierarchidb/*"
    ]
  }
}
