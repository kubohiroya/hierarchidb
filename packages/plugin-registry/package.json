{
  "name": "@hierarchidb/plugin-registry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "": [
        "src/index.ts"
      ],
      "*": [
        "src/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate": "pnpm --filter @hierarchidb/tools run gen-plugin-loaders",
    "prebuild": "pnpm run clean && pnpm run generate",
    "build": "pnpm run clean && pnpm run generate && tsup",
    "build:types": "pnpm run clean && pnpm run generate && tsup --dts-only",
    "pretypecheck": "pnpm run clean && pnpm run generate",
    "typecheck": "api-extractor run --local",
    "lint": "eslint src"
  },
  "dependencies": {},
  "devDependencies": {
    "@microsoft/api-extractor": "^7.53.1",
    "tsup": "^8.5.0",
    "typescript": "workspace:^5.9.3"
  },
  "turbo": {
    "pipeline": {
      "build:types": {
        "dependsOn": [
          "@hierarchidb/tools#gen-plugin-loaders",
          "^build:types"
        ]
      }
    }
  }
}
