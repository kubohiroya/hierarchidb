{
  "name": "@hierarchidb/plugin-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "dist/registry.js",
  "types": "dist/registry.d.ts",
  "files": [
    "dist",
    "generated",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./derivations": {
      "types": "./dist/derivations.d.ts",
      "import": "./dist/derivations.js",
      "default": "./dist/derivations.js"
    },
    "./generated/registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    }
  },
  "devDependencies": {},
  "dependencies": {
    "maplibre-gl": "^5.7.3"
  },
  "scripts": {
    "build": "pnpm run clean && tsdown generated/registry.ts generated/types.ts generated/derivations.ts --config ../../tsdown.config.ts --outDir dist && node ./scripts/postbuild.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "outputs": [
          "dist/**"
        ]
      }
    }
  },
  "tsdown": {
    "splitting": false,
    "platform": "browser",
    "target": "es2020",
    "external": [
      "@hierarchidb/*"
    ]
  }
}
