{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "skipLibCheck": false
  },
  "include": [
    "src/**/*",
    ".generated/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
