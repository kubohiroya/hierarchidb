{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*",
    ".generated/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
