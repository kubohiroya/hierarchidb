{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "types": [
      "node",
      "react-transition-group"
    ]
  },
  "include": [
    "src/**/*",
    "../../types/react-transition-group/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": false,
    "reason": "Headless SDK types should fully type-check without skipLibCheck."
  }
}
