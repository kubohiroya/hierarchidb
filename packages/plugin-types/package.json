{
  "name": "@hierarchidb/plugin-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./runtime-stub.js",
      "default": "./runtime-stub.js"
    }
  },
  "files": [
    "dist",
    "runtime-stub.js"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "api-extractor run --local",
    "typecheck": "api-extractor run --local"
  },
  "peerDependencies": {
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/download": "workspace:*"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.49.3",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/download": "workspace:*"
  },
  "tsup": {
    "external": [
      "@hierarchidb/plugin-ui-sdk",
      "@hierarchidb/plugin-ui-sdk/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/download",
      "@hierarchidb/download/*"
    ]
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/plugin-ui-sdk#build",
          "@hierarchidb/common-types#build",
          "@hierarchidb/common-api#build",
          "@hierarchidb/batch#build",
          "@hierarchidb/download#build"
        ]
      },
      "typecheck": {
        "dependsOn": [
          "@hierarchidb/plugin-ui-sdk#build",
          "@hierarchidb/common-types#build",
          "@hierarchidb/common-api#build",
          "@hierarchidb/batch#build",
          "@hierarchidb/download#build"
        ]
      }
    }
  }
}
