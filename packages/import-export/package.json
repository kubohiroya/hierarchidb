{
  "name": "@hierarchidb/import-export",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "test": "node --max-old-space-size=512 src/__tests__/vector-tile-export.test.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/import-export-api": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/import-export-api": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "typescript": "workspace:^5.9.3"
  }
}
