{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/plugin-registry": [
        "../../packages/plugin-registry/generated/registry.ts"
      ],
      "@hierarchidb/plugin-registry/derivations": [
        "../../packages/plugin-registry/generated/derivations.ts"
      ],
      "@hierarchidb/plugin-registry/types": [
        "../../packages/plugin-registry/generated/types.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src*.d.ts",
    "../../packages/plugin-registry/generated/**/*.ts",
    "../../packages/plugin-registry/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/e2e*.test.ts",
    "src*.spec.ts"
  ],
  "references": [
    {
      "path": "../plugin-service-api"
    }
  ]
}
