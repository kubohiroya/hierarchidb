{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "outDir": "./dist",
    "module": "ESNext",
    "target": "es2022",
    "moduleResolution": "node",
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "strict": true,
    "noImplicitAny": false,
    "baseUrl": "../../../",
    "paths": {
      "~/*": [
        "packages/runtime-worker/worker/src/*"
      ],
      "@hierarchidb/tabular": [
        "packages/feature/tabular/src/index.ts"
      ],
      "@hierarchidb/download": [
        "packages/feature/download/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor": [
        "packages/runtime-shared/batch-processor/src/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
