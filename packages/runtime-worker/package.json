{
  "name": "@hierarchidb/runtime-worker",
  "version": "0.0.1",
  "description": "Worker-side database and processing for hierarchidb",
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./stage-worker": {
      "types": "./dist/stageWorker.entry.d.ts",
      "import": "./dist/stageWorker.entry.js",
      "default": "./dist/stageWorker.entry.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/stageWorker.entry.ts --config ../../../tsdown.config.ts --outDir dist",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "wfl": "node -e \"require('fs').mkdirSync('../../../reports/runtime-worker', { recursive: true })\" && vitest run src/__tests__/wfl/cp-routing-wc.wfl.test.ts --reporter=default --reporter=junit --outputFile=../../../reports/runtime-worker/cp-routing-wfl.xml",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "biome check --write src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\""
  },
  "dependencies": {
    "@hierarchidb/gis-sdk": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/route-engine": "workspace:*",
    "@hierarchidb/route-store": "workspace:*",
    "@hierarchidb/shape-store": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@mapbox/vector-tile": "^2.0.3",
    "comlink": "^4.4.2",
    "dexie": "^4.2.1",
    "inversify": "^6.0.2",
    "lunr": "2.3.9",
    "pbf": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.22.3"
  },
  "peerDependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/compute": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/feature-registry": "workspace:*",
    "@hierarchidb/import-export": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/map-source": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/route-engine": "workspace:*",
    "@hierarchidb/route-store": "workspace:*",
    "@hierarchidb/shape-store": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "jotai": "^2.13.1"
  },
  "optionalDependencies": {
    "@hierarchidb/tabular-source-xlsx": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/compute": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/feature-registry": "workspace:*",
    "@hierarchidb/import-export": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/map-source": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/route-engine": "workspace:*",
    "@hierarchidb/route-store": "workspace:*",
    "@hierarchidb/shape-store": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@types/lunr": "^2.3.7",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "fake-indexeddb": "^6.2.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build",
          "@hierarchidb/batch-runtime-services#build"
        ],
        "outputs": [
          "dist/**"
        ]
      }
    }
  }
}
