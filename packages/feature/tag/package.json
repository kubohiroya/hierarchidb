{
  "name": "@hierarchidb/tag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:bundle",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types",
    "prebuild:bundle": "pnpm run build:types"
  },
  "peerDependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "tsup": {
    "external": [
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*"
    ]
  }
}
