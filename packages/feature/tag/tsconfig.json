{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../../",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/common-type": [
        "../../common/types/src"
      ],
      "@hierarchidb/common-api": [
        "../../common/api/src"
      ],
      "@hierarchidb/util": [
        "../../util/src"
      ],
      "~/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "temporary: unresolved third-party types (please replace or fix)"
  }
}
