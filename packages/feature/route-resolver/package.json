{
  "name": "@hierarchidb/route-resolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "peerDependencies": {
    "@webgpu/types": "*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "workspace:^5.9.3"
  },
  "tsup": {
    "external": [
      "@webgpu/types",
      "@webgpu/types/*"
    ]
  }
}
