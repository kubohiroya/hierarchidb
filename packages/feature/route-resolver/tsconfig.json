{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "../../../node_modules",
    "../../../dist",
    "../../../build",
    "../../../coverage",
    "../../../.turbo"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
