{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/tabular": [
        "../tabular/src"
      ],
      "@hierarchidb/tabular/*": [
        "../tabular/src/*"
      ],
      "~/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ]
}
