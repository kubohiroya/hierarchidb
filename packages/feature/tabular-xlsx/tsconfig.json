{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "dist",
    "declaration": true,
    "composite": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/tabular": [
        "../tabular/src"
      ],
      "~/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "temporary: unresolved third-party types (please replace or fix)"
  }
}
