{
  "name": "@hierarchidb/map-view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "maplibre-gl": "^3",
    "deck.gl": "^9"
  },
  "dependencies": {
    "@hierarchidb/map-source": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.4.0"
  },
  "tsup": {
    "external": [
      "deck.gl",
      "maplibre-gl"
    ]
  }
}
