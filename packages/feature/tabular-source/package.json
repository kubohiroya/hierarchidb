{
  "name": "@hierarchidb/tabular-source",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "ports": [
        "dist/ports.d.ts"
      ],
      "registry": [
        "dist/registry.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./ports": {
      "types": "./dist/ports.d.ts",
      "import": "./dist/ports.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "tsup": "^8.0.1",
    "typescript": "workspace:^5.9.3"
  },
  "tsup": {
    "external": [
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*"
    ]
  }
}
