{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "outDir": "dist",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "paths": {
      "~/*": [
        "packages/feature/auth-recovery/src/*"
      ]
    },
    "module": "NodeNext"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
