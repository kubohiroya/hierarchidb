{
  "name": "@hierarchidb/auth-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm run build:clean",
    "build": "pnpm run build:types && pnpm run build:bundle",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types"
  },
  "peerDependencies": {
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  }
}
