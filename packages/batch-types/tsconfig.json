{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "skipLibCheck": true
  },
  "include": [
    "../batch-runtime-services/dist/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "references": [
    { "path": "../batch-runtime-services/tsconfig.build.json" },
    { "path": "../common/types/tsconfig.build.json" },
    { "path": "../common/api/tsconfig.build.json" }
  ]
}
