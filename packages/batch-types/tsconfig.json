{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "paths": {
      "@hierarchidb/common-types": ["../common/types/dist/index.d.ts"],
      "@hierarchidb/common-types/*": ["../common/types/dist/*"],
      "@hierarchidb/common-api": ["../common/api/dist/index.d.ts"],
      "@hierarchidb/common-api/*": ["../common/api/dist/*"],
      "@hierarchidb/runtime-worker": ["../runtime/worker/dist/index.d.ts"],
      "@hierarchidb/runtime-worker/*": ["../runtime/worker/dist/*"],
      "@hierarchidb/batch-runtime-services": ["../batch-runtime-services/dist/index.d.ts"],
      "@hierarchidb/batch-runtime-services/*": ["../batch-runtime-services/dist/*"],
      "@hierarchidb/batch-types": ["../batch-runtime-services/dist/types.d.ts"]
    }
  },
  "include": [
    "../batch-runtime-services/dist/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
