{
  "name": "@hierarchidb/batch-types",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "api-extractor run --local",
    "typecheck": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@hierarchidb/batch": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/batch": "workspace:*",
    "@microsoft/api-extractor": "^7.49.3"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/batch#build",
          "@hierarchidb/common-api#build",
          "@hierarchidb/common-types#build"
        ]
      }
    }
  }
}
