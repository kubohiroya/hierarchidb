{
  "name": "@hierarchidb/runtime-ui-search-result-window",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/ui-floating-window": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "storybook": "^8.4.7",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "jotai": "^2.13.1"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "jotai",
      "react",
      "react-dom"
    ]
  }
}
