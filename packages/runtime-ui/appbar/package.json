{
  "name": "@hierarchidb/runtime-ui-appbar",
  "version": "1.0.0",
  "description": "Application-specific AppBar components for HierarchiDB",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*"
  },
  "peerDependencies": {
    "@mui/icons-material": "^5.0.0",
    "@mui/material": "^7.3.1",
    "react": ">=18.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.1.2",
    "typescript": "^5.5.3",
    "react": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^5.0.0"
  },
  "keywords": [
    "hierarchidb",
    "runtime",
    "appbar",
    "ui"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-router-dom"
    ]
  }
}
