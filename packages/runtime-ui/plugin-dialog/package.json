{
  "name": "@hierarchidb/runtime-ui-plugin-dialog",
  "version": "0.0.1",
  "type": "module",
  "description": "Runtime plugin dialog components for HierarchiDB",
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@mui/material": "^7.1.0",
    "@mui/icons-material": "^7.3.1",
    "comlink": "^4.4.2",
    "jotai": "^2.11.2",
    "react": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
