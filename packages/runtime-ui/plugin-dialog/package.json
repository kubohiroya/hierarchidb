{
  "name": "@hierarchidb/runtime-ui-plugin-dialog",
  "version": "0.0.1",
  "type": "module",
  "description": "Runtime plugin dialog components for HierarchiDB",
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "prebuild": "pnpm run build:clean",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "build:tsc": "pnpm run build:types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs"
  },
  "dependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/plugins-base-plugin": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "comlink": "^4.4.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "~5.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.1.0",
    "@mui/icons-material": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "jotai": "^2.11.2",
    "react-router-dom": ">=7.0.0"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "@hierarchidb/ui-icon",
      "@hierarchidb/runtime-worker-bootstrap",
      "@hierarchidb/ui-core",
      "jotai",
      "react-router-dom",
      "react",
      "react-dom"
    ]
  }
}
