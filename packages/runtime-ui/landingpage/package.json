{
  "name": "@hierarchidb/runtime-ui-landingpage",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "pnpm run build:types",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "react": ">=18.0.0",
    "@mui/material": "^7.0.0",
    "@mui/icons-material": "^7.3.1"
  },
  "dependencies": {},
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-router"
    ]
  }
}
