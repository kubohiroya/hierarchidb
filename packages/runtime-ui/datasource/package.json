{
  "name": "@hierarchidb/runtime-ui-datasource",
  "version": "0.1.0",
  "description": "Data source selection and license agreement components for HierarchiDB",
  "keywords": [
    "hierarchidb",
    "ui",
    "datasource",
    "components"
  ],
  "author": "HierarchiDB Team",
  "license": "Proprietary",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/runtime-shared-fetch-metadata": "workspace:*"
  },
  "peerDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react"
    ]
  }
}
