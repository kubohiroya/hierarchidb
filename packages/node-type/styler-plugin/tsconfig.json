{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM"
    ],
    "noEmit": false,
    "composite": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "../../runtime-ui/plugin-dialog"
      ],
      "@hierarchidb/node-type-spreadsheet-plugin": [
        "../spreadsheet-plugin"
      ],
      "@hierarchidb/ui-core": [
        "../../ui/core"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "src/tests/**"
  ],
  "references": [],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
