{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@hierarchidb/tag": ["../../feature/tag/dist/index.d.ts"],
      "@hierarchidb/common-type": ["../../common/types/dist/index.d.ts"],
      "@hierarchidb/runtime-ui-plugin-dialog": ["../../runtime-ui/plugin-dialog/src_deprecated"],
      "@hierarchidb/runtime-ui-plugin-dialog/*": ["../../runtime-ui/plugin-dialog/src_deprecated/*"]
    },
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/definitions/**",
    "src/handlers/ExtensibleFolderHandler.ts"
  ]
}
