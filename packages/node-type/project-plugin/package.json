{
  "name": "@hierarchidb/project-plugin",
  "version": "0.0.1",
  "description": "Project management plugin for HierarchiDB with Deck.gl visualization",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "import": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hierarchidb/base-plugin": "workspace:*",
    "@hello-pangea/dnd": "^16.6.0",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-date": "workspace:*",
    "@turf/turf": "^7.0.0",
    "@watergis/maplibre-gl-export": "^4.0.1",
    "d3-scale": "^4.0.0",
    "date-fns": "^3.0.0",
    
    "h3-js": "^4.1.0",
    "jspdf": "^2.5.0",
    "@hierarchidb/util": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@hierarchidb/runtime-worker": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^6.1.8",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0"
  },
  "devDependencies": {
    "@hierarchidb/runtime-worker": "workspace:*",
    "dexie": "^4.2.0",
    "@types/d3-scale": "^4.0.0",
    "@types/geojson": "^7946.0.10",
    "@types/react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^6.1.8",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0"
  },
  "author": "",
  "license": "MIT",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom"
    ]
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "project",
      "name": "Project Plugin",
      "displayName": "Project",
      "description": "Project management container with map view",
      "icon": { "mui": "AccountTree", "emoji": "🌲", "color": "#ffe0f3" },
      "category": { "treeId": "*", "menuGroup": "document", "createOrder": 10 },
      "priority": 10,
      "creatable": true,
      "tags": ["project", "container"],
      "capabilities": ["workingCopy"]
    }
  }
}
