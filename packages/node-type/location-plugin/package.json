{
  "name": "@hierarchidb/location-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "import": "./src/worker/index.ts"
    },
    "./ui": {
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/base-plugin": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.0.0",
    "@mui/icons-material": "^7.3.1"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@hierarchidb/batch": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.0.0",
    "@mui/icons-material": "^7.3.1",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@hierarchidb/batch",
      "@mui/icons-material",
      "@mui/material",
      "dexie",
      "react",
      "react-dom"
    ]
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "location",
      "name": "Location Plugin",
      "displayName": "Location",
      "description": "Geographic location nodes with Shape integration",
      "icon": {
        "mui": "LocationPin",
        "emoji": "📍",
        "color": "#a3b030"
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 40
      },
      "priority": 40,
      "creatable": true,
      "tags": [
        "geographic",
        "location"
      ],
      "capabilities": [
        "workingCopy",
        "batch",
        "visualization"
      ]
    }
  }
}
