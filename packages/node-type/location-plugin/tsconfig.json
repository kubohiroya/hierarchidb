{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "paths": {
      "@hierarchidb/ui-dialog": [
        "../../ui/dialog/src/index.ts"
      ],
      "@hierarchidb/ui-dialog/*": [
        "../../ui/dialog/src/*"
      ],
      "@hierarchidb/runtime-shared-batch-processor": [
        "../../runtime-shared/batch-processor/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor/*": [
        "../../runtime-shared/batch-processor/src/*"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata": [
        "../../runtime-shared/fetch-metadata/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata/*": [
        "../../runtime-shared/fetch-metadata/src/*"
      ],
      "@hierarchidb/common-type": [
        "../../common/types/src/index.ts"
      ],
      "@hierarchidb/common-type/*": [
        "../../common/types/src/*"
      ],
      "@hierarchidb/download": [
        "../../feature/download/src/index.ts"
      ],
      "@hierarchidb/download/*": [
        "../../feature/download/src/*"
      ],
      "@hierarchidb/util": [
        "../../util/src/index.ts"
      ],
      "@hierarchidb/util/*": [
        "../../util/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ]
}
