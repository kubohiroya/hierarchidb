{
  "name": "@hierarchidb/shape-plugin",
  "version": "0.1.0",
  "description": "Geographic shape data management plugin for HierarchiDB",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/base-plugin": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-ui-datasource": "workspace:*",
    "@hierarchidb/runtime-shared-fetch-metadata": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@mapbox/vector-tile": "^2.0.3",
    "@tanstack/react-virtual": "^3.2.0",
    "@turf/turf": "^7.0.0",
    "allotment": "^1.20.0",
    "comlink": "^4.4.2",
    "geohash": "^0.0.1",
    "jszip": "^3.10.1",
    "notistack": "^3.0.1",
    "pako": "^2.1.0",
    "pbf": "^4.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "@hierarchidb/common-type": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@mui/icons-material": "^5.16.7 || ^6.0.0",
    "@mui/material": "^5.16.7 || ^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "dexie": "^4.2.0",
    "uuid": "^11.1.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.14",
    "@types/jszip": "^3.4.1",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@types/topojson-client": "^3.1.4",
    "@types/topojson-server": "^3.0.4",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^25.0.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^5.16.7 || ^6.0.0",
    "@mui/icons-material": "^5.16.7 || ^6.0.0",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "shape",
      "name": "Shape Plugin",
      "priority": 800,
      "category": "geographic",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "optionalDependencies": [
        "basemap"
      ],
      "exports": {
        "definition": "ShapeDefinition",
        "handler": "ShapeEntityHandler",
        "extension": "ShapeExtension",
        "services": [
          "ShapeService",
          "BatchProcessingService"
        ],
        "components": [
          "DataSourceStep",
          "LicenseStep",
          "ProcessingStep",
          "CountrySelectionStep"
        ]
      },
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": false,
        "supportsBatchProcessing": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "dataSourceName",
            "type": "string",
            "required": true
          },
          {
            "name": "selectedCountries",
            "type": "array",
            "required": true
          },
          {
            "name": "selectedAdminLevels",
            "type": "array",
            "required": true
          },
          {
            "name": "licenseAgreement",
            "type": "boolean",
            "required": true
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom"
    ]
  }
}
