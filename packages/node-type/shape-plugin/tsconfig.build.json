{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": [
    "src/types/**/*",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/__tests__/**",
    "src/**/__tests__/**",
    "src/__mocks__/**",
    "src/**/migration/**",
    "src/ui/**",
    "src/extension/**",
    "src/components/**",
    "src/services/**",
    "src/worker/**",
    "src/api/**",
    "dist/**"
  ]
}
