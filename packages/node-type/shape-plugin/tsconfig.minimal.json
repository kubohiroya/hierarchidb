{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "Node16",
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "Node16"
  },
  "include": [
    "src/shared*",
    "src/worker/api.ts",
    "src/worker/handlers*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "src/services*",
    "src/types*",
    "src/ui*",
    "**__tests__/**"
  ],
  "references": [
    {
      "path": "../../common/core"
    },
    {
      "path": "../../common/api"
    }
  ]
}
