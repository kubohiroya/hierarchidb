{
  "name": "@hierarchidb/route-plugin",
  "version": "1.0.0",
  "description": "Route management plugin extending Shape plugin for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/base-plugin": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "dexie": "^4.2.0",
    "searoute-js": "^0.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@mui/icons-material": "^6.0.0",
    "@mui/material": "^6.0.0",
    "@types/node": "^20.10.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom",
      "searoute",
      "searoute-js"
    ]
  }
}
