{
  "name": "@hierarchidb/linker-plugin",
  "version": "0.0.1",
  "description": "Linker plugin for HierarchiDB: link compiled resources into maps",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "services": ["dist/services/index.d.ts"],
      "*": ["dist/index.d.ts"]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hierarchidb/base-plugin": "workspace:*",
    "@hello-pangea/dnd": "^16.6.0",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/ui-date": "workspace:*",
    "@turf/turf": "^7.0.0",
    "@watergis/maplibre-gl-export": "^4.0.1",
    "d3-scale": "^4.0.0",
    "date-fns": "^3.0.0",
    "h3-js": "^4.1.0",
    "jspdf": "^2.5.0",
    "@hierarchidb/util": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@hierarchidb/runtime-worker": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^7.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0"
  },
  "devDependencies": {
    "@hierarchidb/runtime-worker": "workspace:*",
    "dexie": "^4.2.0",
    "@types/d3-scale": "^4.0.0",
    "@types/geojson": "^7946.0.10",
    "@types/react": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^7.3.1",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0"
  },
  "author": "",
  "license": "MIT",
  "tsup": {
    "external": [
      "@deck.gl/aggregation-layers",
      "@deck.gl/core",
      "@deck.gl/extensions",
      "@deck.gl/geo-layers",
      "@deck.gl/layers",
      "@deck.gl/mapbox",
      "@deck.gl/mesh-layers",
      "@emotion/react",
      "@emotion/styled",
      "@hierarchidb/runtime-worker",
      "@mui/icons-material",
      "@mui/material",
      "dexie",
      "react",
      "react-dom",
      "@hierarchidb/ui-treeconsole-base",
      "@hierarchidb/ui-map"
    ]
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "linker",
      "name": "Linker Plugin",
      "displayName": "Linker",
      "description": "Link compiled resources to map for usage",
      "icon": {
        "mui": "AccountTree",
        "emoji": "🌲",
        "color": "#ffe0f3"
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 10
      },
      "priority": 10,
      "creatable": true,
      "tags": [
        "linker",
        "container"
      ],
      "capabilities": [
        "workingCopy"
      ]
    }
  }
}
