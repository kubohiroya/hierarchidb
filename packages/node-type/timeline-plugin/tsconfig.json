{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "types": ["node", "react"],
    "typeRoots": [
      "./src/types",
      "../../../node_modules/@types"
    ],
    "moduleResolution": "Node16",
    "module": "Node16"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
