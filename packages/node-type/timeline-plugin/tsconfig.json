{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "types": [
      "node",
      "react"
    ],
    "moduleResolution": "Node16",
    "module": "Node16",
    "baseUrl": ".",
    "paths": {
      "react-transition-group": [
        "src/types/react-transition-group/index.d.ts"
      ],
      "react-transition-group/Transition": [
        "src/types/react-transition-group/transition.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
