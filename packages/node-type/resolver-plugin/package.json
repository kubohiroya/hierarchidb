{
  "name": "@hierarchidb/resolver-plugin",
  "version": "1.0.0",
  "description": "Resolver node type plugin for property mapping between different data schemas",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/base-plugin": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "comlink": "^4.4.1",
    "dexie": "^4.0.9"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/ui": "^3.2.4",
    "fake-indexeddb": "^6.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^6.1.8"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^6.1.8",
    "@mui/icons-material": "^6.1.8"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom"
    ]
  }
}
