{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx",
    
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@hierarchidb/ui-core": ["../../ui/core/dist/index.d.ts"],
      "@hierarchidb/ui-data-grid": ["../../ui/data-grid/dist/index.d.ts"],
      "@hierarchidb/table-metadata": ["../../feature/table-metadata/dist/index.d.ts"],
      "@hierarchidb/tabular-store": ["../../feature/tabular-store/dist/index.d.ts"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["node"],
    "module": "ESNext"
  },
  "include": ["src/steps/**/*.tsx", "src/types/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/worker/**", "src/services/**", "**/*.test.*", "**/*.spec.*"]
}
