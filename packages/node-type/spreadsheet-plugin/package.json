{
  "name": "@hierarchidb/spreadsheet-plugin",
  "version": "0.0.1",
  "description": "Spreadsheet plugin for HierarchiDB - extends folder plugin",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck:ui": "tsc --noEmit",
    "typecheck": "pnpm -s typecheck:ui",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-csv-extract": "workspace:*",
    "@hierarchidb/table-metadata": "workspace:*",
    "@hierarchidb/tabular": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@types/pako": "^2.0.3",
    "pako": "^2.1.0",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "react-i18next": "12.3.1",
    "i18next": "22.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "fake-indexeddb": "^6.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "react": "^18.3.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "spreadsheet",
      "name": "Spreadsheet Plugin",
      "priority": 600,
      "category": "data",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "exports": {
        "definition": "SpreadsheetDefinition",
        "handler": "SpreadsheetEntityHandler",
        "components": [
          "SpreadsheetDialog",
          "SpreadsheetPanel"
        ]
      },
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "spreadsheetData",
            "type": "object",
            "required": true
          },
          {
            "name": "formulas",
            "type": "object",
            "required": false
          }
        ]
      }
    }
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "dexie": "^4.2.0",
    "react-i18next": "12.3.1",
    "i18next": "22.5.0"
  },
  
  "tsup": {
    "external": [
      "react"
    ]
  }
}
