{
  "name": "@hierarchidb/node-type-basemap-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "BaseMap Plugin for HierarchiDB - Geographic base layer configuration and management",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "tsc && tsc-alias",
    "dev:tsc": "tsc --watch"
  },
  "dependencies": {
    "@hierarchidb/common-core": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-plugin-base": "workspace:*",
    "@hierarchidb/node-type-folder-plugin": "workspace:*",
    "dexie": "^4.0.0",
    "maplibre-gl": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "jsdom": "^22.0.0",
    "fake-indexeddb": "^4.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "@mui/material": "^5.0.0",
    "@mui/icons-material": "^5.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1"
  },
  "keywords": [
    "hierarchidb",
    "plugin",
    "basemap",
    "mapping",
    "gis",
    "geographic"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "basemap",
      "name": "BaseMap Plugin",
      "priority": 900,
      "category": "geographic",
      "extends": "folder",
      "dependencies": ["folder"],
      "exports": {
        "definition": "BaseMapDefinition",
        "handler": "BaseMapEntityHandler",
        "extension": "BaseMapExtension",
        "components": [
          "MapStyleStep",
          "MapViewportStep",
          "DisplayOptionsStep"
        ]
      },
      "capabilities": {
        "canHaveChildren": true,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "mapStyle",
            "type": "object",
            "required": true
          },
          {
            "name": "viewport",
            "type": "object",
            "required": true
          },
          {
            "name": "displayOptions",
            "type": "object",
            "required": false
          }
        ]
      }
    }
  }
}
