{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM"],
    "esModuleInterop": true,
   // "module": "esnext",
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "incremental": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "plugin.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
    ]
}
