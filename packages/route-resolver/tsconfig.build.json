{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@hierarchidb/route-resolver": [
        "src/index.ts"
      ],
      "@hierarchidb/route-resolver/*": [
        "src/*"
      ],
      "~/*": [
        "*.ts",
        "*"
      ]
    },
    "baseUrl": "src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
