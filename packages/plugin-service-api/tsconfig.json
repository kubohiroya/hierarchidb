{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "checkDeps": {
    "allowSkipLibCheck": false,
    "reason": "API package should fully type-check without skipLibCheck."
  }
}
