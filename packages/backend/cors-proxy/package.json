{
  "name": "@hierarchidb/cors-proxy",
  "version": "0.0.1",
  "description": "CORS proxy for external API access",
  "type": "module",
  "main": "src/index.mts",
  "scripts": {
    "dev:manual": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run build:types && pnpm run build:pack",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "test": "vitest",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "change-case": "^5.4.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250821.0",
    "@types/node": "^24.3.0",
    "typescript": "workspace:*",
    "wrangler": "^4.31.0",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
