function isTypeDecl(d: ExportedDeclarations) {
  return Node.isInterfaceDeclaration(d) || Node.isTypeAliasDeclaration(d);
}
function isValueDecl(d: ExportedDeclarations) {
  return (
    Node.isClassDeclaration(d) ||
