{
  "name": "@hierarchidb/bff",
  "version": "0.0.1",
  "description": "Backend for Frontend - OAuth2 authentication for hierarchidb",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev:manual": "wrangler dev",
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "deploy": "wrangler deploy --config wrangler.hierarchidb.toml --env production",
    "deploy:production": "wrangler deploy --config wrangler.hierarchidb.toml --env production",
    "logs": "wrangler tail --config wrangler.hierarchidb.toml",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "biome check --write src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "hono": "^4.9.2",
    "jose": "^6.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250821.0",
    "@types/node": "^24.3.0",
    "typescript": "workspace:*",
    "wrangler": "^4.31.0",
    "vitest": "^4.1.0"
  },
  "license": "MIT"
}
