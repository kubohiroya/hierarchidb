{
  "extends": "../../../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
