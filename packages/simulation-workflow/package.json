{
    "name": "@hierarchidb/simulation-workflow",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./canonical-yaml-snapshot": {
            "types": "./dist/canonical-yaml-snapshot/index.d.ts",
            "import": "./dist/canonical-yaml-snapshot/index.js"
        }
    },
    "typesVersions": {
        "*": {
            "canonical-yaml-snapshot": [
                "dist/canonical-yaml-snapshot/index.d.ts"
            ]
        }
    },
    "scripts": {
        "build": "tsdown src/index.ts --config ../../tsdown.config.ts --outDir dist && tsdown src/canonical-yaml-snapshot/index.ts --config ../../tsdown.config.ts --splitting false --outDir dist/canonical-yaml-snapshot",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
        "test": "vitest run --passWithNoTests",
        "test:run": "vitest run"
    },
    "dependencies": {
        "@hierarchidb/ide-gsm-client": "workspace:*",
        "@hierarchidb/folder-plugin": "workspace:*"
    },
    "devDependencies": {
        "fast-check": "^4.5.3",
        "typescript": "workspace:^5.9.3",
        "vitest": "^4.1.0"
    }
}
