{
  "name": "@hierarchidb/batch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --project tsconfig.json --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@hierarchidb/batch-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@hierarchidb/batch-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@types/react": "^18.3.5",
    "react": ">=18.0.0",
    "typescript": "workspace:^5.9.3"
  }
}
