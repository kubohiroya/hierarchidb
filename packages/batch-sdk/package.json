{
  "name": "@hierarchidb/batch-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf dist dist-types",
    "prebuild": "pnpm run clean",
    "build": "pnpm run build:types && pnpm run build:bundle",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  },
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3"
  },
  "tsup": {
    "external": []
  }
}
