{
  "name": "@hierarchidb/batch-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "build": "pnpm run build:bundle",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  }
}
