{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "es2020",
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
