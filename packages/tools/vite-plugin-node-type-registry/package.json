{
  "name": "@hierarchidb/vite-plugin-node-type-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint 'src/**/*.ts'",
    "build:types": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts-only",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts=false --no-clean"
  },
  "dependencies": {},
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "@types/node": "^20.11.0"
  },
  "tsup": {
    "external": [
      "vite"
    ]
  }
}
