{
  "name": "@hierarchidb/tools-vite-plugin-dev-health",
  "version": "0.1.0",
  "description": "Vite dev plugin that surfaces dependency drift (lockfile vs node_modules) and build/HMR health in the browser.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.11"
  },
  "keywords": ["vite", "vite-plugin", "hmr", "dev", "dependencies"],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hierarchidb/hierarchidb.git",
    "directory": "packages/tools/vite-plugin-dev-health"
  },
  "publishConfig": { "access": "public" },
  "tsup": { "entry": ["src/index.ts"], "external": ["vite"], "dts": true, "format": ["cjs","esm"] }
}
