{
  "name": "@hierarchidb/tools-build-scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/env-vite.ts src/gen-plugin-registry.ts src/prepare-gh-pages-build.ts src/sync-peer-dependencies.ts src/tsconfig-set-nodenext.ts --config ../../../tsdown.config.ts --outDir dist --splitting false",
    "clean": "rm -rf dist",
    "gen-plugin-registry": "pnpm run build && node dist/gen-plugin-registry.js",
    "sync-peer-dependencies": "pnpm run build && node dist/sync-peer-dependencies.js",
    "fix-spa-build": "pnpm run build && node dist/env-vite.js",
    "tsconfig:set-nodenext": "pnpm run build && node dist/tsconfig-set-nodenext.js"
  },
  "dependencies": {
    "globby": "^14.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "@hierarchidb/tools-load-plugin-manifest": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.19.123"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "^build",
          "@hierarchidb/tools-load-plugin-manifest#build"
        ]
      }
    }
  }
}
