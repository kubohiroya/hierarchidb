{
  "name": "@hierarchidb/tools-codemods",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/esm-ext-codemod-basic.ts src/esm-ext-codemod.ts src/rename-tree-node-updater-id.ts --config ../../../tsdown.config.ts --outDir dist --splitting false",
    "clean": "rm -rf dist",
    "codemod:esm-ext": "pnpm run build && node dist/esm-ext-codemod-basic.js",
    "codemod:treenode-updater-id": "pnpm run build && node dist/rename-tree-node-updater-id.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "globby": "^14.1.0",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
