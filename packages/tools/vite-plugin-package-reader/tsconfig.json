{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "module": "ESNext",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ],
  "files": [
    "src/core/Logger.ts",
    "src/core/PackageCache.ts",
    "src/core/PackageDetector.ts",
    "src/index.ts",
    "src/pipeline/DependencyResolver.ts",
    "src/pipeline/TransformPipeline.ts",
    "src/plugin/VitePlugin.ts",
    "src/presets/hierarchidb.ts",
    "src/presets/index.ts",
    "src/strategies/BaseStrategy.ts",
    "src/strategies/index.ts",
    "src/types.ts",
    "src/virtual/TypeGenerator.ts",
    "src/virtual/VirtualModuleManager.ts"
  ]
}
