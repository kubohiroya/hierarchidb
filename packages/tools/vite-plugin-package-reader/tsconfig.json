{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "incremental": false,
    
    "module": "ESNext",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ],
  "files": []
}
