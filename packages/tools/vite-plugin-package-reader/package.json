{
  "name": "@hierarchidb/tools-vite-plugin-package-reader",
  "version": "0.0.1",
  "description": "Universal Vite plugin for automatic package detection and virtual module generation",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js",
      "require": "./dist/presets/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "glob": "^10.4.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "monorepo",
    "package-detection",
    "virtual-module",
    "plugin-system"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hierarchidb/hierarchidb.git",
    "directory": "packages/tools/vite-plugin-package-reader"
  },
  "publishConfig": {
    "access": "public"
  },
  "tsup": {
    "external": [
      "vite"
    ]
  }
}
