{
  "name": "@hierarchidb/analyze-licenses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "hdb-analyze-licenses": "dist/cli.mjs"
  },
  "exports": {
    ".": "./dist/cli.mjs",
    "./cli": "./dist/cli.mjs"
  },
  "types": "dist/cli.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/cli.mjs",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:types": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts-only",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts=false --no-clean"
  },
  "devDependencies": {
    "license-checker": "^25.0.1",
    "tsup": "^8.5.0",
    "@types/license-checker": "^25.0.6"
  }
}
