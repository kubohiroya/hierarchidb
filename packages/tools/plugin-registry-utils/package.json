{
  "name": "@hierarchidb/tools-plugin-registry-utils",
  "version": "0.1.0",
  "description": "Shared helpers for discovering HierarchiDB node-type plugins and generating tooling metadata",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsup": "^8.5.0",
    "typescript": "workspace:^5.9.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "vite"
    ]
  }
}
