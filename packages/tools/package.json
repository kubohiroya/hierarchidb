{
  "name": "@hierarchidb/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "analyze-licenses",
    "codemods",
    "build-scripts",
    "load-plugin-manifest",
    "schemas",
    "gen-iso3166-2"
  ],
  "scripts": {
    "build": "pnpm -r --filter ./\\* --if-present run build",
    "lint": "pnpm -r --filter ./\\* --if-present run lint",
    "clean": "pnpm -r --filter ./\\* --if-present run clean",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "outputs": [
          "*/dist/**"
        ]
      }
    }
  }
}
