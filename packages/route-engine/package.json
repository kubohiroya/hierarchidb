{
  "name": "@hierarchidb/route-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "test": "if [ -d packages/route-engine ]; then vitest run --config packages/route-engine/vitest.config.ts; else vitest run --config vitest.config.ts; fi",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@hierarchidb/route-store": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/route-store": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "typescript": "workspace:^5.9.3",
    "vitest": "^4.1.0"
  }
}
