{
  "name": "@hierarchidb/worker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@hierarchidb/build-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/import-export-api": "workspace:*",
    "@hierarchidb/location-api": "workspace:*",
    "@hierarchidb/memory": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/route-api": "workspace:*",
    "@hierarchidb/shape-api": "workspace:*",
    "@hierarchidb/style-api": "workspace:*",
    "@hierarchidb/tag-api": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/build-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/import-export-api": "workspace:*",
    "@hierarchidb/location-api": "workspace:*",
    "@hierarchidb/memory": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/route-api": "workspace:*",
    "@hierarchidb/shape-api": "workspace:*",
    "@hierarchidb/style-api": "workspace:*",
    "@hierarchidb/tag-api": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "typescript": "workspace:^5.9.3"
  }
}
