{
  "name": "@hierarchidb/runtime-shared-batch-processor",
  "version": "1.0.0",
  "description": "Batch processing utilities for HierarchiDB",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.19.24",
    "tsup": "^8.5.0",
    "typescript": "^4.9.5"
  },
  "keywords": [
    "hierarchidb",
    "batch-processor",
    "utilities"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT"
}
