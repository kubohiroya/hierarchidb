{
  "name": "@hierarchidb/plugin-runtime-services",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "typecheck": "tsup --dts"
  },
  "dependencies": {},
  "peerDependencies": {
    "dexie": ">=4.0.0",
    "@hierarchidb/download": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "dexie": "^4.2.0",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3"
  },
  "tsup": {
    "external": [
      "@hierarchidb/download",
      "@hierarchidb/download/*",
      "@hierarchidb/plugin-ui-sdk",
      "@hierarchidb/plugin-ui-sdk/*",
      "@hierarchidb/plugin-types",
      "@hierarchidb/plugin-types/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "dexie"
    ]
  }
}
