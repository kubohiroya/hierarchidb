{
  "name": "@hierarchidb/shape-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/gis-sdk": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/shape-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/vectortile-store": "workspace:*",
    "dexie": "^4.2.0"
  },
  "devDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/gis-sdk": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/shape-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/vectortile-store": "workspace:*",
    "@types/geojson": "^7946.0.14",
    "dexie": "^4.2.0",
    "fake-indexeddb": "^6.2.2",
    "typescript": "workspace:^5.9.3",
    "vitest": "^4.1.0"
  }
}
