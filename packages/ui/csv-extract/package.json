{
  "name": "@hierarchidb/ui-csv-extract",
  "version": "0.1.0",
  "description": "Reusable CSV data extraction UI components and API interface for HierarchiDB plugins",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-file": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "keywords": [
    "hierarchidb",
    "csv",
    "extract",
    "ui",
    "react",
    "components"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT"
}
