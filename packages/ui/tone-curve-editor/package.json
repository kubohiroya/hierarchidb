{
  "name": "@hierarchidb/ui-tone-curve-editor",
  "version": "0.1.0",
  "description": "Tone-curve editor component with draggable anchor points and controls",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "workspace:^5.9.3"
  },
  "sideEffects": false
}
