{
  "name": "@hierarchidb/ui-treeconsole-breadcrumb",
  "version": "0.1.0",
  "description": "Breadcrumb UI component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm run build:clean",
    "build": "pnpm run build:types && pnpm run build:bundle",
    "build:tsc": "pnpm run build:types",
    "dev": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc --noEmit",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "comlink": "^4.4.2",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@tanstack/react-router": "^1.132.33",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependencies": {
    "comlink": "^4.4.2",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@tanstack/react-router": "^1.132.33",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "@tanstack/react-router",
      "react",
      "react-dom"
    ]
  }
}
