{
  "name": "@hierarchidb/ui-treeconsole-breadcrumb",
  "version": "0.1.0",
  "description": "Breadcrumb UI component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm run build:clean",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "build:tsc": "pnpm run build:types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../../scripts/pkg-build/copy-dist-types.mjs"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/common-type": "workspace:*"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react-router-dom": "^5.3.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": ">=6.22.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "react-router-dom",
      "react",
      "react-dom"
    ]
  }
}
