{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "dist",
    "dist-types",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "**/__tests__*.test.*",
    "**/*.spec.*"
  ]
}
