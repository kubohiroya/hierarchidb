{
  "name": "@hierarchidb/ui-treeconsole-base",
  "version": "0.1.0",
  "description": "Base Tree Console UI orchestrator components for HierarchiDB - migrated from eria-cartograph/app0",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../../tsdown.config.ts --outDir dist",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hierarchidb/ui-search-input": "workspace:*",
