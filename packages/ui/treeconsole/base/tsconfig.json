{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "react"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-icon": [
        "../../../../packages/ui/icon/src/index.ts"
      ],
      "@hierarchidb/ui-icon/*": [
        "../../../../packages/ui/icon/src/*"
      ]
    },
    "jsxImportSource": "react"
  },
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
