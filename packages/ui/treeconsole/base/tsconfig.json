{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": "./src",
    "jsx": "react-jsx",
    "types": [
      "react"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    },
    "jsxImportSource": "react"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
