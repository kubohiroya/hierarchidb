{
  "name": "@hierarchidb/ui-treeconsole-treetable",
  "version": "0.1.0",
  "description": "TreeTable component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "jotai": "^2.13.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "devDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom"
    ]
  }
}
