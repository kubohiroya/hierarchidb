{
  "name": "@hierarchidb/ui-treeconsole-treetable",
  "version": "0.1.0",
  "description": "TreeTable component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "comlink": "^4.4.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-router": "^1.132.33",
    "jotai": "^2.13.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "devDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "comlink": "^4.4.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@tanstack/react-router": "^1.132.33",
    "jotai": "^2.13.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/components",
      "@hierarchidb/components/*",
      "@hierarchidb/ui-i18n",
      "@hierarchidb/ui-i18n/*",
      "@hierarchidb/ui-theme",
      "@hierarchidb/ui-theme/*",
      "@hierarchidb/ui-treeconsole-breadcrumb",
      "@hierarchidb/ui-treeconsole-breadcrumb/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "@tanstack/react-router",
      "@tanstack/react-router/*",
      "@tanstack/react-table",
      "@tanstack/react-table/*",
      "@tanstack/react-virtual",
      "@tanstack/react-virtual/*",
      "comlink",
      "jotai",
      "react",
      "react-dom"
    ]
  }
}
