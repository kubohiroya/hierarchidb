{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "types": [
      "react"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    },
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": "."
  },
  "include": [
    "src"
  ],
  "exclude": [
    "./node_modules",
    "./dist"
  ]
}
