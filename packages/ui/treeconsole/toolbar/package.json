{
  "name": "@hierarchidb/ui-treeconsole-toolbar",
  "version": "0.1.0",
  "description": "Toolbar UI component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../../tsdown.config.ts --outDir dist",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/ui-treeconsole-base": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "vitest": "^4.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@hierarchidb/build-api": "workspace:*",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}