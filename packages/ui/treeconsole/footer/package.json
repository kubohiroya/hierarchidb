{
  "name": "@hierarchidb/ui-treeconsole-footer",
  "version": "0.1.0",
  "description": "Footer UI component for HierarchiDB TreeConsole",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "peerDependencies": {
    "comlink": "^4.4.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "comlink",
      "react",
      "react-dom"
    ]
  }
}
