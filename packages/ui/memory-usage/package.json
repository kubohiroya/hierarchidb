{
  "name": "@hierarchidb/memory-usage",
  "version": "0.1.0",
  "description": "Memory usage component for HierarchiDB with intelligent pane management for HierarchiDB",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "allotment": "^1.20.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@hierarchidb/util": "workspace:*"
  },
  "keywords": [],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@hierarchidb/util": "workspace:*"
  }
}
