{
  "name": "@hierarchidb/ui-tabular-extract",
  "version": "0.1.0",
  "description": "Reusable CSV data extraction UI components and API interface for HierarchiDB plugins",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "tsdown": {
    "platform": "browser",
    "target": "es2020",
    "splitting": false
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "peerDependencies": {
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-modal-select": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "devDependencies": {
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-modal-select": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6"
  },
  "keywords": [
    "hierarchidb",
    "csv",
    "extract",
    "ui",
    "react",
    "components"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT"
}
