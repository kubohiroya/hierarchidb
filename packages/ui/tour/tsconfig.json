{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx"
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "react-joyride/@gilbarbara/types/type-fest generics require TS>=5; isolate here only"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "references": []
}
