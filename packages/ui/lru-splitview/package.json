{
  "name": "@hierarchidb/ui-lru-splitview",
  "version": "0.1.0",
  "description": "LRU-managed split view component with intelligent pane management for HierarchiDB",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {
    "allotment": "^1.20.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "keywords": [
    "hierarchidb",
    "split-view",
    "lru",
    "pane-management",
    "ui",
    "react",
    "allotment"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react"
    ]
  }
}
