{
  "name": "@hierarchidb/ui-lru-splitview",
  "version": "0.1.0",
  "description": "LRU-managed split view component with intelligent pane management for HierarchiDB",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "allotment": "^1.20.4"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6"
  },
  "keywords": [
    "hierarchidb",
    "split-view",
    "lru",
    "pane-management",
    "ui",
    "react",
    "allotment"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6"
  }
}
