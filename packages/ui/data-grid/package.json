{
  "name": "@hierarchidb/ui-data-grid",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "tsdown": {
    "platform": "browser",
    "target": "es2020",
    "splitting": false
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "19.0.8",
    "typescript": "workspace:^5.9.3",
    "react": "^18.3.1",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@tanstack/react-virtual": "^3.10.8",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@tanstack/react-virtual": "^3.10.8",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*"
  }
}
