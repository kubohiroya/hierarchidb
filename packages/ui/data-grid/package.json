{
  "name": "@hierarchidb/ui-data-grid",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "19.0.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1",
    "@tanstack/react-virtual": "^3.10.8"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1",
    "@tanstack/react-virtual": "^3.10.8"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "@tanstack/react-virtual",
      "react"
    ]
  }
}
