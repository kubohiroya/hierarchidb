{
  "name": "@hierarchidb/ui-grid",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "tsdown": {
    "platform": "browser",
    "target": "es2020",
    "splitting": false
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:run": "vitest run --config vitest.config.ts --passWithNoTests",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.10.8",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "workspace:^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.10.8",
    "react": "^19.0.0"
  }
}
