{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    },
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": [
      "vite/client"
    ],
    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
