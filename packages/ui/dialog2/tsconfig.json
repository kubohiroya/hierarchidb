{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "outDir": "dist",
    "declarationDir": "dist",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Storybook \u578b\u5b9a\u7fa9\u4f9d\u5b58\u306e\u4e00\u6642\u7684\u306a\u8b66\u544a\u56de\u907f"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
