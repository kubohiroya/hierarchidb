{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "declaration": false,
    "declarationMap": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "jsx": "react-jsx"
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/stories/**"
  ]
}
