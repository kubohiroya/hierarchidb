{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "ESNext",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/common-auth": [
        "../../common/auth/src/index.ts"
      ],
      "@hierarchidb/common-auth/*": [
        "../../common/auth/src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "checkDeps": { "allowSkipLibCheck": true, "reason": "UI transitive types; reduce when upstream types stabilize." },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
