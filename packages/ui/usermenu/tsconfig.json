{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "UI transitive types; reduce when upstream types stabilize."
  },
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
