{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Node16",
    "module": "Node16",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "~/*": ["./src/*"],
      "@hierarchidb/ui-core": ["../core/dist/src/index.d.ts"],
      "@hierarchidb/ui-core/*": ["../core/dist/src/*"],
      "@hierarchidb/runtime-worker-bootstrap": ["../../runtime-worker/worker-bootstrap/dist/index.d.ts"]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "checkDeps": { "allowSkipLibCheck": true, "reason": "UI transitive types; reduce when upstream types stabilize." },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
