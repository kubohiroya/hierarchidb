{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "ESNext",
    "baseUrl": ".",
    "skipLibCheck": true,

    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../core/dist/index.d.ts"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}
