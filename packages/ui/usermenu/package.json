{
  "name": "@hierarchidb/ui-usermenu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:bundle",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "pnpm run build:types",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "devDependencies": {
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-monitoring": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "vite": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.1"
  },
  "peerDependencies": {
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-monitoring": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@hierarchidb/common-auth",
      "@hierarchidb/common-auth/*",
      "@hierarchidb/ui-auth",
      "@hierarchidb/ui-auth/*",
      "@hierarchidb/ui-i18n",
      "@hierarchidb/ui-i18n/*",
      "@hierarchidb/ui-monitoring",
      "@hierarchidb/ui-monitoring/*",
      "@hierarchidb/ui-theme",
      "@hierarchidb/ui-theme/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "react",
      "react-dom"
    ]
  }
}
