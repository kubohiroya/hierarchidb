{
  "name": "@hierarchidb/ui-country-select",
  "version": "0.1.0",
  "description": "Country and matrix selection components for HierarchiDB plugins",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "react-virtuoso": "^4.14.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "keywords": [
    "hierarchidb",
    "country",
    "selection",
    "matrix",
    "ui",
    "react",
    "virtualization"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react"
    ]
  }
}
