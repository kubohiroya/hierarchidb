{
  "name": "@hierarchidb/ui-i18n",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:bundle",
    "typecheck": "tsc -b tsconfig.build.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts-only",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts=false --no-clean"
  },
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-date-pickers": "^8.10.2",
    "i18next": "22.5.0",
    "react-i18next": "12.3.1",
    "date-fns": "^4.1.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "react": "^18.3.1",
    "typescript": "workspace:^5.9.3",
    "vite": "5.4.19"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@mui/x-date-pickers": "^8.10.2",
    "i18next": "22.5.0",
    "react-i18next": "12.3.1",
    "date-fns": "^4.1.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "@mui/x-date-pickers",
      "@mui/x-date-pickers/*",
      "date-fns",
      "i18next",
      "i18next-browser-languagedetector",
      "i18next-http-backend",
      "react",
      "react-i18next"
    ]
  }
}
