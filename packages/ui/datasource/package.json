{
  "name": "@hierarchidb/ui-datasource",
  "version": "0.0.1",
  "description": "Shared data source selection components (WIP)",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/ui-file": "workspace:*"
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  }
}
