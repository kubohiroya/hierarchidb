{
  "name": "@hierarchidb/ui-routing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:bundle",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "pnpm run build:types",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "devDependencies": {
    "@tanstack/react-router": "^1.132.33",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.132.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "@tanstack/react-router",
      "@tanstack/react-router/*",
      "react",
      "react-dom"
    ]
  }
}
