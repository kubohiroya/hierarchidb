{
  "extends": "../../../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**",
    "src/test-setup.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  },
  "include": [
    "src/**/*"
  ]
}
