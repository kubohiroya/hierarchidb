{
  "name": "@hierarchidb/ui-dialog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -c ./.storybook --port 6307 --disable-telemetry",
    "storybook:build": "storybook build -c ./.storybook",
    "pretest:playwright": "pnpm storybook:build",
    "test:playwright": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "notistack": "^3.0.2"
  },
  "devDependencies": {
    "@types/react-resizable": "^3.0.8"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "react-resizable": "^3.0.5",
    "@hierarchidb/common-types": "workspace:*"
  }
}
