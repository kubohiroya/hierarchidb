{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "emitDeclarationOnly": false,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**",
    "src/vite-env.d.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
