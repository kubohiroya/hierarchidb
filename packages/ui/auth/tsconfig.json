{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "@hierarchidb/common-auth": [
        "../../common/auth/dist/index.d.ts"
      ]
    },
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**",
    "src/vite-env.d.ts"
  ]
}
