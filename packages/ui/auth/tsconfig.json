{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": ".",
    "moduleResolution": "node",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "@hierarchidb/common-auth": [
        "../../common/auth/dist/index.d.ts"
      ]
    },
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "skipLibCheck": true,  // Required for ast-types compatibility with isolatedModules
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "src/**/*",
    "vitest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.ts"
  ]
}
