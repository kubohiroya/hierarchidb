{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    },
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.ts",
    "**/*.test.*",
    "**/*.spec.*",
    "src/__tests__/**",
    "src/vite-env.d.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
