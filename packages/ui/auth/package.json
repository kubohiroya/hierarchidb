{
  "name": "@hierarchidb/ui-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hierarchidb/common-auth": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@react-oauth/google": "^0.12.2",
    "@tanstack/react-router": "^1.132.33",
    "@types/react-gravatar": "^2.6.14",
    "@vitejs/plugin-react": "^5.0.1",
    "i18next": "22.5.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-gravatar": "^2.6.3",
    "react-i18next": "12.3.1",
    "react-oidc-context": "^3.3.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hierarchidb/common-auth": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@react-oauth/google": "^0.12.2",
    "@tanstack/react-router": "^1.132.33",
    "@types/react-gravatar": "^2.6.14",
    "@vitejs/plugin-react": "^5.0.1",
    "i18next": "22.5.0",
    "oidc-client-ts": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-gravatar": "^2.6.3",
    "react-i18next": "12.3.1",
    "react-oidc-context": "^3.3.0"
  },
  "license": "MIT",
  "module": "dist/index.js"
}
