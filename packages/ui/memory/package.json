{
  "name": "@hierarchidb/ui-memory",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "format": "biome check --write src",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hierarchidb/memory": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@emotion/react": "^11.14.0"
  },
  "devDependencies": {
    "@hierarchidb/memory": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "react": "^19.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6"
  },
  "license": "MIT"
}
