{
  "name": "@hierarchidb/ui-build-sessions",
  "version": "0.1.0",
  "description": "Shared build progress hooks for HierarchiDB UI",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "@hierarchidb/build-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/build-runtime-services": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "@mui/icons-material": ">=5.0.0",
    "@mui/material": ">=5.0.0",
    "comlink": ">=4.0.0",
    "jotai": ">=2.0.0",
    "jotai-family": ">=1.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@hierarchidb/build-api": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/build-runtime-services": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "@mui/icons-material": ">=5.0.0",
    "@mui/material": ">=5.0.0",
    "comlink": ">=4.0.0",
    "jotai": "^2.13.1",
    "jotai-family": "^1.0.1",
    "typescript": "workspace:^5.9.3"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
