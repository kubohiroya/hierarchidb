{
  "name": "@hierarchidb/ui-accordion-config",
  "version": "1.0.0",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types",
    "prebuild:bundle": "pnpm run build:types"
  },
  "peerDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "description": "Configurable accordion components with phase-based theming for HierarchiDB",
  "keywords": [
    "react",
    "accordion",
    "configuration",
    "ui-components",
    "hierarchidb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kubohiroya/hierarchidb.git",
    "directory": "packages/ui-accordion-config"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2"
  },
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "react",
      "react-dom"
    ]
  }
}
