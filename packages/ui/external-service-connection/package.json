{
  "name": "@hierarchidb/ui-external-service-connection",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared external service connection step UI for plugin dialogs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@hierarchidb/ui-external-service-health": "workspace:*",
    "@mui/material": "^7.3.6",
    "react": "^19.0.0"
