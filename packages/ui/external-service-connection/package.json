  "devDependencies": {
    "@hierarchidb/ui-external-service-health": "workspace:*",
    "@mui/material": "^7.3.6",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.0"
  },
  "keywords": [],
  "author": "HierarchiDB Team",
  "license": "MIT"
}
