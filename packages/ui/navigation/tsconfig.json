{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "TanStack RouterとMUIの型依存を leaf パッケージ内で完結させるため"
  },
  "include": [
    "src"
  ],
  "references": []
}
