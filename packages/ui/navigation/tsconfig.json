{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "./dist",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-core": [
        "../core/dist/src/index.d.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "../core/dist/src/*"
      ],
      "@hierarchidb/runtime-worker-bootstrap": [
        "../../runtime-worker/worker-bootstrap/dist/index.d.ts"
      ]
    }
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "react-router-dom@7 type d.ts requires TS>=5; leaf-only here"
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
