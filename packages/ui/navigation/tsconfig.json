{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "@hierarchidb/common-type": [
        "../../common/types/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../../common/types/src/**/*.ts"
  ],
  "references": [
    {
      "path": "../core"
    }
  ]
}
