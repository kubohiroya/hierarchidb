{
  "name": "@hierarchidb/ui-navigation",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:bundle",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "pnpm run build:types",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "devDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@tanstack/react-router": "^1.132.33",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@tanstack/react-router": "^1.132.33",
    "react": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "@tanstack/react-router",
      "@tanstack/react-router/*",
      "react"
    ]
  }
}
