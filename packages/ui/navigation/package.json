{
  "name": "@hierarchidb/ui-navigation",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "tsc && tsc-alias",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "peerDependencies": {
    "react": "^18.3.1",
    "react-router-dom": ">=7.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-router-dom"
    ]
  }
}
