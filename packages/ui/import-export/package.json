{
  "name": "@hierarchidb/ui-import-export",
  "version": "0.0.1",
  "type": "module",
  "description": "Import/Export UI components and hooks for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/common-api": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "comlink": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}