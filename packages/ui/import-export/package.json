{
  "name": "@hierarchidb/ui-import-export",
  "version": "0.0.1",
  "type": "module",
  "description": "Import/Export UI components and hooks for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/common-api": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "comlink": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "react": ">=18.0.0"
  },
  "tsup": {
    "external": [
      "comlink",
      "react"
    ]
  }
}
