{
  "name": "@hierarchidb/ui-map",
  "version": "0.0.1",
  "description": "Shared map components for HierarchiDB with MapLibre GL support",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\""
  },
  "dependencies": {
    "@vis.gl/react-maplibre": "^8.0.4",
    "maplibre-gl": "^4.0.0",
    "@hierarchidb/common-type": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.1",
    "react": ">=18.0.0",
    "@deck.gl/mapbox": "^9.0.0"
  },
  "devDependencies": {
    "react": ">=18.0.0",
    "@mui/material": "^7.3.1"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/material",
      "@deck.gl/mapbox",
      "react"
    ]
  }
}
