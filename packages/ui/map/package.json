{
  "name": "@hierarchidb/ui-map",
  "version": "0.0.1",
  "description": "Shared map components for HierarchiDB with MapLibre GL support",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "react": ">=18.0.0",
    "@vis.gl/react-maplibre": "^8.0.4",
    "maplibre-gl": "^5.7.3",
    "@deck.gl/core": "^9.1.14",
    "@deck.gl/geo-layers": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/mapbox": "^9.1.14",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*",
    "@hierarchidb/ui-floating-window": "workspace:*",
    "jotai": "^2.16.0"
  },
  "devDependencies": {
    "react": ">=18.0.0",
    "@mui/material": "^7.3.6",
    "@mui/icons-material": "^7.3.6",
    "@types/geojson": "^7946.0.8",
    "@deck.gl/core": "^9.1.14",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*",
    "@hierarchidb/ui-floating-window": "workspace:*",
    "jotai": "^2.16.0",
    "@storybook/react-vite": "7.6.20"
  },
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module"
}
