{
  "name": "@hierarchidb/ui-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsc-alias": "^1.8.16",
    "react": "^18.3.1",
    "@mui/material": "^7.3.2"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2"
  },
  "tsup": {
    "external": [
      "@mui/material",
      "@mui/material/*",
      "react"
    ]
  }
}
