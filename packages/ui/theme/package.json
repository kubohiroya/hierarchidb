{
  "name": "@hierarchidb/ui-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/ui-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsc-alias": "^1.8.16",
    "react": "^18.3.1",
    "@mui/material": "^7.3.1"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1",
    "@mui/material": "^7.3.2"
  },
  "tsup": {
    "external": [
      "@mui/material",
      "react"
    ]
  }
}
