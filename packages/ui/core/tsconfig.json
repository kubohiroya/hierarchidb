{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-data-grid": [
        "../data-grid/src/index.ts"
      ],
      "@hierarchidb/table-metadata": [
        "../../feature/table-metadata/src/index.ts"
      ],
      "@hierarchidb/tabular-store": [
        "../../feature/tabular-store/src/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/vite-env.d.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
