{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist-types",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-shared-batch-processor": [
        "../../runtime-shared/batch-processor/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor/*": [
        "../../runtime-shared/batch-processor/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/vite-env.d.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
