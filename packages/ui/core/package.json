{
  "name": "@hierarchidb/ui-core",
  "version": "1.0.0",
  "description": "Core UI components and plugin system for HierarchiDB",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration --outDir dist/types --tsBuildInfoFile dist/types/.tsbuildinfo",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "build:tsc": "tsc",
    "dev:tsc": "tsc --watch"
  },
  "dependencies": {
    "react-gravatar": "^2.6.3",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/common-type": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.0.0",
    "@mui/material": "^7.3.1",
    "react": ">=18.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-gravatar": "^2.6.14",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "react": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "hierarchidb",
    "ui-core",
    "plugin-system",
    "react",
    "material-ui"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-router-dom"
    ]
  }
}
