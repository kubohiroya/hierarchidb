{
  "name": "@hierarchidb/ui-core",
  "version": "1.0.0",
  "description": "Core UI components and plugin system for HierarchiDB",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm run build:clean",
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "build:tsc": "pnpm run build:types",
    "dev:tsc": "tsc --watch"
  },
  "dependencies": {
    "react-gravatar": "^2.6.3",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/table-metadata": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-gravatar": "^2.6.14",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.1",
    "jsdom": "^26.1.0",
    "react": ">=18.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "hierarchidb",
    "ui-core",
    "plugin-system",
    "react",
    "material-ui"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-router-dom",
      "@hierarchidb/ui-icon"
    ]
  }
}
