      "types": "./dist/common-auth.d.ts",
      "import": "./dist/common-auth.js",
      "default": "./dist/common-auth.js"
    },
    "./common-types": {
      "types": "./dist/common-types.d.ts",
      "import": "./dist/common-types.js",
      "default": "./dist/common-types.js"
    },
