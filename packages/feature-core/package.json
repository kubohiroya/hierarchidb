    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hierarchidb/basemap-plugin": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/linker-plugin": "workspace:*",
    "@hierarchidb/location-plugin": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/plugin-presentation": "workspace:*",
    "@hierarchidb/plugin-registry": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/resolver-plugin": "workspace:*",
    "@hierarchidb/route-plugin": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/styler-plugin": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/timeline-plugin": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "typescript": "workspace:^5.9.3"
  }
