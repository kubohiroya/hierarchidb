{
  "name": "@hierarchidb/plugins-timeline-plugin",
  "version": "0.0.1",
  "description": "Timeline plugin scaffold for HierarchiDB (new design)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker-factory": {
      "types": "./dist/worker-factory/index.d.ts",
      "import": "./dist/worker-factory/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "worker-factory": [
        "dist/worker-factory/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ],
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "services": [
        "dist/services/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean",
    "build:tsc": "pnpm run build:types"
  },
  "dependencies": {
    "@hierarchidb/plugins-base-plugin": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-shared-module-paths": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@hierarchidb/ui-dialog": "workspace:*",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react-transition-group": "^4.4.12",
    "@types/node": "^20.10.5",
    "react": ">=18.0.0",
    "tsup": "^8.0.1",
    "typescript": "workspace:^5.9.3"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "timeline",
      "name": "Timeline Plugin",
      "icon": {
        "mui": "Timeline",
        "emoji": "🕒",
        "color": "#8a7cbf"
      }
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
    "@hierarchidb/ui-dialog",
    "@hierarchidb/runtime-worker",
    "@hierarchidb/runtime-shared-module-paths",
    "react"
  ]
}
}
