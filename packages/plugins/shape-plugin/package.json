{
  "name": "@hierarchidb/plugins-shape-plugin",
  "version": "0.1.0",
  "description": "Geographic shape data management plugin for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "shared": [
        "dist/shared/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ],
      "worker-factory": [
        "dist/worker-factory/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "import": "./dist/services/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./worker-factory": {
      "types": "./dist/worker-factory/index.d.ts",
      "import": "./dist/worker-factory/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/plugins-base-plugin": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/plugins-folder-plugin": "workspace:*",
    "@hierarchidb/runtime-ui-datasource": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-shared-fetch-metadata": "workspace:*",
    "@hierarchidb/runtime-shared-module-paths": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@mapbox/vector-tile": "^2.0.3",
    "@tanstack/react-virtual": "^3.2.0",
    "@turf/turf": "^7.0.0",
    "allotment": "^1.20.0",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "notistack": "^3.0.1",
    "pako": "^2.1.0",
    "pbf": "^4.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "@hierarchidb/common-type": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^5.16.7 || ^6.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "dexie": "^4.2.0",
    "uuid": "^11.1.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.14",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@types/topojson-client": "^3.1.4",
    "@types/topojson-server": "^3.0.4",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^25.0.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^5.16.7 || ^6.0.0",
    "@mui/icons-material": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "shape",
      "name": "Shape Plugin",
      "icon": {
        "mui": "Hexagon",
        "emoji": "♦️",
        "color": "#a3b030"
      },
      "priority": 800,
      "category": "geographic",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "optionalDependencies": [
        "basemap"
      ],
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": false,
        "supportsBatchProcessing": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "dataSourceName",
            "type": "string",
            "required": true
          },
          {
            "name": "selectedCountries",
            "type": "array",
            "required": true
          },
          {
            "name": "selectedAdminLevels",
            "type": "array",
            "required": true
          },
          {
            "name": "licenseAgreement",
            "type": "boolean",
            "required": true
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@hierarchidb/download",
      "@hierarchidb/runtime-worker-bootstrap",
      "@hierarchidb/runtime-shared-module-paths",
      "@mui/icons-material",
      "@mui/material",
      "dexie",
      "react",
      "react-dom"
    ]
  }
}
