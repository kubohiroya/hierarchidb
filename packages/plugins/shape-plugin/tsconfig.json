{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ES2020",
      "DOM",
      "WebWorker"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-ui-datasource": [
        "./src/types/runtime-ui-datasource"
      ],
      "@hierarchidb/runtime-ui-datasource/*": [
        "./src/types/runtime-ui-datasource"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "../../runtime-ui/plugin-dialog/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "../../runtime-ui/plugin-dialog/src/*"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/shared/**/*",
    "src/types/**/*",
    "src/services/**/*",
    "src/worker/api.ts",
    "src/worker/handlers/**/*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "src/ui/**",
    "src/components/**",
    "src/worker/**",
    "src/extension/handler.ts"
  ]
}
