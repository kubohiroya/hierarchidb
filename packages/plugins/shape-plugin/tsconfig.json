{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "lib": [
      "ES2020",
      "DOM",
      "WebWorker"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-ui-datasource": [
        "../../runtime-ui/datasource/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-ui-datasource/*": [
        "../../runtime-ui/datasource/dist/*"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata": [
        "../../runtime-shared/fetch-metadata/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata/*": [
        "../../runtime-shared/fetch-metadata/dist/*"
      ],
      "@hierarchidb/plugins-runtime-worker-factory": [
        "../runtime-worker-factory/dist/index.d.ts"
      ],
      "@hierarchidb/plugins-runtime-worker-factory/*": [
        "../runtime-worker-factory/dist/*"
      ],
      "@hierarchidb/batch": [
        "../../feature/batch/dist/index.d.ts"
      ],
      "@hierarchidb/batch/*": [
        "../../feature/batch/dist/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "../../runtime-ui/plugin-dialog/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "../../runtime-ui/plugin-dialog/dist/*"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/shared/**/*",
    "src/types/**/*",
    "src/services/**/*",
    "src/worker/api.ts",
    "src/worker/handlers/**/*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "src/ui/**",
    "src/components/**",
    "src/worker/**",
    "src/extension/handler.ts"
  ]
}
