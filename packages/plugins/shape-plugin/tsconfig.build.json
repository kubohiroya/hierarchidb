{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/runtime-ui-datasource": [
        "../../runtime-ui/datasource/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-datasource/*": [
        "../../runtime-ui/datasource/src/*"
      ]
    }
  },
  "include": [
    "src/types/**/*.ts",
    "src/types/**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/__tests____tests__migration/**",
    "src/ui/**",
    "src/extension/**",
    "src/components/**",
    "src/services/**",
    "src/worker/**",
    "src/api/**",
    "dist/**"
  ]
}
