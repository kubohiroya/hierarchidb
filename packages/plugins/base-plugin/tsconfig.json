{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-shared-batch-processor": [
        "../../runtime-shared/batch-processor/dist/index.d.ts",
        "../../runtime-shared/batch-processor/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor/*": [
        "../../runtime-shared/batch-processor/dist/*",
        "../../runtime-shared/batch-processor/src/*"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/**/*",
    "../../common/types/dist/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
