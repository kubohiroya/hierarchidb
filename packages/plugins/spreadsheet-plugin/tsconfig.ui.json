{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": []
  },
  "include": [
    "src/steps/**/*.ts",
    "src/steps/**/*.tsx",
    "src/ui/steps-provider.tsx",
    "src/extension/constants.ts",
    "src/extension/types.ts",
    "src/types/external.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/services/**/*",
    "src/database/**/*",
    "src/worker*",
    "src/utils/**/*",
    "**/*.spec.*",
    "**/__tests__/**"
  ]
}
