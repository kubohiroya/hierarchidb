{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/runtime-shared-batch-processor": [
        "../../runtime-shared/batch-processor/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor/*": [
        "../../runtime-shared/batch-processor/dist/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "../../runtime-ui/plugin-dialog/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "../../runtime-ui/plugin-dialog/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ]
}
