{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/ui-datasource": [
        "../../ui/datasource/src/index.ts"
      ],
      "@hierarchidb/ui-datasource/*": [
        "../../ui/datasource/src/*"
      ],
      "@hierarchidb/ui-license": [
        "../../ui/license/src/index.ts"
      ],
      "@hierarchidb/ui-license/*": [
        "../../ui/license/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ]
}
