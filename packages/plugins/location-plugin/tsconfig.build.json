{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/plugin-sdk": [
        "../../plugins/base-plugin/dist-types/index.d.ts"
      ],
      "@hierarchidb/plugin-sdk/*": [
        "../../plugins/base-plugin/dist-types/*"
      ]
    },
    "declarationDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "dist-types",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../plugins/base-plugin/tsconfig.build.json"
    },
    {
      "path": "../../ui/datasource/tsconfig.build.json"
    },
    {
      "path": "../../ui/license/tsconfig.build.json"
    }
  ]
}
