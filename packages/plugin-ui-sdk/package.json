{
  "name": "@hierarchidb/plugin-ui-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint src",
    "build:types": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts-only",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts=false --no-clean"
  },
  "dependencies": {},
  "peerDependencies": {
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/download": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/geojson-vt": "^3.2.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/minimist": "^1.2.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-resizable": "^3.0.8",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3",
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/download": "workspace:*"
  },
  "tsup": {
    "external": [
      "@hierarchidb/batch-types",
      "@hierarchidb/batch-types/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/download",
      "@hierarchidb/download/*",
      "dexie",
      "react"
    ]
  }
}
