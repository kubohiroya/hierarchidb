{
  "name": "@hierarchidb/plugin-ui-sdk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown src/index.ts --config ../../tsdown.config.ts --outDir dist",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --project tsconfig.json --outDir dist",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "comlink": "^4.4.1",
    "jotai": "^2.13.1",
    "@hierarchidb/worker-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/geojson-vt": "^3.2.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/minimist": "^1.2.5",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-resizable": "^3.0.8",
    "typescript": "workspace:^5.9.3",
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "jotai": "^2.13.1",
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.1.0",
    "comlink": "^4.4.1"
  }
}
