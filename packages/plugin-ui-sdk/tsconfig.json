{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "vitest.*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": false,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
