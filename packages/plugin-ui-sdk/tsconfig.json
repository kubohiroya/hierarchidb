{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "geos-wasm": [
        "types/geos-wasm.d.ts"
      ],
      "geos-wasm/helpers": [
        "types/geos-wasm.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "vitest.*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/__tests__/**/*"
  ],
  "checkDeps": {
    "allowSkipLibCheck": false,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
