{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "skipLibCheck": false,
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "checkDeps": {
    "allowSkipLibCheck": false,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
