    "@maplibre/vt-pbf": "^4.0.3",
    "@turf/turf": "^7.0.0",
    "flatgeobuf": "^4.4.0",
    "geojson-vt": "^3.2.1",
    "@hierarchidb/shape-store": "workspace:*",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3"
  },
  "devDependencies": {
    "@hierarchidb/chunk-store": "workspace:*",
