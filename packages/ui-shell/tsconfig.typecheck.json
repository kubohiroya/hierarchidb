      ],
      "@hierarchidb/ui-auth/*": [
        "packages/ui/auth/dist/*"
      ],
      "@hierarchidb/ui-dialog": [
        "packages/ui/dialog/dist/index.d.ts"
      ],
      "@hierarchidb/ui-dialog/*": [
        "packages/ui/dialog/dist/*"
      ],
      "@hierarchidb/ui-icon": [
        "packages/ui/icon/dist/index.d.ts"
