{
  "name": "@hierarchidb/runtime-basic-info",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "react-virtuoso": "^4.14.0",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "react-virtuoso": "^4.14.0",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^18.3.1"
  },
  "keywords": [],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "tsup": {
    "external": [
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/runtime-client",
      "@hierarchidb/runtime-client/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "react",
      "react-virtuoso"
    ]
  }
