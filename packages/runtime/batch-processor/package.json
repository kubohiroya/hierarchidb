{
  "name": "@hierarchidb/runtime-batch-processor",
  "version": "1.0.0",
  "description": "Batch processing utilities for HierarchiDB",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@hierarchidb/common-type": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^18.19.24",
    "tsup": "^8.5.0",
    "typescript": "^4.9.5",
    "vitest": "^4.0.0-beta.9"
  },
  "keywords": [
    "hierarchidb",
    "batch-processor",
    "utilities"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT"
}