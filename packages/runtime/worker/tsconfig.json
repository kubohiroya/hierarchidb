{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "emitDeclarationOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/plugin-registry": [
        "../../plugin-registry/dist/registry.js"
      ],
      "@hierarchidb/plugin-registry/*": [
        "../../plugin-registry/dist/*"
      ],
      "@hierarchidb/plugin-service-api": [
        "../../plugin-service-api/dist/index.js"
      ],
      "@hierarchidb/plugin-service-api/*": [
        "../../plugin-service-api/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/e2e*.test.ts",
    "src*.spec.ts"
  ],
  "references": [
    { "path": "../../plugin-service-api" }
  ]
}
