{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "emitDeclarationOnly": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/plugin-registry": [
        "../../plugin-registry/generated/registry.ts"
      ],
      "@hierarchidb/plugin-registry/*": [
        "../../plugin-registry/src/*",
        "../../plugin-registry/generated/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/e2e*.test.ts",
    "src*.spec.ts"
  ]
}
