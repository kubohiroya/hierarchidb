{
  "name": "@hierarchidb/runtime-worker",
  "version": "0.0.1",
  "description": "Worker-side database and processing for hierarchidb",
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run build:types && pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "wfl": "node -e \"require('fs').mkdirSync('../../../reports/runtime-worker', { recursive: true })\" && vitest run src/e2e/__tests__/cp-routing-wc.wfl.test.ts --reporter=default --reporter=junit --outputFile=../../../reports/runtime-worker/cp-routing-wfl.xml",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:types": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts-only",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --dts=false --no-clean"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "dexie": "^4.2.0",
    "geojson-vt": "^3.2.1",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.22.3"
  },
  "peerDependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/compute": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/feature-registry": "workspace:*",
    "@hierarchidb/import-export": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/map-source": "workspace:*",
    "@hierarchidb/plugin-registry": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@maplibre/vt-pbf": "^4.0.3",
    "jotai": "^2.13.1"
  },
  "optionalDependencies": {
    "@hierarchidb/tabular-xlsx": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@types/vt-pbf": "^3.1.0",
    "fake-indexeddb": "^6.2.2",
    "vitest": "^3.2.4",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/compute": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/import-export": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/map-source": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/feature-registry": "workspace:*"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@hierarchidb/auth-recovery",
      "@hierarchidb/auth-recovery/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/compute",
      "@hierarchidb/compute/*",
      "@hierarchidb/download",
      "@hierarchidb/download/*",
      "@hierarchidb/feature-registry",
      "@hierarchidb/feature-registry/*",
      "@hierarchidb/import-export",
      "@hierarchidb/import-export/*",
      "@hierarchidb/map-adapter",
      "@hierarchidb/map-adapter/*",
      "@hierarchidb/map-source",
      "@hierarchidb/map-source/*",
      "@hierarchidb/plugin-registry",
      "@hierarchidb/plugin-registry/*",
      "@hierarchidb/plugin-types",
      "@hierarchidb/plugin-types/*",
      "@hierarchidb/tabular-source",
      "@hierarchidb/tabular-source-xlsx",
      "@hierarchidb/tabular-source-xlsx/*",
      "@hierarchidb/tabular-source/*",
      "@hierarchidb/tabular-store",
      "@hierarchidb/tabular-store/*",
      "@hierarchidb/tag",
      "@hierarchidb/tag/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*",
      "@maplibre/vt-pbf",
      "@maplibre/vt-pbf/*",
      "jotai"
    ]
  }
}
