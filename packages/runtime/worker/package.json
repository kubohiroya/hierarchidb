{
  "name": "@hierarchidb/runtime-worker",
  "version": "0.0.1",
  "description": "Worker-side database and processing for hierarchidb",
  "type": "module",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle && pnpm run build:pack",
    "build:tsc": "pnpm run build:types",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "wfl": "node -e \"require('fs').mkdirSync('../../../reports/runtime-worker', { recursive: true })\" && vitest run src/e2e/__tests__/cp-routing-wc.wfl.test.ts --reporter=default --reporter=junit --outputFile=../../../reports/runtime-worker/cp-routing-wfl.xml",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:clean": "rm -rf dist dist-types",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "tsup",
    "build:pack": "node ../../../scripts/pkg-build/copy-dist-types.mjs",
    "prebuild": "pnpm run build:clean"
  },
  "dependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/compute": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/feature-registry": "workspace:*",
    "@hierarchidb/import-export": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/map-source": "workspace:*",
    "@hierarchidb/runtime-shared-batch-processor": "workspace:*",
    "@hierarchidb/runtime-shared-module-paths": "workspace:*",
    "@hierarchidb/tabular": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@maplibre/vt-pbf": "^4.0.3",
    "comlink": "^4.4.2",
    "dexie": "^4.2.0",
    "geojson-vt": "^3.2.1",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.22.3"
  },
  "peerDependencies": {
    "jotai": "^2.13.1"
  },
  "optionalDependencies": {
    "@hierarchidb/tabular-xlsx": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@types/vt-pbf": "^3.1.0",
    "fake-indexeddb": "^6.2.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "jotai"
    ]
  }
}
