{
  "name": "@hierarchidb/runtime-client",
  "version": "0.0.1",
  "description": "Worker initialization notification system for reliable Worker-UI communication",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "build": "pnpm run build:bundle",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build:tsc": "pnpm run build:types",
    "prebuild:bundle": "pnpm run build:types"
  },
  "keywords": [
    "worker",
    "initialization",
    "message-channel",
    "notification",
    "web-worker"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitest/ui": "^3.2.4",
    "comlink": "^4.4.1",
    "fake-indexeddb": "^5.0.2",
    "prettier": "^3.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.1",
    "typescript": "workspace:^5.9.3",
    "vite": "^5.0.11",
    "vitest": "^3.2.4",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*"
  },
  "peerDependencies": {
    "comlink": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*"
  },
  "peerDependenciesMeta": {
    "comlink": {
      "optional": true
    }
  },
  "tsup": {
    "external": [
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/runtime-worker",
      "@hierarchidb/runtime-worker/*",
      "comlink",
      "react",
      "react-dom"
    ]
  }
}
