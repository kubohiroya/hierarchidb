{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "react-transition-group"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "skipLibCheck": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "../../types/react-transition-group/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ]
}
