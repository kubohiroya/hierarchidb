{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/plugin-service-api": [
        "../plugin-service-api/src/index.ts"
      ]
    },
    "skipLibCheck": false,
    "baseUrl": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ]
}
