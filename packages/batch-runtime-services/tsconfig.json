{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "skipLibCheck": false,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "~/*": [
        "*.ts",
        "*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "***.spec.ts"
  ]
}
