{
  "name": "@hierarchidb/batch-runtime-services",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint src",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch"
  },
  "dependencies": {},
  "peerDependencies": {
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*"
  },
  "tsup": {
    "external": [
      "@hierarchidb/auth-recovery",
      "@hierarchidb/auth-recovery/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/download",
      "@hierarchidb/download/*"
    ]
  }
}
