{
  "name": "@hierarchidb/components",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build-session": {
      "types": "./dist/build-session/index.d.ts",
      "import": "./dist/build-session/index.js",
      "default": "./dist/build-session/index.js"
    },
    "./notify": {
      "types": "./dist/notify/index.d.ts",
      "import": "./dist/notify/index.js",
      "default": "./dist/notify/index.js"
    },
    "./build-status": {
      "types": "./dist/build-status/index.d.ts",
      "import": "./dist/build-status/index.js",
      "default": "./dist/build-status/index.js"
    },
    "./build-stage": {
      "types": "./dist/build-stage/index.d.ts",
      "import": "./dist/build-stage/index.js",
      "default": "./dist/build-stage/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/build-session/index.ts src/notify/index.ts src/build-status/index.ts src/build-stage/index.ts --config ../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hierarchidb/ui-dialog": "workspace:*"
  },
  "peerDependencies": {
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.132.33",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "11.14.0",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*"
  },
  "keywords": [],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.132.33",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "11.14.0",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*"
  }
}
