{
  "name": "@hierarchidb/components",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tanstack/react-router": "^1.132.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "11.14.0",
    "@hierarchidb/common-types": "workspace:*"
  },
  "keywords": [],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "devDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tanstack/react-router": "^1.132.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "11.14.0",
    "@hierarchidb/common-types": "workspace:*"
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "@tanstack/react-router",
      "@tanstack/react-router/*",
      "react",
      "react-dom",
      "react-virtuoso"
    ]
  }
}
