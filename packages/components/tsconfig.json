{
  "extends": "../../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "emitDeclarationOnly": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*.mts",
        "./src/*.cts",
        "./src/*.js",
        "./src/*.jsx",
        "./src/*.mjs",
        "./src/*.cjs",
        "./src/*.json"
      ],
      "~/public/*": ["./public/*"]
    }
  },
  "include": ["src/**/*"]
}
