{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "composite": true,
    "incremental": true,
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
