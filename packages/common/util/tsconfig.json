{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": true,
    "skipLibCheck": true, // Required for @types/node compatibility with TypeScript 4.9
    "incremental": true,
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node", "vite/client", "vitest"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
