{
  "name": "@hierarchidb/common-types",
  "version": "0.0.1",
  "description": "Core types and data models for hierarchidb",
  "type": "module",
  "sideEffects": [
    "./src/ambient-ui-global.ts"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "biome check --write src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*"
  }
}
