{
  "name": "@hierarchidb/common-types",
  "version": "0.0.1",
  "description": "Core types and data models for hierarchidb",
  "type": "module",
  "sideEffects": [
    "./src/ambient-ui-global.ts"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:bundle",
    "build:tsc": "pnpm run build:types",
    "dev": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "cross-env NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "prebuild": "pnpm run build:clean"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "fake-indexeddb": "^6.1.0"
  },
  "license": "MIT"
}
