{
  "name": "@hierarchidb/plugin-ui-host",
  "version": "0.0.1",
  "type": "module",
  "description": "Host-side UI components for HierarchiDB plugin dialogs",
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write src",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-presentation": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@types/jest": "^30.0.0",
    "es6": "link:@types/fast-deep-equal/es6",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.141.2",
    "@types/react": "^18.3.27",
    "comlink": "^4.4.2",
    "jotai": "^2.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.8.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.132.33",
    "comlink": "^4.4.2",
    "jotai": "^2.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "turbo": {
    "pipeline": {}
  }
}
