{
  "name": "@hierarchidb/plugin-ui-host",
  "version": "0.0.1",
  "type": "module",
  "description": "Host-side UI components for HierarchiDB plugin dialogs",
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --config ../../../tsdown.config.ts --outDir dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "format": "biome check --write src",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hierarchidb/components": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-presentation": "workspace:*",
    "@hierarchidb/tag-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.141.2",
    "@types/react": "^19.1.1",
    "comlink": "^4.4.2",
    "dequal": "^2.0.3",
    "jotai": "^2.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.8.2",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-presentation": "workspace:*",
    "@hierarchidb/tag-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@tanstack/react-router": "^1.132.33",
    "comlink": "^4.4.2",
    "jotai": "^2.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "dequal": "^2.0.3"
  },
  "turbo": {
    "pipeline": {}
  }
}
