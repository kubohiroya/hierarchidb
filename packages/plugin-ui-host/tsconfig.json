{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": [
      "react",
      "react/jsx-runtime"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/examples/**/*",
    "**/*.test.*",
    "**/*.spec.*",
    "src/tests/**",
    "src/__tests__/**"
  ],
  "references": [
    { "path": "./tsconfig.vitest.json" }
  ],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
