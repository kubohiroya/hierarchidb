{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "@testing-library/jest-dom/vitest",
      "react",
      "react/jsx-runtime"
    ]
  },
  "include": [
    "./vitest-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/__tests__/**/*",
    "../../vitest.setup.ts",
    "../../vitest.setup.base.ts"
  ]
}
