{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "Node16",
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/plugin-ui-sdk": [
        "../../packages/plugin-ui-sdk/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-ui-sdk/*": [
        "../../packages/plugin-ui-sdk/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.ts",
    "__tests__/**",
    "src/__tests__/**"
  ]
}
