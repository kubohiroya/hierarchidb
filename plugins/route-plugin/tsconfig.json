{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__*.test.*",
    "**/*.spec.ts",
    "__tests__/**",
    "src/__tests__/**"
  ]
}
