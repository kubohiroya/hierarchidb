{
  "extends": "../../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "experimentalDecorators": true,
    "baseUrl": "."
  },
  "include": [
    "../../global.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**/*",
    "src/common/__tests__/**/*",
    "src/ui/**/__tests__/**/*",
    "src/common/tabular/**/*",
    "src/worker/tabular/**/*",
    "**/__tests__*.test.*",
    "**/*.spec.ts",
    "__tests__/**",
    "src/__tests__/**"
  ]
}
