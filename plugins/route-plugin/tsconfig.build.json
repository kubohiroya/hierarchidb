{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@hierarchidb/batch-types": [
        "../../packages/batch-types/dist/index.d.ts"
      ],
      "@hierarchidb/batch-types/*": [
        "../../packages/batch-types/dist/*"
      ],
      "@hierarchidb/batch-runtime-services": [
        "../../packages/batch-runtime-services/dist/index.d.ts"
      ],
      "@hierarchidb/batch-runtime-services/*": [
        "../../packages/batch-runtime-services/dist/*"
      ],
      "@hierarchidb/runtime-plugin-dialog": [
        "../../packages/runtime/plugin-dialog/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-plugin-dialog/*": [
        "../../packages/runtime/plugin-dialog/dist/*"
      ],
      "@hierarchidb/download": [
        "../../packages/feature/download/dist/index.d.ts"
      ],
      "@hierarchidb/download/*": [
        "../../packages/feature/download/dist/*"
      ],
      "@hierarchidb/plugin-ui-sdk": [
        "../../packages/plugin-ui-sdk/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-ui-sdk/*": [
        "../../packages/plugin-ui-sdk/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/runtime/plugin-dialog/dist/index.d.ts",
    "../../packages/batch-runtime-services/dist/index.d.ts",
    "../../packages/batch-types/dist/index.d.ts",
    "../../packages/feature/download/dist/index.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.ts",
    "__tests__/**"
  ],
  "references": [
  ]
}
