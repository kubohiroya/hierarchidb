{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.ts",
    "__tests__/**"
  ],
  "references": [
    { "path": "../../packages/batch-runtime-services/tsconfig.build.json" },
    { "path": "../../packages/batch-types/tsconfig.json" },
    { "path": "../../packages/runtime/plugin-dialog/tsconfig.build.json" },
    { "path": "../../packages/feature/download/tsconfig.build.json" }
  ]
}
