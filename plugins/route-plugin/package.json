{
  "name": "@hierarchidb/route-plugin",
  "type": "module",
  "version": "1.0.0",
  "description": "Route management plugin extending Shape plugin for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./database": {
      "types": "./dist/services/database/index.d.ts",
      "import": "./dist/services/database/index.js",
      "default": "./dist/services/database/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "database": [
        "dist/services/database/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/services/database/index.ts src/ui/index.ts src/worker/index.ts src/worker/factory/index.ts src/icon/index.ts --config ../../tsdown.config.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "searoute-js": "^0.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/node": "^20.10.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "workspace:^5.9.3"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "route",
      "name": "Route Plugin",
      "icon": {
        "mui": "Route",
        "emoji": "\u3030\ufe0f",
        "color": "#a3b030",
        "component": {
          "specifier": "@hierarchidb/route-plugin/icon",
          "exportName": "RoutePluginIcon"
        }
      }
    }
  }
}
