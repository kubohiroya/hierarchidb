{
  "name": "@hierarchidb/styler-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "Styler Plugin for HierarchiDB - Dynamic styling for map visualizations",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/services/index.ts src/ui/index.ts src/icon/index.ts --config ../../tsdown.config.ts --outDir dist",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "biome check --write src",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "dev:tsc": "tsc --watch",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json"
  },
  "dependencies": {
    "@hierarchidb/origin-coordinator": "workspace:*",
    "jszip": "^3.10.1",
    "react-window": "^1.8.10",
    "xlsx": "^0.18.5",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/spreadsheet-store": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@hierarchidb/ui-modal-select": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*"
  },
  "peerDependencies": {
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@hierarchidb/spreadsheet-store": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-tabular": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "dexie": "^4.2.0",
    "i18next": "22.5.0",
    "jotai": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "12.3.1"
  },
  "devDependencies": {
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/spreadsheet-store": "workspace:*",
    "@hierarchidb/styler-store": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-tabular": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@testing-library/react": "^14.0.0",
    "@types/react-window": "^1.8.8",
    "@vitest/ui": "^4.1.0",
    "dexie": "^4.2.0",
    "jotai": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "hierarchidb",
    "plugin",
    "styler",
    "csv",
    "tsv",
    "maplibre",
    "visualization",
    "color-mapping"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "styler",
      "name": "Styler Plugin",
      "description": "Import spreadsheet data, filter them, and produce styling rules that drive themed visualizations on maps.",
      "i18nNamespace": "styler-plugin",
      "stepTitleKeys": {
        "1": "basicInfo",
        "2": "dataSource",
        "3": "filtering",
        "4": "mappingKeys",
        "5": "target",
        "6": "styleAlgorithm",
        "7": "preview"
      },
      "icon": {
        "mui": "Palette",
        "emoji": "🎨",
        "color": "#dcbc50",
        "component": {
          "specifier": "@hierarchidb/styler-plugin/icon",
          "exportName": "StylerPluginIcon"
        }
      },
      "priority": 700,
      "category": "visualization",
      "extends": "spreadsheet",
      "dependencies": [
        "@hierarchidb/spreadsheet-plugin"
      ],
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "csvData",
            "type": "string",
            "required": true
          },
          {
            "name": "mappingConfig",
            "type": "object",
            "required": true
          }
        ]
      }
    }
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/spreadsheet-plugin#build"
        ]
      }
    }
  }
}
