{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM"
    ],
    "noEmit": true,
    "composite": false,
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "~/*.js": [
        "./src/*.ts"
      ],
      "@hierarchidb/plugin-types": [
        "../../packages/plugin-types/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-types/*": [
        "../../packages/plugin-types/dist/*"
      ],
      "@hierarchidb/plugin-ui-sdk": [
        "../../packages/plugin-ui-sdk/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-ui-sdk/*": [
        "../../packages/plugin-ui-sdk/dist/*"
      ],
      "@hierarchidb/plugin-runtime-services": [
        "../../packages/plugin-runtime-services/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-runtime-services/*": [
        "../../packages/plugin-runtime-services/dist/*"
      ],
      "@hierarchidb/ui-tabular-extract": [
        "../../packages/ui/tabular-extract/dist/index.d.ts"
      ],
      "@hierarchidb/ui-tabular-extract/*": [
        "../../packages/ui/tabular-extract/dist/*"
      ],
      "@hierarchidb/runtime-worker": [
        "../../packages/runtime/worker/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-worker/*": [
        "../../packages/runtime/worker/dist/*"
      ]
    },
    "module": "Node16"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "src/tests/**"
  ],
  "references": [],
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Temporary: upstream/transitive types; scheduled to remove."
  }
}
