{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true
  },
  "include": [
    "../../global.d.ts",
    "src/common/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "src/services/**/*",
    "src/ui/**/*",
    "src/worker/api.ts",
    "src/worker/handlers/**/*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
