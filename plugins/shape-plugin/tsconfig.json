{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "WebWorker"
    ],
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "~/*": [
        "plugins/shape-plugin/src/*"
      ]
    }
  },
  "include": [
    "src/shared/**/*",
    "src/types/**/*",
    "src/services/**/*",
    "src/worker/api.ts",
    "src/worker/handlers/**/*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
