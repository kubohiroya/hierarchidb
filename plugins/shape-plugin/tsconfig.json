{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "lib": [
      "ES2020",
      "DOM",
      "WebWorker"
    ],
    "outDir": "./dist",
    "jsx": "react-jsx",
    "module": "Node16",
    "paths": {
      "@hierarchidb/runtime-worker": [
        "./src/types/runtime-worker.d.ts"
      ],
      "@hierarchidb/plugin-runtime-services": [
        "./src/types/module-stubs.d.ts"
      ],
      "@hierarchidb/plugin-ui-sdk": [
        "./src/types/module-stubs.d.ts"
      ],
      "@hierarchidb/batch-runtime-services": [
        "./src/types/module-stubs.d.ts"
      ],
      "@hierarchidb/compute": [
        "./src/types/module-stubs.d.ts"
      ]
    }
  },
  "include": [
    "src/shared/**/*",
    "src/types/**/*",
    "src/services/**/*",
    "src/worker/api.ts",
    "src/worker/handlers/**/*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
