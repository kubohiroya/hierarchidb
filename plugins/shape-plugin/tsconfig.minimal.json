{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "NodeNext"
  },
  "include": [
    "src/shared*",
    "src/worker/api.ts",
    "src/worker/handlers*",
    "src/worker/plugin.ts"
  ],
  "exclude": [
    "src/services*",
    "src/types*",
    "src/ui*",
    "**__tests__/**"
  ]
}
