{
  "name": "@hierarchidb/shape-plugin",
  "version": "0.1.0",
  "description": "Geographic shape data management plugin for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "shared": [
        "dist/shared/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter hierarchidb metadata:ensure",
    "build": "tsdown src/common/shared/index.ts src/index.ts src/services/index.ts src/ui/index.ts src/worker/index.ts src/worker/public.ts src/worker/shapeEntitiesDB.ts src/worker/shapeGroupStore.dexie.ts src/worker/shapeRelationStore.dexie.ts src/icon/index.ts --config ../../tsdown.config.ts --splitting false",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "@tanstack/react-virtual": "^3.2.0",
    "@turf/turf": "^7.0.0",
    "allotment": "^1.20.0",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "notistack": "^3.0.1",
    "pako": "^2.1.0",
    "pbf": "^4.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*"
  },
  "peerDependencies": {
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-tabular-extract": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/plugin-service-sdk": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.2",
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "dexie": "^4.2.0",
    "uuid": "^11.1.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.14",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@types/topojson-client": "^3.1.4",
    "@types/topojson-server": "^3.0.4",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^25.0.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.6",
    "vitest": "^3.2.4",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-tabular-extract": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/plugin-service-sdk": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*"
  },
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "shape",
      "name": "Shape Plugin",
      "description": "Import country and administrative-area shape files from online data sources, analyze them, and present the results in coordinated map views.",
      "icon": {
        "mui": "Hexagon",
        "emoji": "♦️",
        "color": "#a3b030",
        "component": {
          "specifier": "@hierarchidb/shape-plugin/icon",
          "exportName": "ShapePluginIcon"
        }
      },
      "priority": 800,
      "category": "geographic",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "optionalDependencies": [
        "basemap"
      ],
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": false,
        "supportsBatchProcessing": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "dataSourceName",
            "type": "string",
            "required": true
          },
          {
            "name": "selectedCountries",
            "type": "array",
            "required": true
          },
          {
            "name": "selectedAdminLevels",
            "type": "array",
            "required": true
          },
          {
            "name": "licenseAgreement",
            "type": "boolean",
            "required": true
          }
        ]
      }
    }
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/plugin-base#build"
        ]
      }
    }
  }
}
