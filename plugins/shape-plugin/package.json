{
  "name": "@hierarchidb/shape-plugin",
  "version": "0.1.0",
  "description": "Geographic shape data management plugin for HierarchiDB",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "shared": [
        "dist/shared/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "prebuild:types": "pnpm --filter @hierarchidb/runtime-plugin-dialog build:types && pnpm --filter @hierarchidb/plugin-runtime-services build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "prebuild:bundle": "pnpm --filter @hierarchidb/runtime-plugin-dialog build:bundle && pnpm run build:types",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "build": "pnpm run build:bundle",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/plugin-runtime-services": "workspace:*",
    "@mapbox/vector-tile": "^2.0.3",
    "@tanstack/react-virtual": "^3.2.0",
    "@turf/turf": "^7.0.0",
    "allotment": "^1.20.0",
    "comlink": "^4.4.2",
    "jszip": "^3.10.1",
    "notistack": "^3.0.1",
    "pako": "^2.1.0",
    "pbf": "^4.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1"
  },
  "peerDependencies": {
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "dexie": "^4.2.0",
    "uuid": "^11.1.0",
    "@types/uuid": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.14",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@types/topojson-client": "^3.1.4",
    "@types/topojson-server": "^3.0.4",
    "fake-indexeddb": "^6.1.0",
    "jsdom": "^25.0.1",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "vitest": "^3.2.4",
    "@hierarchidb/batch-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-accordion-config": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-lru-splitview": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/download": "workspace:*"
  },
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "shape",
      "name": "Shape Plugin",
      "icon": {
        "mui": "Hexagon",
        "emoji": "♦️",
        "color": "#a3b030"
      },
      "priority": 800,
      "category": "geographic",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "optionalDependencies": [
        "basemap"
      ],
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": false,
        "supportsBatchProcessing": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "dataSourceName",
            "type": "string",
            "required": true
          },
          {
            "name": "selectedCountries",
            "type": "array",
            "required": true
          },
          {
            "name": "selectedAdminLevels",
            "type": "array",
            "required": true
          },
          {
            "name": "licenseAgreement",
            "type": "boolean",
            "required": true
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@hierarchidb/auth-recovery",
      "@hierarchidb/auth-recovery/*",
      "@hierarchidb/batch",
      "@hierarchidb/batch-types",
      "@hierarchidb/batch-types/*",
      "@hierarchidb/batch/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-auth",
      "@hierarchidb/common-auth/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/download",
      "@hierarchidb/download/*",
      "@hierarchidb/folder-plugin",
      "@hierarchidb/folder-plugin/*",
      "@hierarchidb/plugin-types",
      "@hierarchidb/plugin-types/*",
      "@hierarchidb/runtime-client",
      "@hierarchidb/runtime-client/*",
      "@hierarchidb/runtime-plugin-dialog",
      "@hierarchidb/runtime-plugin-dialog/*",
      "@hierarchidb/runtime-worker",
      "@hierarchidb/runtime-worker/*",
      "@hierarchidb/tabular-store",
      "@hierarchidb/tabular-store/*",
      "@hierarchidb/ui-accordion-config",
      "@hierarchidb/ui-accordion-config/*",
      "@hierarchidb/ui-country-select",
      "@hierarchidb/ui-country-select/*",
      "@hierarchidb/ui-datasource",
      "@hierarchidb/ui-datasource/*",
      "@hierarchidb/ui-license",
      "@hierarchidb/ui-license/*",
      "@hierarchidb/ui-lru-splitview",
      "@hierarchidb/ui-lru-splitview/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "dexie",
      "react",
      "react-dom"
    ]
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build",
          "@hierarchidb/plugin-runtime-services#build"
        ]
      },
      "build:types": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build:types",
          "@hierarchidb/plugin-runtime-services#build:types"
        ]
      },
      "build:bundle": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build:bundle",
          "@hierarchidb/plugin-runtime-services#build:types"
        ]
      }
    }
  }
}
