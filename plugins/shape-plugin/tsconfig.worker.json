{
  "extends": "../../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./src/worker",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "src/worker*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/components",
    "src/ui",
    "src/services",
    "src/extension",
    "src/api"
  ]
}
