{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "module": "Node16",
    "moduleResolution": "Node16"
  },
  "include": [
    "src/common/**/*",
    "src/services/**/*",
    "src/ui/**/*",
    "src/types/**/*",
    "src/plugin-manifest.ts",
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
