{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/common/**/*",
    "src/services/**/*",
    "src/ui/**/*",
    "src/types/**/*",
    "src/plugin-manifest.ts",
    "src/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../../packages/plugin-runtime-services/tsconfig.build.json"
    },
    {
      "path": "../../packages/plugin-ui-sdk/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/plugin-dialog/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/worker/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/basic-info/tsconfig.build.json"
    },
    {
      "path": "../../packages/feature/download/tsconfig.build.json"
    }
  ]
}
