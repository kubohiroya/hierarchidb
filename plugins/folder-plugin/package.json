{
  "name": "@hierarchidb/folder-plugin",
  "version": "1.0.0",
  "description": "Basic folder plugin for HierarchiDB UI layer",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "shared": [
        "dist/shared/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "default": "./dist/shared/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "dev:tsc": "tsc --watch"
  },
  "dependencies": {},
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "dexie": "^4.2.0",
    "react": ">=18.0.0",
    "i18next": "22.5.0",
    "react-i18next": "12.3.1",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/runtime-basic-info": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*"
  },
  "devDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.2",
    "dexie": "^4.2.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "react": ">=18.0.0",
    "vitest": "^3.2.4",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/runtime-basic-info": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*"
  },
  "keywords": [
    "hierarchidb",
    "plugin",
    "folder",
    "ui"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "folder",
      "name": "Folder Plugin",
      "icon": {
        "mui": "Folder",
        "emoji": "📁",
        "color": "#c0eeff"
      },
      "priority": 1000,
      "category": "core",
      "dependencies": [],
      "capabilities": {
        "canHaveChildren": true,
        "canBeRoot": true,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": false
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/react/*",
      "@emotion/styled",
      "@emotion/styled/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/components",
      "@hierarchidb/components/*",
      "@hierarchidb/plugin-types",
      "@hierarchidb/plugin-types/*",
      "@hierarchidb/plugin-ui-sdk",
      "@hierarchidb/plugin-ui-sdk/*",
      "@hierarchidb/runtime-basic-info",
      "@hierarchidb/runtime-basic-info/*",
      "@hierarchidb/runtime-client",
      "@hierarchidb/runtime-client/*",
      "@hierarchidb/runtime-plugin-dialog",
      "@hierarchidb/runtime-plugin-dialog/*",
      "@hierarchidb/runtime-worker",
      "@hierarchidb/runtime-worker/*",
      "@hierarchidb/tag",
      "@hierarchidb/tag/*",
      "@hierarchidb/ui-dialog",
      "@hierarchidb/ui-dialog/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "dexie",
      "i18next",
      "react",
      "react-i18next"
    ]
  },
  "turbo": {
    "pipeline": {
      "typecheck": {
        "dependsOn": [
          "@hierarchidb/runtime-worker#build",
          "@hierarchidb/runtime-plugin-dialog#build",
          "@hierarchidb/runtime-basic-info#build",
          "@hierarchidb/plugin-ui-sdk#build"
        ]
      }
    }
  }
}
