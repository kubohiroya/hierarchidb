{
  "name": "@hierarchidb/folder-plugin",
  "version": "1.0.0",
  "description": "Basic folder plugin for HierarchiDB UI layer",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "worker": [
        "dist/worker/index.d.ts"
      ],
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/ui/index.ts src/icon/index.ts --config ../../tsdown.config.ts --splitting false",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "dev:tsc": "tsc --watch",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@hierarchidb/plugin-base": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "react": ">=18.0.0",
    "i18next": "22.5.0",
    "react-i18next": "12.3.1",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*"
  },
  "devDependencies": {
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "react": ">=18.0.0",
    "vitest": "^3.2.4",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/tag": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*"
  },
  "keywords": [
    "hierarchidb",
    "plugin",
    "folder",
    "ui"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "module": "dist/index.js",
  "type": "module",
  "hierarchidb": {
    "plugin": {
      "nodeType": "folder",
      "name": "Folder Plugin",
      "description": "Define hierarchical container nodes that semantically organize various types of nodes and consolidate their functions.",
      "icon": {
        "mui": "Folder",
        "emoji": "\ud83d\udcc1",
        "color": "#c0eeff",
        "component": {
          "specifier": "@hierarchidb/folder-plugin/icon",
          "exportName": "FolderPluginIcon"
        }
      },
      "priority": 1000,
      "category": "core",
      "dependencies": [],
      "capabilities": {
        "canHaveChildren": true,
        "canBeRoot": true,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true
          },
          {
            "name": "description",
            "type": "string",
            "required": false
          }
        ]
      }
    }
  },
  "turbo": {
    "pipeline": {}
  }
}
