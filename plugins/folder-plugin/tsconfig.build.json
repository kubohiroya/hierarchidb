{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {},
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/vite-env.d.ts"
  ],
  "references": [
    { "path": "../../packages/plugin-ui-sdk/tsconfig.build.json" },
    { "path": "../../packages/common/types/tsconfig.build.json" },
    { "path": "../../packages/common/api/tsconfig.build.json" },
    { "path": "../../packages/runtime/plugin-dialog/tsconfig.build.json" },
    { "path": "../../packages/runtime/basic-info/tsconfig.build.json" },
    { "path": "../../packages/runtime/worker/tsconfig.build.json" },
    { "path": "../../packages/runtime/client/tsconfig.build.json" },
    { "path": "../../packages/util/tsconfig.build.json" },
    { "path": "../../packages/components/tsconfig.build.json" },
    { "path": "../../packages/ui/dialog/tsconfig.build.json" },
    { "path": "../../packages/feature/tag/tsconfig.build.json" }
  ]
}
