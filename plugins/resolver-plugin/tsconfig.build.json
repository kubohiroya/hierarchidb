{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@hierarchidb/common-types": [
        "../../packages/common/types/dist/index.d.ts"
      ],
      "@hierarchidb/common-types/*": [
        "../../packages/common/types/dist/*"
      ],
      "@hierarchidb/runtime-plugin-dialog": [
        "../../packages/runtime/plugin-dialog/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-plugin-dialog/*": [
        "../../packages/runtime/plugin-dialog/dist/*"
      ],
      "@hierarchidb/common-api": [
        "../../packages/common/api/dist/index.d.ts"
      ],
      "@hierarchidb/common-api/*": [
        "../../packages/common/api/dist/*"
      ],
      "@hierarchidb/runtime-basic-info": [
        "../../packages/runtime/basic-info/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-basic-info/*": [
        "../../packages/runtime/basic-info/dist/*"
      ],
      "@hierarchidb/plugin-types": [
        "../../packages/plugin-types/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-types/*": [
        "../../packages/plugin-types/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
