{
  "name": "@hierarchidb/resolver-plugin",
  "version": "1.0.0",
  "description": "Resolver node type plugin for property mapping between different data schemas",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "database": [
        "dist/worker/database/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./database": {
      "types": "./dist/worker/database/index.d.ts",
      "import": "./dist/worker/database/index.js",
      "default": "./dist/worker/database/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/ui/index.ts src/worker/index.ts src/worker/database/index.ts src/worker/factory/index.ts src/icon/index.ts --config ../../tsdown.config.ts",
    "test": "vitest run",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "dexie": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "comlink": "^4.4.1",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*"
  },
  "devDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitest/ui": "^3.2.4",
    "dexie": "^4.2.0",
    "fake-indexeddb": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "workspace:^5.9.3",
    "vitest": "^3.2.4",
    "comlink": "^4.4.1",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "resolver",
      "name": "Resolver Plugin",
      "description": "Map heterogeneous schemas and properties into a unified structure so downstream plugins read consistent attributes.",
      "displayName": "Resolver",
      "icon": {
        "mui": "Extension",
        "emoji": "\ud83e\udde9",
        "color": "#ffb3c1",
        "component": {
          "specifier": "@hierarchidb/resolver-plugin/icon",
          "exportName": "ResolverPluginIcon"
        }
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 60
      },
      "priority": 60,
      "creatable": true,
      "tags": [
        "mapping",
        "schema"
      ],
      "capabilities": [
        "relationalData"
      ]
    }
  }
}
