{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "~/*": [
        "*",
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx",
        "*.mjs",
        "*.cjs",
        "*.mts",
        "*.cts"
      ]
    },
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "../../global.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*"
  ]
}
