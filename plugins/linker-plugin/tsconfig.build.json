{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    { "path": "../../packages/common/api/tsconfig.build.json" },
    { "path": "../../packages/common/types/tsconfig.build.json" },
    { "path": "../../packages/plugin-types/tsconfig.build.json" },
    { "path": "../../packages/runtime/plugin-dialog/tsconfig.build.json" },
    { "path": "../../packages/runtime/client/tsconfig.build.json" },
    { "path": "../../packages/runtime/worker/tsconfig.build.json" },
    { "path": "../../packages/ui/map/tsconfig.build.json" },
    { "path": "../../packages/ui/treeconsole/base/tsconfig.build.json" },
    { "path": "../../packages/util/tsconfig.build.json" }
  ]
}
