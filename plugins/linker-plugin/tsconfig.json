{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "baseUrl": ".",
    "jsx": "react-jsx"
  },
  "checkDeps": {
    "allowSkipLibCheck": true,
    "reason": "Deck.gl/luma + date-fns v3 d.ts require TS5; isolate to this package"
  },
  "exclude": [
    "node_modules",
    "dist",
    "***.test.tsx"
  ]
}
