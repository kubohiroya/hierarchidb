{
  "name": "@hierarchidb/linker-plugin",
  "version": "0.0.1",
  "description": "Linker plugin for HierarchiDB: link compiled resources into maps",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/services/index.ts src/ui/index.ts src/worker/factory/index.ts --config ../../tsdown.config.ts",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "lint": "eslint src"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "comlink": "^4.3.2",
    "dexie": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "^9.0.0",
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@deck.gl/mesh-layers": "^9.0.0",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/d3-scale": "^4.0.0",
    "@types/geojson": "^7946.0.10",
    "@types/react": "^18.3.1",
    "dexie": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "author": "",
  "license": "MIT",
  "hierarchidb": {
    "plugin": {
      "nodeType": "linker",
      "name": "Linker Plugin",
      "displayName": "Linker",
      "description": "Link compiled resources to map for usage",
      "icon": {
        "mui": "AccountTree",
        "emoji": "\ud83c\udf32",
        "color": "#ffe0f3"
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 10
      },
      "priority": 10,
      "creatable": true,
      "tags": [
        "linker",
        "container"
      ],
      "capabilities": [
        "workingCopy"
      ]
    }
  }
}
