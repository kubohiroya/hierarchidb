{
  "name": "@hierarchidb/spreadsheet-plugin",
  "version": "0.1.0",
  "description": "Next-generation Spreadsheet plugin built on shared tabular services",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/ui/index.ts src/worker/index.ts src/icon/index.ts --config ../../tsdown.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "pnpm vitest",
    "test:run": "pnpm vitest run",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info":"workspace:*",
    "@hierarchidb/ui-dialog":"workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-tabular-extract": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/ui-worker-provider":"workspace:*"
  },
  "devDependencies": {
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "fake-indexeddb": "^4.0.2",
    "vitest": "^3.2.4",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info":"workspace:*",
    "@hierarchidb/ui-dialog":"workspace:*",
    "@hierarchidb/ui-worker-provider":"workspace:*"
  }
}
