{
  "name": "@hierarchidb/spreadsheet-plugin",
  "type": "module",
  "version": "0.0.1",
  "description": "Spreadsheet plugin for HierarchiDB - extends folder plugin",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "database": [
        "dist/database/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "build": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.build.json",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@hierarchidb/plugin-runtime-services": "workspace:*",
    "@types/pako": "^2.0.3",
    "pako": "^2.1.0"
  },
  "turbo": {
    "pipeline": {
      "build": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build",
          "@hierarchidb/plugin-runtime-services#build"
        ]
      },
      "build:types": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build:types",
          "@hierarchidb/plugin-runtime-services#build:types"
        ]
      },
      "build:bundle": {
        "dependsOn": [
          "@hierarchidb/runtime-plugin-dialog#build:bundle",
          "@hierarchidb/plugin-runtime-services#build:types"
        ]
      }
    }
  },
  "peerDependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-tabular-extract": "workspace:*",
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-basic-info": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "i18next": "22.5.0",
    "react": "^18.3.1",
    "react-i18next": "12.3.1"
  },
  "devDependencies": {
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-tabular-extract": "workspace:*",
    "@hierarchidb/ui-file": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-basic-info": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "i18next": "22.5.0",
    "react": "^18.3.1",
    "fake-indexeddb": "^6.1.0",
    "react-i18next": "12.3.1",
    "tsup": "^8.5.0",
    "typescript": "workspace:^5.9.3",
    "vitest": "^3.2.4"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "spreadsheet",
      "name": "Spreadsheet Plugin",
      "icon": {
        "mui": "Assessment",
        "emoji": "📈",
        "color": "#dcbc50"
      },
      "priority": 600,
      "category": "data",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "capabilities": {
        "canHaveChildren": false,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "spreadsheetData",
            "type": "object",
            "required": true
          },
          {
            "name": "formulas",
            "type": "object",
            "required": false
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@hierarchidb/auth-recovery",
      "@hierarchidb/auth-recovery/*",
      "@hierarchidb/common-api",
      "@hierarchidb/common-api/*",
      "@hierarchidb/common-types",
      "@hierarchidb/common-types/*",
      "@hierarchidb/folder-plugin",
      "@hierarchidb/folder-plugin/*",
      "@hierarchidb/plugin-types",
      "@hierarchidb/plugin-types/*",
      "@hierarchidb/plugin-ui-sdk",
      "@hierarchidb/plugin-ui-sdk/*",
      "@hierarchidb/runtime-basic-info",
      "@hierarchidb/runtime-basic-info/*",
      "@hierarchidb/runtime-plugin-dialog",
      "@hierarchidb/runtime-plugin-dialog/*",
      "@hierarchidb/runtime-ui-plugin-dialog",
      "@hierarchidb/runtime-worker",
      "@hierarchidb/runtime-worker/*",
      "@hierarchidb/tabular-source",
      "@hierarchidb/tabular-source/*",
      "@hierarchidb/tabular-store",
      "@hierarchidb/tabular-store/*",
      "@hierarchidb/ui-datasource",
      "@hierarchidb/ui-datasource/*",
      "@hierarchidb/ui-file",
      "@hierarchidb/ui-file/*",
      "@hierarchidb/ui-tabular-extract",
      "@hierarchidb/ui-tabular-extract/*",
      "@hierarchidb/util",
      "@hierarchidb/util/*",
      "@mui/icons-material",
      "@mui/icons-material/*",
      "@mui/material",
      "@mui/material/*",
      "dexie",
      "i18next",
      "react",
      "react-i18next"
    ]
  }
}
