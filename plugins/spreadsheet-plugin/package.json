{
  "name": "@hierarchidb/spreadsheet-plugin",
  "version": "0.1.0",
  "description": "Next-generation Spreadsheet plugin built on shared tabular services",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js",
      "default": "./dist/worker/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "worker": [
        "dist/worker/index.d.ts"
      ],
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:dts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "pnpm vitest",
    "test:run": "pnpm vitest run",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:dts": "rollup -c rollup.dts.config.mjs",
    "build:js": "tsdown src/index.ts src/ui/index.ts src/worker/index.ts src/icon/index.ts --config ../../tsdown.config.ts"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/chunk-store": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/spreadsheet-store": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-modal-select": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-tabular": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "jotai": "^2.13.1",
    "react": ">=18.0.0",
    "flatgeobuf": "^4.4.0",
    "shpjs": "^6.2.0",
    "@hierarchidb/auth-api": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/chunk-store": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-modal-select": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/spreadsheet-store": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "fake-indexeddb": "^4.0.2",
    "jotai": "^2.13.1",
    "vitest": "^3.2.4",
    "flatgeobuf": "^4.4.0",
    "shpjs": "^6.2.0",
    "@hierarchidb/auth-api": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*"
  },
  "dependencies": {},
  "tsdown": {
    "dts": false
  }
}
