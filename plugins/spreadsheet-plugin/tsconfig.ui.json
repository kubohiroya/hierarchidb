{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "react",
      "react/jsx-runtime",
      "react-dom",
      "react-i18next",
      "vite/client"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/steps/**/*.ts",
    "src/steps/**/*.tsx",
    "src/ui/steps-provider.tsx",
    "src/extension/constants.ts",
    "src/extension/types.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/services/**/*",
    "src/database/**/*",
    "src/worker*",
    "src/utils/**/*",
    "**/*.spec.*",
    "**/__tests__/**"
  ]
}
