{
  "name": "@hierarchidb/basemap-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "BaseMap Plugin for HierarchiDB - Geographic base layer configuration and management",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./database": {
      "types": "./dist/database/index.d.ts",
      "import": "./dist/database/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:bundle",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup --watch",
    "test": "vitest",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "build:tsc": "pnpm run build:types",
    "dev:tsc": "tsc --watch",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundle": "NODE_OPTIONS=\"--loader ts-node/esm\" tsup",
    "prebuild:bundle": "pnpm run build:types"
  },
  "dependencies": {},
  "peerDependencies": {
    "dexie": "^4.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": ">=18.0.0",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/plugin-runtime-entities": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "devDependencies": {
    "dexie": "^4.2.0",
    "@testing-library/react": "^14.3.1",
    "fake-indexeddb": "^4.0.2",
    "jsdom": "^22.1.0",
    "react": ">=18.0.0",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "vitest": "^3.2.4",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/plugin-runtime-entities": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/util": "workspace:*"
  },
  "keywords": [
    "hierarchidb",
    "plugin",
    "basemap",
    "mapping",
    "gis",
    "geographic"
  ],
  "author": "HierarchiDB Team",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "basemap",
      "name": "BaseMap Plugin",
      "icon": {
        "mui": "Public",
        "emoji": "🌍",
        "color": "#b0b3d9"
      },
      "priority": 900,
      "category": "geographic",
      "extends": "folder",
      "dependencies": [
        "folder"
      ],
      "capabilities": {
        "canHaveChildren": true,
        "canBeRoot": false,
        "canBeDeleted": true,
        "canBeRenamed": true,
        "canBeMoved": true,
        "canBeCopied": true
      },
      "schema": {
        "inherits": "folder",
        "fields": [
          {
            "name": "mapStyle",
            "type": "object",
            "required": true
          },
          {
            "name": "viewport",
            "type": "object",
            "required": true
          },
          {
            "name": "displayOptions",
            "type": "object",
            "required": false
          }
        ]
      }
    }
  },
  "tsup": {
    "external": [
      "@emotion/react",
      "@emotion/styled",
      "@mui/icons-material",
      "@mui/material",
      "dexie",
      "react"
    ]
  }
}
