{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true,
    "paths": {
      "@hierarchidb/common-types": [
        "../../packages/common/types/dist/index.d.ts"
      ],
      "@hierarchidb/common-types/*": [
        "../../packages/common/types/dist/*"
      ],
      "@hierarchidb/common-api": [
        "../../packages/common/api/dist/index.d.ts"
      ],
      "@hierarchidb/common-api/*": [
        "../../packages/common/api/dist/*"
      ],
      "@hierarchidb/plugin-api": [
        "../../packages/plugin-api/dist/index.d.ts"
      ],
      "@hierarchidb/plugin-api/*": [
        "../../packages/plugin-api/dist/*"
      ],
      "@hierarchidb/runtime-plugin-dialog": [
        "../../packages/runtime/plugin-dialog/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-plugin-dialog/*": [
        "../../packages/runtime/plugin-dialog/dist/*"
      ],
      "@hierarchidb/runtime-basic-info": [
        "../../packages/runtime/basic-info/dist/index.d.ts"
      ],
      "@hierarchidb/runtime-basic-info/*": [
        "../../packages/runtime/basic-info/dist/*"
      ],
      "@hierarchidb/batch-sdk": [
        "../../packages/batch-sdk/dist/index.d.ts"
      ],
      "@hierarchidb/batch-sdk/*": [
        "../../packages/batch-sdk/dist/*"
      ],
      "@hierarchidb/download": [
        "../../packages/feature/download/dist/index.d.ts"
      ],
      "@hierarchidb/download/*": [
        "../../packages/feature/download/dist/*"
      ],
      "@hierarchidb/components": [
        "../../packages/components/dist/index.d.ts"
      ],
      "@hierarchidb/components/*": [
        "../../packages/components/dist/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../packages/ui/datasource/tsconfig.build.json"
    },
    {
      "path": "../../packages/ui/license/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/worker/tsconfig.build.json"
    }
  ]
}
