{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "declarationDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "src/tests/**",
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.stories.*",
    "src/examples/**",
    "src/worker*.test.ts",
    "**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../../packages/ui/datasource/tsconfig.build.json"
    },
    {
      "path": "../../packages/ui/license/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/worker/tsconfig.build.json"
    },
    {
      "path": "../../packages/common/types/tsconfig.build.json"
    },
    {
      "path": "../../packages/common/api/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/plugin-dialog/tsconfig.build.json"
    },
    {
      "path": "../../packages/runtime/basic-info/tsconfig.build.json"
    },
    {
      "path": "../../packages/feature/batch/tsconfig.build.json"
    },
    {
      "path": "../../packages/feature/download/tsconfig.build.json"
    },
    {
      "path": "../../packages/components/tsconfig.build.json"
    }
  ]
}
