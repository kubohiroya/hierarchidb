{
  "name": "@hierarchidb/location-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/services/index.ts src/ui/index.ts src/worker/index.ts src/worker/factory/index.ts src/worker/locationEntitiesDB.ts src/worker/locationPeerStore.dexie.ts src/worker/locationGroupStore.dexie.ts src/worker/locationRelationStore.dexie.ts src/locationEntitiesDB.ts src/icon/index.ts --config ../../tsdown.config.ts",
    "test": "vitest",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.2.45",
    "typescript": "workspace:^5.9.3",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-service-sdk": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*"
  },
  "peerDependencies": {
    "dexie": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.2",
    "@mui/icons-material": "^7.3.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/plugin-service-api": "workspace:*",
    "@hierarchidb/plugin-service-sdk": "workspace:*",
    "@hierarchidb/batch": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/ui-data-grid": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-plugin-dialog": "workspace:*",
    "@hierarchidb/auth-recovery": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "location",
      "name": "Location Plugin",
      "displayName": "Location",
      "description": "Geographic location nodes with Shape integration",
      "icon": {
        "mui": "LocationOn",
        "emoji": "\ud83d\udccd",
        "color": "#a3b030",
        "component": {
          "specifier": "@hierarchidb/location-plugin/icon",
          "exportName": "LocationPluginIcon"
        }
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 40
      },
      "priority": 40,
      "creatable": true,
      "tags": [
        "geographic",
        "location"
      ],
      "capabilities": [
        "workingCopy",
        "batch",
        "visualization"
      ]
    }
  }
}
