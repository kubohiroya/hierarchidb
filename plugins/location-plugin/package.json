{
  "name": "@hierarchidb/location-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./icon": {
      "types": "./dist/icon/index.d.ts",
      "import": "./dist/icon/index.js",
      "default": "./dist/icon/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "ui": [
        "dist/ui/index.d.ts"
      ],
      "icon": [
        "dist/icon/index.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ],
      "worker": [
        "dist/worker/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:dts",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "test": "vitest",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "clean:force": "NODE_OPTIONS=\"--loader ts-node/esm\" rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:js": "tsdown src/index.ts src/services/index.ts src/ui/index.ts src/worker/index.ts src/worker/factory/index.ts src/worker/locationEntitiesDB.ts src/worker/locationGroupStore.dexie.ts src/worker/locationRelationStore.dexie.ts src/locationEntitiesDB.ts src/icon/index.ts --config ../../tsdown.config.ts --outDir dist",
    "build:dts": "rollup -c rollup.dts.config.mjs"
  },
  "dependencies": {
    "@hierarchidb/gen-iso3166-2": "workspace:*",
    "@hierarchidb/location-api": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/worker-api": "workspace:*",
    "@hierarchidb/ui-country-select": "workspace:*",
    "@hierarchidb/ui-tabular": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tabular-source": "workspace:*"
  },
  "devDependencies": {
    "@hierarchidb/auth": "workspace:*",
    "@hierarchidb/batch-api": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/gis-sdk": "workspace:*",
    "@hierarchidb/location-api": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-batch-progress": "workspace:*",
    "@hierarchidb/ui-floating-window": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-json-treeview": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-search-input": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^19.1.1",
    "react-virtuoso": "^4.14.0",
    "typescript": "workspace:^5.9.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/auth": "workspace:*",
    "@hierarchidb/batch-api": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/core-types": "workspace:*",
    "@hierarchidb/download": "workspace:*",
    "@hierarchidb/gis-sdk": "workspace:*",
    "@hierarchidb/location-api": "workspace:*",
    "@hierarchidb/location-store": "workspace:*",
    "@hierarchidb/plugin-base": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/tabular-store": "workspace:*",
    "@hierarchidb/tree-api": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-batch-progress": "workspace:*",
    "@hierarchidb/ui-datasource": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-floating-window": "workspace:*",
    "@hierarchidb/ui-grid": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-json-treeview": "workspace:*",
    "@hierarchidb/ui-license": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-memory": "workspace:*",
    "@hierarchidb/ui-plugin-basic-info": "workspace:*",
    "@hierarchidb/ui-search-input": "workspace:*",
    "@hierarchidb/ui-worker-client": "workspace:*",
    "@hierarchidb/ui-worker-provider": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "dexie": "^4.2.0",
    "notistack": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.14.0"
  },
  "hierarchidb": {
    "plugin": {
      "nodeType": "location",
      "name": "Location Plugin",
      "displayName": "Location",
      "description": "Import locations of geo-resources from online data sources, analyze them, and present the results in coordinated map views.",
      "i18nNamespace": "location-plugin",
      "stepTitleKeys": {
        "1": "basicInfo",
        "2": "dataSource",
        "3": "selection",
        "4": "mapPreview"
      },
      "icon": {
        "mui": "LocationOn",
        "emoji": "📍",
        "color": "#a3b030",
        "component": {
          "specifier": "@hierarchidb/location-plugin/icon",
          "exportName": "LocationPluginIcon"
        }
      },
      "category": {
        "treeId": "*",
        "menuGroup": "document",
        "createOrder": 40
      },
      "priority": 40,
      "creatable": true,
      "tags": [
        "geographic",
        "location"
      ],
      "capabilities": [
        "draft",
        "batch",
        "visualization"
      ]
    }
  },
  "tsdown": {
    "dts": false
  }
}
