{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hierarchidb.dev/schemas/hierarchidb.plugin.schema.json",
  "title": "HierarchiDB Plugin Meta",
  "type": "object",
  "properties": {
    "nodeType": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "displayName": { "type": "string" },
    "description": { "type": "string" },
    "icon": {
      "type": "object",
      "properties": {
        "mui": { "type": "string" },
        "emoji": { "type": "string" },
        "color": { "type": "string" }
      },
      "additionalProperties": true
    },
    "category": {
      "type": "object",
      "properties": {
        "treeId": { "enum": ["resources", "projects", "*"] },
        "menuGroup": { "enum": ["basic", "container", "document", "advanced"] },
        "createOrder": { "type": "number" }
      },
      "additionalProperties": true
    },
    "priority": { "type": "number" },
    "creatable": { "type": "boolean" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["nodeType"],
  "additionalProperties": true
}

