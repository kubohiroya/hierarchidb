{
  "name": "@hierarchidb/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen-plugin-loaders": "pnpm run build && node dist/gen-plugin-loaders.js",
    "prepare-gh-pages-build": "pnpm run build && mkdir -p ../app/dist && node dist/prepare-gh-pages-build.js"
  },
  "dependencies": {
    "vite": "workspace:^6.3.5"
  },
  "devDependencies": {
    "typescript": "workspace:^5.9.3",
    "@types/node": "workspace:^18.19.123"
  },
  "turbo": {
    "pipeline": {
      "gen-plugin-loaders": {
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "outputs": [
          "../app/src/generated/**",
          "../packages/plugin-registry/src/generated/**"
        ]
      }
    }
  }
}
