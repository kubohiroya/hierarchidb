{
  "name": "hierarchidb",
  "private": true,
  "version": "2.0.0",
  "description": "High-performance tree-structured data management framework for browsers",
  "type": "module",
  "scripts": {
    "check:deps": "pnpm exec dep-fence --strict",
    "guard:deps:extra": "node scripts/run-dependency-guard.mjs",
    "fix:tsconfig": "node scripts/normalize-tsconfig.mjs",
    "check:deps:pkg": "pnpm exec dep-fence",
    "arch:dc": "npx dependency-cruiser -c .dependency-cruiser.cjs packages app",
    "deps:list": "npx syncpack list-mismatches",
    "deps:fix": "npx syncpack fix-mismatches && npx syncpack format",
    "deps:prune:report": "node scripts/report-dep-prune.mjs",
    "pkg:publint": "pnpm -r --filter \"...[[private=false]]\" exec npx publint .",
    "pkg:attw": "pnpm -r --filter \"...[[private=false]]\" exec npx attw .",
    "guards:pre-commit": "tsx scripts/dep-fence-guards.run.ts --mode pre-commit --config .mrtask/dep-fence.guards.ts",
    "guards:pre-push": "tsx scripts/dep-fence-guards.run.ts --mode pre-push --config .mrtask/dep-fence.guards.ts",
    "check:deps:policies": "pnpm exec dep-fence",
    "preinstall": "npx only-allow pnpm",
    "generate-gadm-metadata": "node scripts/data-generation/generate-metadata.mjs gadm",
    "generate-geoboundaries-metadata": "node scripts/data-generation/generate-metadata.mjs geoboundaries",
    "generate-naturalearth-metadata": "node scripts/data-generation/generate-metadata.mjs naturalearth",
    "generate-openstreetmap-metadata": "node scripts/data-generation/generate-metadata.mjs osm",
    "generate-metadata-index": "tsx scripts/data-generation/generate-metadata-index.ts",
    "generate-gadm-iso-mapping": "tsx scripts/data-generation/generate-gadm-iso-mapping.ts",
    "metadata:ensure": "pnpm run generate-gadm-metadata && pnpm run generate-geoboundaries-metadata && pnpm run generate-naturalearth-metadata && pnpm run generate-openstreetmap-metadata",
    "check:licenses:json": "npx license-checker --production --json ",
    "build:turbo": "turbo run build",
    "build:plugins": "turbo run build --filter @hierarchidb/basemap-plugin --filter @hierarchidb/folder-plugin --filter @hierarchidb/linker-plugin --filter @hierarchidb/location-plugin --filter @hierarchidb/resolver-plugin --filter @hierarchidb/route-plugin --filter @hierarchidb/shape-plugin --filter @hierarchidb/spreadsheet-plugin --filter @hierarchidb/styler-plugin --filter @hierarchidb/timeline-plugin",
    "build:watch": "turbo run build --watch",
    "turbo:watch": "pnpm run turbo:watch:internal",
    "turbo:watch:internal": "turbo run build --filter @hierarchidb/app^... --watch",
    "preview": "turbo run preview --filter @hierarchidb/app",
    "typecheck": "turbo run typecheck",
    "typecheck:ci": "CI=true NODE_OPTIONS=\"--max-old-space-size=4096\" turbo run typecheck",
    "typecheck:watch": "turbo run typecheck --watch",
    "test": "turbo run test --parallel",
    "test:run": "turbo run test:run",
    "coverage": "turbo run coverage --parallel",
    "ci:unit": "pnpm -r --filter @hierarchidb/ui-treeconsole-base --filter @hierarchidb/ui-treeconsole-treetable exec vitest run --passWithNoTests",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "biome:check": "biome check --reporter summary",
    "biome:fix": "biome check --write",
    "biome:check:core": "biome check --reporter summary packages/runtime/worker packages/plugins/shape-plugin",
    "eslint:deprecations": "eslint -f stylish --max-warnings=0 packages/runtime/worker packages/plugins/shape-plugin",
    "format": "turbo run format",
    "clean": "turbo run clean",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "check:licenses": "npx license-checker --production --summary",
    "analyze:licenses": "pnpm --filter @hierarchidb/analyze-licenses run build && pnpm --filter @hierarchidb/analyze-licenses exec node dist/cli.js",
    "as-any:report": "node scripts/report-as-any.mjs",
    "as-any:check": "node scripts/report-as-any.mjs --max=975",
    "shims:check": "node scripts/check-shims.mjs",
    "sync:package-scripts": "node scripts/sync-package-scripts.mjs",
    "generate:pdf": "node scripts/generate-pdf-with-translation.js",
    "generate:pdf:ja": "node scripts/generate-pdf-with-translation.js --japanese",
    "generate:pdf:en": "node scripts/generate-pdf-with-translation.js --english",
    "tools:build": "pnpm --filter @hierarchidb/tools run build",
    "tools:gen-plugin-registry": "pnpm --filter @hierarchidb/vite-plugin-hierarchidb-plugin-alias run build && pnpm --filter @hierarchidb/tools-load-plugin-manifest run build && pnpm --filter @hierarchidb/tools-build-scripts run gen-plugin-registry",
    "tools:sync-peer-dependencies": "pnpm --filter @hierarchidb/tools-build-scripts run sync-peer-dependencies",
    "tools:fix-spa-build": "pnpm --filter @hierarchidb/tools-build-scripts run fix-spa-build",
    "count:lines": "tsx scripts/count-lines.ts",
    "policy:ban-tsconfig-paths-dist-dts": "node scripts/policy/ban-tsconfig-paths-dist-dts.mjs",
    "policy:all": "pnpm policy:ban-tsconfig-paths-dist-dts",
    "wt:start": "bash scripts/run-wt.sh start",
    "wt:remove": "bash scripts/run-wt.sh remove",
    "wt:list": "bash scripts/run-wt.sh list",
    "wt:open": "bash scripts/run-wt.sh open",
    "wt:auto": "node scripts/start-wt.mjs",
    "wt:finish": "node scripts/finish-wt.mjs",
    "ci:versions": "git rev-parse HEAD && node -v && pnpm -v && npx tsc -v || true",
    "ci:clean": "pnpm store prune || true && find . -name dist -type d -prune -exec rm -rf {} + || true && find . -name '*.tsbuildinfo' -type f -delete || true",
    "ci:install": "pnpm install --no-frozen-lockfile --force",
    "ci:typecheck:local": "CI=true NODE_OPTIONS=\"--max-old-space-size=6144\" pnpm -r --workspace-concurrency 1 typecheck",
    "ci:build:local": "CI=true NODE_OPTIONS=\"--max-old-space-size=6144\" pnpm -r --workspace-concurrency 1 build",
    "ci:all:local": "pnpm ci:clean && pnpm ci:install && pnpm ci:versions && pnpm ci:typecheck:local",
    "ci:unit:treeconsole": "pnpm -r --filter @hierarchidb/ui-treeconsole-base --filter @hierarchidb/ui-treeconsole-treetable run test:run",
    "deps:cycles": "npx dependency-cruiser -c .dependency-cruiser.cjs packages app",
    "deps:cycles:graph": "npx dependency-cruiser -c .dependency-cruiser.cjs --output-type dot --output-to reports/dependency-graph.dot packages app",
    "codemod:esm-ext": "pnpm --filter @hierarchidb/tools-codemods run codemod:esm-ext",
    "codemod:run": "node --loader ts-node/esm scripts/codemods/runner.ts",
    "dev": "pnpm run dev:pre && pnpm run dev:start",
    "dev:production": "pnpm run dev:pre && pnpm run dev:start:production",
    "dev:pre": "pnpm run metadata:ensure && pnpm run guard:deps:extra && pnpm run dev:dep-fence-if-enabled && pnpm run dev:ensure-plugin-alias",
    "dev:dep-fence-if-enabled": "bash -lc 'if [ \"${HDB_DEV_RUN_STRICT_DEPFENCE:-0}\" = \"1\" ]; then pnpm run check:deps; else echo \"[dev:dep-fence] skip strict checks\"; fi'",
    "dev:ensure-plugin-alias": "bash -lc 'if [ ! -f packages/vite-plugins/vite-plugin-hierarchidb-plugin-alias/dist/index.js ]; then pnpm --filter @hierarchidb/vite-plugin-hierarchidb-plugin-alias build; fi'",
    "dev:start": "bash -lc 'set -a; source scripts/env/development.sh; if [ -f app/.env.secrets ]; then source app/.env.secrets; fi; set +a; pnpm --filter @hierarchidb/app dev'",
    "dev:start:production": "bash -lc 'set -a; source scripts/env/production.sh; if [ -f app/.env.secrets ]; then source app/.env.secrets; fi; set +a; pnpm --filter @hierarchidb/app dev'",
    "dev:with-watch": "node ./scripts/run-dev-with-turbo-watch.mjs",
    "build": "pnpm run build:pre && pnpm run build:start",
    "build:pre": "pnpm run metadata:ensure && pnpm -C app run generate:favicon && pnpm run check:deps && pnpm run guard:deps:extra && npm run check:licenses && pnpm policy:ban-tsconfig-paths-dist-dts && pnpm shims:check && pnpm as-any:check && pnpm lint",
    "build:start": "bash -lc 'set -a; source scripts/env/production.sh; if [ -f app/.env.secrets ]; then source app/.env.secrets; fi; set +a; pnpm build:turbo'",
    "preview:init": "pnpm run preview:build && pnpm run preview:start",
    "preview:build": "bash -lc 'set -a; source scripts/env/production.sh; if [ -f app/.env.secrets ]; then source app/.env.secrets; fi; set +a; turbo run build --filter @hierarchidb/app'",
    "deploy": "pnpm -F @hierarchidb/app run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@eslint/js": "^9.39.1",
    "@mui/material": "^7.3.5",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-links": "9.1.3",
    "@storybook/blocks": "9.0.0-alpha.17",
    "@storybook/react": "9.1.3",
    "@storybook/react-vite": "9.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/license-checker": "^25.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "18.19.123",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-resizable": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.17.1",
    "change-case": "^5.4.4",
    "comlink": "^4.4.2",
    "dep-fence": "^0.5.1",
    "dependency-cruiser": "^14.1.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "glob": "^11.0.3",
    "globals": "^15.15.0",
    "globby": "^14.1.0",
    "happy-dom": "^16.8.1",
    "http-server": "^14.1.1",
    "i18next": "22.5.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^26.1.0",
    "knip": "^5.68.0",
    "license-checker": "^25.0.1",
    "minimist": "^1.2.8",
    "mrtask": "^0.7.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-i18next": "12.3.1",
    "react-resizable": "^3.0.5",
    "searoute-js": "^0.1.0",
    "storybook": "9.1.3",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsdown": "^0.14.2",
    "tsx": "^4.20.6",
    "turbo": "^2.6.0",
    "typescript": "5.9.3",
    "vite": "5.4.19",
    "vite-plugin-checker": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "@biomejs/biome": "2.2.0",
      "ast-types": "0.16.1",
      "dexie": "4.2.0",
      "@mui/system": "^7.3.2",
      "@mui/material": "^7.3.2",
      "@emotion/react": "11.14.0",
      "@emotion/styled": "11.14.0",
      "vite": "5.4.19",
      "@vitejs/plugin-react": "4.3.4",
      "vite@*": "5.4.19",
      "@types/react": "^18.3.24",
      "@types/react-dom": "^18.3.7",
      "react-is": "^18.3.1",
      "@types/node": "18.19.123",
      "typescript": "5.9.3",
      "type-fest": "0.21.3",
      "type-fest@*": "0.21.3",
      "i18next": "22.5.0",
      "react-i18next": "12.3.1",
      "@mui/icons-material": "^7.3.2",
      "rollup": "4.50.1"
    },
    "ignoredBuiltDependencies": [
      "@vaadin/vaadin-usage-statistics",
      "esbuild",
      "oxc-resolver",
      "sharp",
      "workerd"
    ],
    "patchedDependencies": {}
  },
  "keywords": [
    "hierarchical-data",
    "tree-structure",
    "indexeddb",
    "browser-database",
    "web-worker",
    "typescript",
    "react"
  ],
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "peerDependencies": {
    "@mui/material": "^7.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.5",
    "dexie": "4.2.0",
    "gh-pages": "^6.3.0"
  }
}
