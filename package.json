{
  "name": "hierarchidb",
  "private": true,
  "version": "2.0.0",
  "description": "High-performance tree-structured data management framework for browsers",
  "type": "module",
  "scripts": {
    "check:deps": "node scripts/check-deps.mjs",
    "check:deps:pkg": "pnpm --filter @hierarchidb/check-deps build && node packages/tools/check-deps/dist/cli.js",
    "arch:dc": "npx dependency-cruiser -c .dependency-cruiser.cjs packages app",
    "deps:list": "npx syncpack list-mismatches",
    "deps:fix": "npx syncpack fix-mismatches && npx syncpack format",
    "pkg:publint": "pnpm -r --filter \"...[[private=false]]\" exec npx publint .",
    "pkg:attw": "pnpm -r --filter \"...[[private=false]]\" exec npx attw .",
    "check:deps:policies": "tsx tools/check-deps/src/index.ts",
    "preinstall": "npx only-allow pnpm",
    "dev": "./scripts/start-env.sh development",
    "dev:production": "./scripts/start-env.sh production dev",
    "generate-gadm-metadata": "tsx scripts/data-generation/generate-gadm-metadata.ts",
    "generate-naturalearth-metadata": "tsx scripts/data-generation/generate-naturalearth-metadata.ts",
    "generate-openstreetmap-metadata": "tsx scripts/data-generation/generate-openstreetmap-metadata.ts",
    "generate-metadata-index": "tsx scripts/data-generation/generate-metadata-index.ts",
    "generate-gadm-iso-mapping": "tsx scripts/data-generation/generate-gadm-iso-mapping.ts",
    "prebuild": "npm run analyze:licenses",
    "build": "./scripts/start-env.sh production build",
    "build:turbo": "turbo run build",
    "build:watch": "turbo run build --parallel -- --watch",
    "build:app": "turbo run build --filter=@hierarchidb/app",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck --parallel -- --watch",
    "test": "turbo run test --parallel",
    "test:run": "turbo run test:run",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "clean": "npx turbo run clean",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "storybook:ui-core": "pnpm --filter @hierarchidb/ui-core storybook",
    "check:licenses": "npx license-checker --production --summary",
    "analyze:licenses": "tsx scripts/analyze-licenses.ts",
    "analyze:docs": "node scripts/analyze-docs.js",
    "generate:pdf": "node scripts/generate-pdf-with-translation.js",
    "generate:pdf:ja": "node scripts/generate-pdf-with-translation.js --japanese",
    "generate:pdf:en": "node scripts/generate-pdf-with-translation.js --english",
    "docs:serve": "npx http-server docs/pdf -p 8080",
    "validate:exports": "node scripts/validate-package-exports.cjs",
    "fix:exports": "node scripts/fix-all-package-exports.cjs",
    "count:lines": "tsx scripts/count-lines.ts",
    "analyze:ui": "node scripts/analyze-ui-duplication.js",
    "check:sabotage": "tsx scripts/check-sabotage.ts",
    "vibe-kanban": "npx vibe-kanban",
    "vk:task": "node scripts/vk-task.mjs",
    "vk:task:commit-grouping": "node scripts/vk-task.mjs --preset grouped-commits",
    "vk:sync": "node scripts/vk-sync.mjs",
    "vk:sync:worker": "node scripts/vk-sync.mjs --dir packages/runtime-worker/worker/docs"
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^9.34.0",
    "@mui/material": "^7.3.1",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-links": "9.1.3",
    "@storybook/blocks": "9.0.0-alpha.17",
    "@storybook/react": "9.1.3",
    "@storybook/react-vite": "9.1.3",
    "@storybook/testing-library": "0.2.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^18.19.123",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "change-case": "^5.4.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.2",
    "glob": "^11.0.3",
    "globals": "^15.15.0",
    "globby": "^14.1.0",
    "happy-dom": "^16.8.1",
    "http-server": "^14.1.1",
    "jscodeshift": "^17.3.0",
    "license-checker": "^25.0.1",
    "minimist": "^1.2.8",
    "prettier": "^3.6.2",
    "storybook": "9.1.3",
    "ts-morph": "^26.0.0",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "4.9.5",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "vite": "5.4.19",
      "@vitejs/plugin-react": "4.3.4",
      "vite@*": "5.4.19",
      "@types/react": "^18.3.24",
      "@types/react-dom": "^18.3.7",
      "react-is": "^18.3.1",
      "@types/node": "18.19.123",
      "typescript": "4.9.5"
    }
  },
  "keywords": [
    "hierarchical-data",
    "tree-structure",
    "indexeddb",
    "browser-database",
    "web-worker",
    "typescript",
    "react"
  ],
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.1"
  },
  "tsup": {
    "external": [
      "@mui/material",
      "react",
      "react-dom"
    ]
  }
}
