{
  "name": "hierarchidb",
  "private": true,
  "version": "2.0.0",
  "description": "High-performance tree-structured data management framework for browsers",
  "type": "module",
  "scripts": {
    "check:deps": "pnpm exec dep-fence --strict",
    "check:deps:extra": "node scripts/dep-fence-extra.mjs",
    "fix:tsconfig": "node scripts/tsconfig-normalize.mjs",
    "check:deps:pkg": "pnpm exec dep-fence",
    "arch:dc": "npx dependency-cruiser -c .dependency-cruiser.cjs packages app",
    "deps:list": "npx syncpack list-mismatches",
    "deps:fix": "npx syncpack fix-mismatches && npx syncpack format",
    "deps:prune:report": "node scripts/dep-prune-report.mjs",
    "pkg:publint": "pnpm -r --filter \"...[[private=false]]\" exec npx publint .",
    "pkg:attw": "pnpm -r --filter \"...[[private=false]]\" exec npx attw .",
    "guards:pre-commit": "tsx scripts/dep-fence-guards.run.ts --mode pre-commit --config .mrtask/dep-fence.guards.ts",
    "guards:pre-push": "tsx scripts/dep-fence-guards.run.ts --mode pre-push --config .mrtask/dep-fence.guards.ts",
    "check:deps:policies": "pnpm exec dep-fence",
    "preinstall": "npx only-allow pnpm",
    "predev": "pnpm types:virtual:generate",
    "dev": "./scripts/start-env.sh development",
    "dev:with-watch": "node ./scripts/run-dev-with-turbo-watch.mjs",
    "dev:diagnose": "node tools/dev-diagnose-runner.mjs",
    "predev:production": "pnpm types:virtual:generate",
    "dev:production": "./scripts/start-env.sh production dev",
    "dexie": "4.2.0",
    "generate-gadm-metadata": "tsx scripts/data-generation/generate-gadm-metadata.ts",
    "generate-naturalearth-metadata": "tsx scripts/data-generation/generate-naturalearth-metadata.ts",
    "generate-openstreetmap-metadata": "tsx scripts/data-generation/generate-openstreetmap-metadata.ts",
    "generate-metadata-index": "tsx scripts/data-generation/generate-metadata-index.ts",
    "generate-gadm-iso-mapping": "tsx scripts/data-generation/generate-gadm-iso-mapping.ts",
    "prebuild": "pnpm -C app run generate:favicon && pnpm types:virtual:generate && pnpm run check:deps && pnpm run check:deps:extra && npm run analyze:licenses && pnpm policy:ban-tsconfig-paths-dist-dts && pnpm shims:check && pnpm as-any:check && pnpm lint",
    "build": "./scripts/start-env.sh production build",
    "build:turbo": "turbo run build",
    "build:watch": "turbo run build --parallel -- --watch",
    "turbo:watch": "pnpm run turbo:watch:internal",
    "turbo:watch:internal": "turbo run build --filter @hierarchidb/app^... --watch",
    "build:app": "turbo run build --filter=@hierarchidb/app",
    "prebuild:app": "pnpm types:virtual:generate",
    "preview": "turbo run preview",
    "prepreview": "pnpm types:virtual:generate",
    "pretypecheck": "pnpm run dts:quick",
    "typecheck": "turbo run typecheck",
    "typecheck:graph": "tsc -b tsconfig.build.json",
    "pretypecheck:graph": "pnpm run dts:quick",
    "typecheck:graph:watch": "tsc -b -w tsconfig.build.json",
    "pretypecheck:ci": "pnpm run dts:quick",
    "typecheck:ci": "CI=true NODE_OPTIONS=\"--max-old-space-size=4096\" pnpm -r --workspace-concurrency 1 --reporter append-only typecheck",
    "pretypecheck:watch": "pnpm run dts:quick",
    "typecheck:watch": "turbo run typecheck --parallel -- --watch",
    "test": "turbo run test --parallel",
    "test:run": "turbo run test:run",
    "coverage": "turbo run coverage --parallel",
    "ci:unit": "pnpm -r --filter @hierarchidb/ui-treeconsole-base --filter @hierarchidb/ui-treeconsole-treetable exec vitest run --passWithNoTests",
    "e2e": "turbo run e2e",
    "wfl": "turbo run wfl",
    "lint": "turbo run lint",
    "biome:check": "biome check --reporter summary",
    "biome:fix": "biome check --write",
    "biome:check:core": "biome check --reporter summary packages/runtime/worker packages/plugins/shape-plugin",
    "eslint:deprecations": "eslint -f stylish --max-warnings=0 packages/runtime/worker packages/plugins/shape-plugin",
    "format": "turbo run format",
    "clean": "npx turbo run clean",
    "storybook": "storybook dev -p 6006",
    "prestorybook": "pnpm types:virtual:generate",
    "build:storybook": "storybook build",
    "prebuild:storybook": "pnpm types:virtual:generate",
    "storybook:ui-core": "pnpm --filter @hierarchidb/ui-core storybook",
    "prestorybook:ui-core": "pnpm types:virtual:generate",
    "check:licenses": "npx license-checker --production --summary",
    "analyze:licenses": "pnpm --filter @hierarchidb/analyze-licenses run build && pnpm --filter @hierarchidb/analyze-licenses exec node dist/cli.mjs",
    "analyze:docs": "node scripts/analyze-docs.js",
    "as-any:report": "node scripts/report-as-any.mjs",
    "as-any:check": "node scripts/report-as-any.mjs --max=975",
    "shims:check": "node scripts/check-shims.mjs",
    "generate:pdf": "node scripts/generate-pdf-with-translation.js",
    "generate:pdf:ja": "node scripts/generate-pdf-with-translation.js --japanese",
    "generate:pdf:en": "node scripts/generate-pdf-with-translation.js --english",
    "docs:serve": "npx http-server docs/pdf -p 8080",
    "validate:exports": "node scripts/validate-package-exports.cjs",
    "types:virtual:generate": "node scripts/generate-virtual-dts.mjs",
    "fix:exports": "node scripts/fix-all-package-exports.cjs",
    "dts:quick": "pnpm -r --workspace-concurrency 1 --filter @hierarchidb/common-type --filter @hierarchidb/common-api --filter @hierarchidb/plugins-base-plugin --filter @hierarchidb/util --filter @hierarchidb/common-auth --filter @hierarchidb/auth-recovery --filter @hierarchidb/batch --filter @hierarchidb/compute --filter @hierarchidb/download --filter @hierarchidb/feature-registry --filter @hierarchidb/import-export --filter @hierarchidb/map-source --filter @hierarchidb/map-adapter --filter @hierarchidb/route-resolver --filter @hierarchidb/route-searoute --filter @hierarchidb/table-metadata --filter @hierarchidb/tabular --filter @hierarchidb/tabular-store --filter @hierarchidb/tabular-xlsx --filter @hierarchidb/tag --filter @hierarchidb/runtime-shared-batch-processor --filter @hierarchidb/runtime-shared-fetch-metadata --filter @hierarchidb/runtime-worker-bootstrap --filter @hierarchidb/runtime-worker --filter @hierarchidb/ui-icon --filter @hierarchidb/ui-data-grid --filter @hierarchidb/ui-core --filter @hierarchidb/plugins-location-plugin --filter @hierarchidb/plugins-route-plugin --filter @hierarchidb/plugins-timeline-plugin --filter @hierarchidb/runtime-ui-plugin-dialog --filter @hierarchidb/analyze-licenses --filter @hierarchidb/tools-vite-plugin-package-reader build",
    "count:lines": "tsx scripts/count-lines.ts",
    "analyze:ui": "node scripts/analyze-ui-duplication.js",
    "policy:ban-tsconfig-paths-dist-dts": "node scripts/policy/ban-tsconfig-paths-dist-dts.mjs",
    "policy:all": "pnpm policy:ban-tsconfig-paths-dist-dts",
    "check:sabotage": "tsx scripts/check-sabotage.ts",
    "vibe-kanban": "npx vibe-kanban",
    "vk:task": "node scripts/vk-task.mjs",
    "vk:task:commit-grouping": "node scripts/vk-task.mjs --preset grouped-commits",
    "vk:sync": "node scripts/vk-sync.mjs",
    "vk:sync:worker": "node scripts/vk-sync.mjs --dir packages/runtime/worker/docs",
    "treeconsole:shims:remove": "find packages/ui/treeconsole -type f -name comlink.d.ts -delete",
    "codemod:esm-ext": "node tools/esm-ext-codemod.mjs",
    "typecheck:esm": "tsc -b tsconfig.esm-node16.json",
    "wt:start": "bash scripts/wt.sh start",
    "wt:remove": "bash scripts/wt.sh remove",
    "wt:list": "bash scripts/wt.sh list",
    "wt:open": "bash scripts/wt.sh open",
    "wt:auto": "node scripts/wt-start.mjs",
    "wt:finish": "node scripts/wt-finish.mjs",
    "ci:versions": "git rev-parse HEAD && node -v && pnpm -v && npx tsc -v || true",
    "ci:clean": "pnpm store prune || true && find . -name dist -type d -prune -exec rm -rf {} + || true && find . -name '*.tsbuildinfo' -type f -delete || true",
    "ci:install": "pnpm install --no-frozen-lockfile --force",
    "ci:typecheck:local": "CI=true NODE_OPTIONS=\"--max-old-space-size=6144\" pnpm -r --workspace-concurrency 1 typecheck",
    "ci:build:local": "CI=true NODE_OPTIONS=\"--max-old-space-size=6144\" pnpm -r --workspace-concurrency 1 build",
    "ci:all:local": "pnpm ci:clean && pnpm ci:install && pnpm ci:versions && pnpm ci:typecheck:local",
    "ci:unit:treeconsole": "pnpm -r --filter @hierarchidb/ui-treeconsole-base --filter @hierarchidb/ui-treeconsole-treetable run test:run",
    "task:add": "npx mrtask add",
    "task:list": "npx mrtask list",
    "task:pr": "npx mrtask pr",
    "task:done": "npx mrtask done",
    "task:cancel": "npx mrtask cancel",
    "deps:cycles": "npx dependency-cruiser -c .dependency-cruiser.cjs packages app",
    "deps:cycles:graph": "npx dependency-cruiser -c .dependency-cruiser.cjs --output-type dot --output-to reports/dependency-graph.dot packages app",
    "codemod:run": "node --loader ts-node/esm scripts/codemods/runner.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.34.0",
    "@hierarchidb/common-type": "workspace:*",
    "@mui/material": "^7.3.2",
    "@playwright/test": "^1.55.0",
    "@storybook/addon-essentials": "9.0.0-alpha.12",
    "@storybook/addon-interactions": "9.0.0-alpha.10",
    "@storybook/addon-links": "9.1.3",
    "@storybook/blocks": "9.0.0-alpha.17",
    "@storybook/react": "9.1.3",
    "@storybook/react-vite": "9.1.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/minimist": "^1.2.5",
    "@types/node": "^18.19.123",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-resizable": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.13.0",
    "change-case": "^5.4.4",
    "dep-fence": "^0.5.1",
    "dependency-cruiser": "^14.1.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^2.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.2",
    "glob": "^11.0.3",
    "globals": "^15.15.0",
    "globby": "^14.1.0",
    "happy-dom": "^16.8.1",
    "http-server": "^14.1.1",
    "i18next": "22.5.0",
    "jscodeshift": "^17.3.0",
    "jsdom": "^26.1.0",
    "knip": "^5.63.1",
    "license-checker": "^25.0.1",
    "minimist": "^1.2.8",
    "mrtask": "^0.7.1",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-i18next": "12.3.1",
    "react-resizable": "^3.0.5",
    "searoute-js": "^0.1.0",
    "storybook": "9.1.3",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.8",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "overrides": {
      "@biomejs/biome": "2.2.0",
      "ast-types": "0.16.1",
      "dexie": "4.2.0",
      "@mui/system": "^7.3.2",
      "@mui/material": "^7.3.2",
      "@emotion/react": "11.14.0",
      "@emotion/styled": "11.14.0",
      "vite": "5.4.19",
      "@vitejs/plugin-react": "4.3.4",
      "vite@*": "5.4.19",
      "@types/react": "^18.3.24",
      "@types/react-dom": "^18.3.7",
      "react-is": "^18.3.1",
      "@types/node": "18.19.123",
      "typescript": "5.9.3",
      "type-fest": "0.21.3",
      "type-fest@*": "0.21.3",
      "i18next": "22.5.0",
      "react-i18next": "12.3.1",
      "@mui/icons-material": "^7.3.2"
    },
    "ignoredBuiltDependencies": [
      "@vaadin/vaadin-usage-statistics",
      "esbuild",
      "oxc-resolver",
      "sharp",
      "workerd"
    ],
    "patchedDependencies": {
      "ast-types@0.16.1": "patches/ast-types@0.16.1.patch"
    }
  },
  "keywords": [
    "hierarchical-data",
    "tree-structure",
    "indexeddb",
    "browser-database",
    "web-worker",
    "typescript",
    "react"
  ],
  "author": "HierarchiDB Contributors",
  "license": "MIT",
  "peerDependencies": {
    "@mui/material": "^7.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "tsup": {
    "external": [
      "@mui/material",
      "react",
      "react-dom"
    ]
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.2",
    "dexie": "^4.2.0",
    "gh-pages": "^6.3.0"
  }
}
