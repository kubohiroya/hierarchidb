{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "lib": [
      "ES2022",
      "dom"
    ],
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "paths": {
      "@hierarchidb/runtime-ui-appbar": [
        "packages/runtime-ui/appbar/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-appbar/*": [
        "packages/runtime-ui/appbar/src/*"
      ],
      "@hierarchidb/runtime-ui-datasource": [
        "packages/runtime-ui/datasource/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-datasource/*": [
        "packages/runtime-ui/datasource/src/*"
      ],
      "@hierarchidb/runtime-ui-landingpage": [
        "packages/runtime-ui/landingpage/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-landingpage/*": [
        "packages/runtime-ui/landingpage/src/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "packages/runtime-ui/plugin-dialog/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "packages/runtime-ui/plugin-dialog/src/*"
      ],
      "@hierarchidb/runtime-ui-search-result-window": [
        "packages/runtime-ui/search-result-window/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-search-result-window/*": [
        "packages/runtime-ui/search-result-window/src/*"
      ],
      "@hierarchidb/runtime-ui-tour": [
        "packages/runtime-ui/tour/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-tour/*": [
        "packages/runtime-ui/tour/src/*"
      ],
      "@hierarchidb/plugins-runtime-worker-factory": [
        "packages/plugins/runtime-worker-factory/dist/index.d.ts"
      ],
      "@hierarchidb/plugins-runtime-worker-factory/*": [
        "packages/plugins/runtime-worker-factory/dist/*"
      ],
      "@hierarchidb/tabular-store": [
        "packages/feature/tabular-store/src/index.ts"
      ],
      "@hierarchidb/tabular-store/*": [
        "packages/feature/tabular-store/src/*"
      ]
    },
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
