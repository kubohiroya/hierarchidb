{
  "compilerOptions": {
    "target": "es2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "dom"
    ],
    "moduleResolution": "node",
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@hierarchidb/util": ["./packages/util/dist/index.d.ts"],
      "@hierarchidb/ui-dialog": ["./packages/ui/dialog/dist/index.d.ts"],
      "@hierarchidb/base-plugin": ["./packages/node-type/base-plugin/dist/index.d.ts"],
      "@hierarchidb/folder-plugin": ["./packages/node-type/folder-plugin/dist/index.d.ts"],
      "@hierarchidb/runtime-ui-plugin-dialog": ["./packages/runtime-ui/plugin-dialog/dist/index.d.ts"],
      "@hierarchidb/runtime-shared-batch-processor": ["./packages/runtime-shared/batch-processor/dist/index.d.ts"],
      "@hierarchidb/runtime-worker": ["./packages/runtime-worker/worker/dist/index.d.ts"],
      "@hierarchidb/download": ["./packages/feature/download/dist/index.d.ts"],
      "@hierarchidb/auth-recovery": ["./packages/feature/auth-recovery/dist/index.d.ts"],
      "@hierarchidb/table-metadata": ["./packages/feature/table-metadata/dist/index.d.ts"],
      "@hierarchidb/ui-data-grid": ["./packages/ui/data-grid/dist/index.d.ts"],
      "@hierarchidb/tabular-store": ["./packages/feature/tabular-store/dist/index.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
