{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "lib": [
      "ES2022",
      "dom"
    ],
    "moduleResolution": "Node16",
    "baseUrl": ".",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@hierarchidb/runtime-shared-batch-processor": [
        "packages/runtime-shared/batch-processor/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-batch-processor/*": [
        "packages/runtime-shared/batch-processor/src/*"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata": [
        "packages/runtime-shared/fetch-metadata/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata/*": [
        "packages/runtime-shared/fetch-metadata/src/*"
      ],
      "@hierarchidb/common-type": [
        "packages/common/types/src/index.ts"
      ],
      "@hierarchidb/common-type/*": [
        "packages/common/types/src/*"
      ],
      "@hierarchidb/download": [
        "packages/feature/download/src/index.ts"
      ],
      "@hierarchidb/download/*": [
        "packages/feature/download/src/*"
      ],
      "@hierarchidb/runtime-worker": [
        "packages/runtime/worker-core/src/index.ts"
      ],
      "@hierarchidb/runtime-worker/*": [
        "packages/runtime/worker-core/src/*"
      ],
      "@hierarchidb/runtime-shared-module-paths": [
        "packages/runtime-shared/module-paths/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-module-paths/*": [
        "packages/runtime-shared/module-paths/src/*"
      ],
      "@hierarchidb/ui-file": [
        "packages/ui/file/src/index.ts"
      ],
      "@hierarchidb/ui-file/*": [
        "packages/ui/file/src/*"
      ],
      "@hierarchidb/util": [
        "packages/util/src/index.ts"
      ],
      "@hierarchidb/util/*": [
        "packages/util/src/*"
      ],
      "@hierarchidb/plugins-*-plugin/worker-factory": [
        "packages/plugins/*-plugin/src/worker-factory/index.ts"
      ],
      "@hierarchidb/plugins-spreadsheet-plugin": [
        "packages/plugins/spreadsheet-plugin/src/index.ts"
      ],
      "@hierarchidb/plugins-spreadsheet-plugin/*": [
        "packages/plugins/spreadsheet-plugin/src/*"
      ],
      "@hierarchidb/common-api": [
        "packages/common/api/src/index.ts"
      ],
      "@hierarchidb/common-api/*": [
        "packages/common/api/src/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "packages/runtime-ui/plugin-dialog/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "packages/runtime-ui/plugin-dialog/src/*"
      ],
      "@hierarchidb/ui-core": [
        "packages/ui/core/src/index.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "packages/ui/core/src/*"
      ],
      "@hierarchidb/ui-map": [
        "packages/ui/map/src/index.ts"
      ],
      "@hierarchidb/ui-map/*": [
        "packages/ui/map/src/*"
      ],
      "@hierarchidb/ui-csv-extract": [
        "packages/ui/csv-extract/src/index.ts"
      ],
      "@hierarchidb/ui-csv-extract/*": [
        "packages/ui/csv-extract/src/*"
      ],
      "@hierarchidb/auth-recovery": [
        "packages/feature/auth-recovery/src/index.ts"
      ],
      "@hierarchidb/auth-recovery/*": [
        "packages/feature/auth-recovery/src/*"
      ],
      "@hierarchidb/tabular": [
        "packages/feature/tabular/src/index.ts"
      ],
      "@hierarchidb/tabular/*": [
        "packages/feature/tabular/src/*"
      ],
      "@hierarchidb/table-metadata": [
        "packages/feature/table-metadata/src/index.ts"
      ],
      "@hierarchidb/table-metadata/*": [
        "packages/feature/table-metadata/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
