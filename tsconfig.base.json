{
  "compilerOptions": {
    "declarationMap": true,
    "noUnusedParameters": true,
    "noEmit": false,
    "noImplicitAny": true,
    "isolatedModules": true,
    "module": "NodeNext",
    "incremental": false,
    "allowUnusedLabels": false,
    "moduleResolution": "NodeNext",
    "paths": {
      "@hierarchidb/auth-recovery": [
        "packages/feature/auth-recovery/src/index.ts"
      ],
      "@hierarchidb/auth-recovery/*": [
        "packages/feature/auth-recovery/src/*"
      ],
      "@hierarchidb/batch": [
        "packages/feature/batch/src/index.ts"
      ],
      "@hierarchidb/batch/*": [
        "packages/feature/batch/src/*"
      ],
      "@hierarchidb/common-api": [
        "packages/common/api/src/index.ts"
      ],
      "@hierarchidb/common-auth": [
        "packages/common/auth/src/index.ts"
      ],
      "@hierarchidb/common-auth/*": [
        "packages/common/auth/src/*"
      ],
      "@hierarchidb/common-api/*": [
        "packages/common/api/src/*"
      ],
      "@hierarchidb/common-types": [
        "packages/common/types/src/index.ts"
      ],
      "@hierarchidb/common-types/*": [
        "packages/common/types/src/*"
      ],
      "@hierarchidb/components": [
        "packages/components/src/index.ts"
      ],
      "@hierarchidb/components/*": [
        "packages/components/src/*"
      ],
      "@hierarchidb/download": [
        "packages/feature/download/src/index.ts"
      ],
      "@hierarchidb/download/*": [
        "packages/feature/download/src/*"
      ],
      "@hierarchidb/plugin-runtime-services": [
        "packages/plugin-runtime-services/src/index.ts"
      ],
      "@hierarchidb/plugin-runtime-services/*": [
        "packages/plugin-runtime-services/src/*"
      ],
      "@hierarchidb/plugin-registry": [
        "packages/plugin-registry/generated/registry.ts"
      ],
      "@hierarchidb/plugin-registry/*": [
        "packages/plugin-registry/src/*",
        "packages/plugin-registry/generated/*"
      ],
      "@hierarchidb/plugin-ui-sdk": [
        "packages/plugin-ui-sdk/src/index.ts"
      ],
      "@hierarchidb/plugin-ui-sdk/*": [
        "packages/plugin-ui-sdk/src/*"
      ],
      "@hierarchidb/ui-plugin-basic-info": [
        "packages/ui/plugin-basic-info/src/index.ts"
      ],
      "@hierarchidb/ui-plugin-basic-info/*": [
        "packages/ui/plugin-basic-info/src/*"
      ],
      "@hierarchidb/ui-plugin-dialog": [
        "packages/ui/plugin-dialog/src/index.ts"
      ],
      "@hierarchidb/ui-plugin-dialog/*": [
        "packages/ui/plugin-dialog/src/*"
      ],
      "@hierarchidb/runtime-client": [
        "packages/runtime/client/src/index.ts"
      ],
      "@hierarchidb/runtime-client/*": [
        "packages/runtime/client/src/*"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata": [
        "packages/runtime-shared/fetch-metadata/src/index.ts"
      ],
      "@hierarchidb/runtime-shared-fetch-metadata/*": [
        "packages/runtime-shared/fetch-metadata/src/*"
      ],
      "@hierarchidb/runtime-ui-license": [
        "packages/runtime-ui/license/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-license/*": [
        "packages/runtime-ui/license/src/*"
      ],
      "@hierarchidb/runtime-worker": [
        "packages/runtime/worker/src/index.ts"
      ],
      "@hierarchidb/runtime-worker/*": [
        "packages/runtime/worker/src/*"
      ],
      "@hierarchidb/spreadsheet-plugin": [
        "plugins/spreadsheet-plugin/src/index.ts"
      ],
      "@hierarchidb/spreadsheet-plugin/*": [
        "plugins/spreadsheet-plugin/src/*"
      ],
      "@hierarchidb/table-metadata": [
        "packages/feature/table-metadata/src/index.ts"
      ],
      "@hierarchidb/table-metadata/*": [
        "packages/feature/table-metadata/src/*"
      ],
      "@hierarchidb/tabular": [
        "packages/feature/tabular/src/index.ts"
      ],
      "@hierarchidb/tabular/*": [
        "packages/feature/tabular/src/*"
      ],
      "@hierarchidb/ui-core": [
        "packages/ui/core/src/index.ts"
      ],
      "@hierarchidb/ui-core/*": [
        "packages/ui/core/src/*"
      ],
      "@hierarchidb/ui-csv-extract": [
        "packages/ui/tabular-extract/src/index.ts"
      ],
      "@hierarchidb/ui-csv-extract/*": [
        "packages/ui/tabular-extract/src/*"
      ],
      "@hierarchidb/ui-data-grid": [
        "packages/ui/data-grid/src/index.ts"
      ],
      "@hierarchidb/ui-data-grid/*": [
        "packages/ui/data-grid/src/*"
      ],
      "@hierarchidb/ui-datasource": [
        "packages/ui/datasource/src/index.ts"
      ],
      "@hierarchidb/ui-datasource/*": [
        "packages/ui/datasource/src/*"
      ],
      "@hierarchidb/ui-file": [
        "packages/ui/file/src/index.ts"
      ],
      "@hierarchidb/ui-file/*": [
        "packages/ui/file/src/*"
      ],
      "@hierarchidb/ui-icon": [
        "packages/ui/icon/src/index.ts"
      ],
      "@hierarchidb/ui-icon/*": [
        "packages/ui/icon/src/*"
      ],
      "@hierarchidb/ui-license": [
        "packages/ui/license/src/index.ts"
      ],
      "@hierarchidb/ui-license/*": [
        "packages/ui/license/src/*"
      ],
      "@hierarchidb/ui-map": [
        "packages/ui/map/src/index.ts"
      ],
      "@hierarchidb/ui-map/*": [
        "packages/ui/map/src/*"
      ],
      "@hierarchidb/ui-theme": [
        "packages/ui/theme/src/index.ts"
      ],
      "@hierarchidb/ui-theme/*": [
        "packages/ui/theme/src/*"
      ],
      "@hierarchidb/ui-treeconsole-base": [
        "packages/ui/treeconsole/base/src/index.ts"
      ],
      "@hierarchidb/ui-treeconsole-base/*": [
        "packages/ui/treeconsole/base/src/*"
      ],
      "@hierarchidb/*-plugin": [
        "plugins/*-plugin/src/index.ts"
      ],
      "@hierarchidb/util": [
        "packages/util/src/index.ts"
      ],
      "@hierarchidb/util/*": [
        "packages/util/src/*"
      ]
    },
    "noUnusedLocals": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "strict": true,
    "resolveJsonModule": true,
    "noImplicitReturns": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "target": "es2022",
    "noFallthroughCasesInSwitch": true,
    "composite": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".turbo",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
