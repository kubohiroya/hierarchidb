{
  "extends": "../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "~/*": ["app/src/*"],
      "~": ["app/src"],
      "~~/*": ["app/src/*"],
      "~~": ["app/src"],
      "@hierarchidb/plugin-registry": ["packages/plugin-registry/generated/registry.ts"],
      "@hierarchidb/plugin-registry/ui-loaders": [
        "packages/plugin-registry/generated/ui-loaders.ts"
      ],
      "@hierarchidb/plugin-registry/worker-loaders": [
        "packages/plugin-registry/generated/worker-loaders.ts"
      ],
      "@hierarchidb/plugin-registry/icon-loaders": [
        "packages/plugin-registry/generated/icon-loaders.ts"
      ],
      "@hierarchidb/plugin-registry/database-loaders": [
        "packages/plugin-registry/generated/database-loaders.ts"
      ],
      "@hierarchidb/plugin-registry/plugin-definitions": [
        "packages/plugin-registry/generated/plugin-definitions.ts"
      ],
      "@hierarchidb/plugin-registry/types": ["packages/plugin-registry/src/types.ts"],
      "@hierarchidb/plugin-registry/derivations": ["packages/plugin-registry/src/derivations.ts"],
      "@hierarchidb/plugin-registry/generated/registry": [
        "packages/plugin-registry/generated/registry.ts"
      ],
      "@hierarchidb/location-plugin/common": ["plugins/location-plugin/dist/common/index.d.ts"],
      "@hierarchidb/route-plugin/common": ["plugins/route-plugin/dist/common/index.d.ts"],
      "@hierarchidb/shape-plugin/common": ["plugins/shape-plugin/dist/common/index.d.ts"],
      "@hierarchidb/yaml-api/migration": ["packages/yaml-api/dist/migration/index.d.ts"],
      "@hierarchidb/yaml-api/validation": ["packages/yaml-api/dist/validation/index.d.ts"],
      "@hierarchidb/yaml-api/inverse-migration": [
        "packages/yaml-api/dist/inverse-migration/index.d.ts"
      ],
      "@hierarchidb/*": [
        "packages/*/dist/index.d.ts",
        "plugins/*/dist/index.d.ts",
        "packages/tools/*/dist/index.d.ts"
      ],
      "@hierarchidb/ui-*": ["packages/ui/*/dist/index.d.ts"],
      "@hierarchidb/ui-treeconsole-*": ["packages/ui/treeconsole/*/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../types/**/*.d.ts"],
  "files": []
}
