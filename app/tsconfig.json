{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "module": "NodeNext"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".generated/types/**/*.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
