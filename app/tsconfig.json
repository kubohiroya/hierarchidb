{
  "extends": "../tsconfig.package.local-alias.base.json",
  "compilerOptions": {
    "baseUrl": "..",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "~/*": ["app/src/*"],
      "~": ["app/src"],
      "~~/*": ["app/src/*"],
      "~~": ["app/src"],
      "@hierarchidb/*": [
        "packages/*/dist/index.d.ts",
        "plugins/*/dist/index.d.ts",
        "packages/tools/*/dist/index.d.ts"
      ],
      "@hierarchidb/ui-*": [
        "packages/ui/*/dist/index.d.ts"
      ],
      "@hierarchidb/ui-treeconsole-*": [
        "packages/ui/treeconsole/*/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../types/**/*.d.ts"
  ],
  "files": []
}
