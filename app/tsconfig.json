{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@hierarchidb/location-plugin/worker": ["../packages/node-type/location-plugin/dist/worker/index.js"],
      "@hierarchidb/timeline-plugin/worker": ["../packages/node-type/timeline-plugin/dist/worker/index.js"],
      
      "@hierarchidb/route-plugin/worker": ["../packages/node-type/route-plugin/dist/worker/index.mjs"],
      "@hierarchidb/shape-plugin/worker": ["../packages/node-type/shape-plugin/dist/worker/index.js"],
      "@hierarchidb/ui-auth": ["../packages/ui/auth/dist"],
      "@hierarchidb/ui-icon": ["../packages/ui/icon/dist"],
      "@hierarchidb/runtime-worker": ["../packages/runtime-worker/worker/dist"],
      "@hierarchidb/runtime-worker-bootstrap": ["../packages/runtime-worker/worker-bootstrap/dist"]
    },
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".generated/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
