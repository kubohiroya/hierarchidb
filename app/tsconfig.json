{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@hierarchidb/location-plugin/worker": ["../packages/node-type/location-plugin/src/worker/index.ts"],
      "@hierarchidb/project-plugin/worker": ["../packages/node-type/project-plugin/src/worker/index.ts"],
      "@hierarchidb/route-plugin/worker": ["../packages/node-type/route-plugin/src/worker/index.ts"],
      "@hierarchidb/shape-plugin/worker": ["../packages/node-type/shape-plugin/src/worker/index.ts"],
      "@hierarchidb/ui-auth": ["../packages/ui/auth/src/index.ts"],
      "@hierarchidb/ui-icon": ["../packages/ui/icon/src/index.ts"],
      "@hierarchidb/runtime-worker": ["../packages/runtime-worker/worker/src/index.ts"],
      "@hierarchidb/runtime-worker-bootstrap": ["../packages/runtime-worker/worker-bootstrap/src/index.ts"]
    },
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
