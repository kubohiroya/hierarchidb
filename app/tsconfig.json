{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@hierarchidb/*-plugin": [
        "../plugins/*-plugin/src/index.ts"
      ],
      "@hierarchidb/common-api": [
        "../packages/common/api/src/index.ts"
      ],
      "@hierarchidb/common-api/*": [
        "../packages/common/api/src/*"
      ],
      "@hierarchidb/common-auth": [
        "../packages/common/auth/src/index.ts"
      ],
      "@hierarchidb/common-auth/*": [
        "../packages/common/auth/src/*"
      ],
      "@hierarchidb/common-types": [
        "../packages/common/types/src/index.ts"
      ],
      "@hierarchidb/common-types/*": [
        "../packages/common/types/src/*"
      ],
      "@hierarchidb/auth-recovery": [
        "../packages/features/auth-recovery/src/index.ts"
      ],
      "@hierarchidb/auth-recovery/*": [
        "../packages/features/auth-recovery/src/*"
      ],
      "@hierarchidb/basemap-plugin": [
        "../plugins/basemap-plugin/src/index.ts"
      ],
      "@hierarchidb/basemap-plugin/*": [
        "../plugins/basemap-plugin/src/*"
      ],
      "@hierarchidb/shape-plugin": [
        "../plugins/shape-plugin/src/index.ts"
      ],
      "@hierarchidb/shape-plugin/*": [
        "../plugins/shape-plugin/src/*"
      ],
      "@hierarchidb/components": [
        "../packages/components/src/index.ts"
      ],
      "@hierarchidb/components/*": [
        "../packages/components/src/*"
      ],
      "@hierarchidb/download": [
        "../packages/features/download/src/index.ts"
      ],
      "@hierarchidb/download/*": [
        "../packages/features/download/src/*"
      ],
      "@hierarchidb/gis-sdk": [
        "../packages/features/gis-sdk/src/index.ts"
      ],
      "@hierarchidb/gis-sdk/*": [
        "../packages/features/gis-sdk/src/*"
      ],
      "@hierarchidb/ui-worker-client": [
        "../packages/ui/worker-client/src/index.ts"
      ],
      "@hierarchidb/ui-worker-client/*": [
        "../packages/ui/worker-client/src/*"
      ],
      "@hierarchidb/ui-worker-provider": [
        "../packages/ui/worker-provider/src/index.ts"
      ],
      "@hierarchidb/ui-worker-provider/*": [
        "../packages/ui/worker-provider/src/*"
      ],
      "@hierarchidb/ui-plugin-shell": [
        "../packages/ui/plugin-shell/src/index.ts"
      ],
      "@hierarchidb/ui-plugin-shell/*": [
        "../packages/ui/plugin-shell/src/*"
      ],
      "@hierarchidb/plugin-presentation": [
        "../packages/plugin-presentation/src/index.ts"
      ],
      "@hierarchidb/plugin-presentation/*": [
        "../packages/plugin-presentation/src/*"
      ],
      "@hierarchidb/plugin-registry": [
        "../packages/plugin-registry/generated/registry.ts"
      ],
      "@hierarchidb/plugin-registry/derivations": [
        "../packages/plugin-registry/src/derivations.ts"
      ],
      "@hierarchidb/plugin-registry/types": [
        "../packages/plugin-registry/src/types.ts"
      ],
      "@hierarchidb/plugin-registry/*": [
        "../packages/plugin-registry/generated/*",
        "../packages/plugin-registry/src/*"
      ],
      "@hierarchidb/plugin-service-api": [
        "../packages/plugin-service-api/src/index.ts"
      ],
      "@hierarchidb/plugin-service-api/*": [
        "../packages/plugin-service-api/src/*"
      ],
      "@hierarchidb/plugin-service-api/types/*": [
        "../packages/plugin-service-api/src/types/*"
      ],
      "@hierarchidb/plugin-ui-sdk": [
        "../packages/plugin-ui-sdk/src/index.ts"
      ],
      "@hierarchidb/plugin-ui-sdk/*": [
        "../packages/plugin-ui-sdk/src/*"
      ],
      "@hierarchidb/ui-dialog": [
        "../packages/ui/dialog/src/index.ts"
      ],
      "@hierarchidb/ui-dialog/*": [
        "../packages/ui/dialog/src/*"
      ],
      "@hierarchidb/ui-batch": [
        "../packages/ui/batch/src/index.ts"
      ],
      "@hierarchidb/ui-batch/*": [
        "../packages/ui/batch/src/*"
      ],
      "@hierarchidb/ui-plugin-basic-info": [
        "../packages/ui/plugin-basic-info/src/index.ts"
      ],
      "@hierarchidb/ui-plugin-basic-info/*": [
        "../packages/ui/plugin-basic-info/src/*"
      ],
      "@hierarchidb/ui-modal-select": [
        "../packages/ui/modal-select/src/index.ts"
      ],
      "@hierarchidb/ui-modal-select/*": [
        "../packages/ui/modal-select/src/*"
      ],
      "@hierarchidb/runtime-worker": [
        "../packages/runtime-worker/src/index.ts"
      ],
      "@hierarchidb/runtime-worker/*": [
        "../packages/runtime-worker/src/*"
      ],
      "@hierarchidb/ui-icon": [
        "../packages/ui/icon/src/index.ts"
      ],
      "@hierarchidb/ui-icon/*": [
        "../packages/ui/icon/src/*"
      ],
      "@hierarchidb/ui-i18n": [
        "../packages/ui/i18n/src/index.ts"
      ],
      "@hierarchidb/ui-i18n/*": [
        "../packages/ui/i18n/src/*"
      ],
      "@hierarchidb/util": [
        "../packages/util/src/index.ts"
      ],
      "@hierarchidb/util/*": [
        "../packages/util/src/*"
      ],
      "@hierarchidb/ui-csv-extract": [
        "../packages/ui/tabular-extract/src/index.ts"
      ],
      "@hierarchidb/ui-csv-extract/*": [
        "../packages/ui/tabular-extract/src/*"
      ],
      "@hierarchidb/ui-theme": [
        "../packages/ui/theme/src/index.ts"
      ],
      "@hierarchidb/ui-theme/*": [
        "../packages/ui/theme/src/*"
      ],
      "@hierarchidb/ui-map": [
        "../packages/ui/map/src/index.ts"
      ],
      "@hierarchidb/ui-map/*": [
        "../packages/ui/map/src/*"
      ],
      "@hierarchidb/ui-treeconsole-base": [
        "../packages/ui/treeconsole/base/src/index.ts"
      ],
      "@hierarchidb/ui-treeconsole-base/*": [
        "../packages/ui/treeconsole/base/src/*"
      ],
      "@hierarchidb/ui-treeconsole-toolbar": [
        "../packages/ui/treeconsole/toolbar/src/index.ts"
      ],
      "@hierarchidb/ui-treeconsole-toolbar/*": [
        "../packages/ui/treeconsole/toolbar/src/*"
      ]
    },
    "baseUrl": ".",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "../types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": []
}
