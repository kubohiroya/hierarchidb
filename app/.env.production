# Production environment for GitHub Pages
# Set base path for deployment
VITE_APP_NAME=hierarchidb
VITE_APP_PREFIX=hierarchidb
VITE_BASE_URL=/hierarchidb/
VITE_CORS_PROXY_BASE_URL=https://hierarchidb-cors-proxy.kubohiroya.workers.dev

# Hash routing configuration for GitHub Pages
# Set to 'true' to use hash-based routing (/#/path instead of /path)
# This avoids 404 redirect issues on GitHub Pages
VITE_USE_HASH_ROUTING=true

# Cloudflare Turnstile (replace with your production site key)
# VITE_TURNSTILE_SITE_KEY=your-production-site-key
