{
  "name": "@hierarchidb/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/entry.client.tsx",
  "scripts": {
    "predev": "node ../scripts/generate-plugin-loader.mjs && pnpm -w run check:deps:extra",
    "dev": "react-router dev",
    "test": "vitest run",
    "prebuild": "node ../scripts/prebuild-app.mjs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=6144\" react-router build --mode production && node scripts/fix-spa-build.js && touch build/client/assets/.nojekyll",
    "build:dev": "NODE_OPTIONS=\"--max-old-space-size=6144\" react-router build --mode development && node scripts/fix-spa-build.js",
    "build:vite": "vite build --mode production && node scripts/fix-spa-build.js",
    "generate:favicon": "node scripts/generate-favicon.js",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build/client -r git@github.com:kubohiroya/hierarchidb.git",
    "test:github-pages": "node scripts/test-github-pages.js",
    "debug:copy": "cp scripts/debug-*.html build/client/ && cp scripts/minimal-*.html build/client/",
    "debug:serve": "npx serve build/client -l 8080",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs",
    "build:react-router": "NODE_OPTIONS=\"--max-old-space-size=6144\" react-router build --mode production && node scripts/fix-spa-build.js && touch build/client/assets/.nojekyll"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/plugins-basemap-plugin": "workspace:*",
    "@hierarchidb/plugins-folder-plugin": "workspace:*",
    "@hierarchidb/plugins-linker-plugin": "workspace:*",
    "@hierarchidb/plugins-location-plugin": "workspace:*",
    "@hierarchidb/plugins-resolver-plugin": "workspace:*",
    "@hierarchidb/plugins-route-plugin": "workspace:*",
    "@hierarchidb/plugins-shape-plugin": "workspace:*",
    "@hierarchidb/plugins-spreadsheet-plugin": "workspace:*",
    "@hierarchidb/plugins-styler-plugin": "workspace:*",
    "@hierarchidb/plugins-timeline-plugin": "workspace:*",
    "@hierarchidb/runtime-ui-landingpage": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-ui-tour": "workspace:*",
    "@hierarchidb/runtime-shared-module-paths": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/tabular-xlsx": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-import-export": "workspace:*",
    "@hierarchidb/ui-layout": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-navigation": "workspace:*",
    "@hierarchidb/ui-routing": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@hierarchidb/ui-treeconsole-toolbar": "workspace:*",
    "@hierarchidb/ui-treeconsole-treetable": "workspace:*",
    "@hierarchidb/ui-usermenu": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@react-router/fs-routes": "^7.8.1",
    "@react-router/node": "^7.8.2",
    "comlink": "^4.4.2",
    "dexie": "^4.2.0",
    "isbot": "^5",
    "jotai": "^2.14.0",
    "react-draggable": "^4.5.0",
    "react-hook-geolocation": "^1.1.0",
    "react-resizable": "^3.0.5",
    "react-router": ">=7.0.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@hierarchidb/tools-plugin-registry-utils": "workspace:*",
    "@hierarchidb/tools-vite-plugin-dev-health": "workspace:*",
    "@hierarchidb/tools-vite-plugin-package-reader": "workspace:*",
    "@react-router/dev": "^7.8.2",
    "@vitejs/plugin-react": "^5.0.1",
    "gh-pages": "^6.3.0",
    "license-checker": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "5.12.0",
    "vite": "link:@react-router/dev/vite",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "maplibre-gl": "^5.7.3",
    "@vis.gl/react-maplibre": "^8.0.4",
    "@deck.gl/geo-layers": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/mapbox": "^9.1.14"

  },
  "peerDependencies": {
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom",
      "react-router"
    ]
  }
}
