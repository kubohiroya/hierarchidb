{
  "name": "@hierarchidb/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/entry.client.tsx",
  "scripts": {
    "predev": "node ../scripts/generate-plugin-loader.mjs && pnpm -w run check:deps:extra",
    "dev": "vite dev",
    "test": "vitest run",
    "prebuild": "node ../scripts/prebuild-app.mjs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=6144\" vite build --mode production && node scripts/fix-spa-build.js && touch dist/assets/.nojekyll",
    "build:dev": "NODE_OPTIONS=\"--max-old-space-size=6144\" vite build --mode development && node scripts/fix-spa-build.js",
    "build:vite": "vite build --mode production && node scripts/fix-spa-build.js",
    "generate:favicon": "node scripts/generate-favicon.js",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=6144\" tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist -r git@github.com:kubohiroya/hierarchidb.git",
    "test:github-pages": "node scripts/test-github-pages.js",
    "debug:copy": "cp scripts/debug-*.html dist/ && cp scripts/minimal-*.html dist/",
    "debug:serve": "npx serve dist -l 8080",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hierarchidb/basemap-plugin": "workspace:*",
    "@hierarchidb/components": "workspace:*",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/common-types": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/map-adapter": "workspace:*",
    "@hierarchidb/batch-api": "workspace:*",
    "@hierarchidb/batch-sdk": "workspace:*",
    "@hierarchidb/location-plugin": "workspace:*",
    "@hierarchidb/plugin-types": "workspace:*",
    "@hierarchidb/plugin-ui-sdk": "workspace:*",
    "@hierarchidb/route-plugin": "workspace:*",
    "@hierarchidb/runtime-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:*",
    "@hierarchidb/runtime-client": "workspace:*",
    "@hierarchidb/ui-tour": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/tabular-source-xlsx": "workspace:*",
    "@hierarchidb/spreadsheet-plugin": "workspace:*",
    "@hierarchidb/styler-plugin": "workspace:*",
    "@hierarchidb/timeline-plugin": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-dialog": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-icon": "workspace:*",
    "@hierarchidb/ui-layout": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-navigation": "workspace:*",
    "@hierarchidb/ui-routing": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@hierarchidb/ui-treeconsole-toolbar": "workspace:*",
    "@hierarchidb/ui-treeconsole-treetable": "workspace:*",
    "@hierarchidb/ui-usermenu": "workspace:*",
    "@hierarchidb/util": "workspace:*",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@tanstack/react-router": "^1.132.33",
    "comlink": "^4.4.2",
    "dexie": "^4.2.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "isbot": "^5",
    "jotai": "^2.14.0",
    "react-draggable": "^4.5.0",
    "react-hook-geolocation": "^1.1.0",
    "react-joyride": "^2.9.1",
    "react-resizable": "^3.0.5"
  },
  "devDependencies": {
    "@deck.gl/geo-layers": "^9.1.14",
    "@deck.gl/layers": "^9.1.14",
    "@deck.gl/mapbox": "^9.1.14",
    "@hierarchidb/vite-plugin-node-type-registry": "workspace:*",
    "@types/node": "^18.0.0",
    "@vis.gl/react-maplibre": "^8.0.4",
    "@vitejs/plugin-react": "^5.0.1",
    "gh-pages": "^6.3.0",
    "license-checker": "^25.0.1",
    "maplibre-gl": "^5.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "5.12.0",
    "vite": "^4.0.0",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom"
    ]
  }
}
