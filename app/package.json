{
  "name": "@hierarchidb/app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/entry.client.tsx",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build --mode production && node scripts/fix-spa-build.js && touch build/client/assets/.nojekyll",
    "build:dev": "react-router build --mode development && node scripts/fix-spa-build.js",
    "build:vite": "vite build --mode production && node scripts/fix-spa-build.js",
    "preview": "vite preview --config vite.preview.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\" \"*.{ts,js,json}\"",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d build/client -r git@github.com:kubohiroya/hierarchidb.git",
    "test:github-pages": "node scripts/test-github-pages.js",
    "debug:copy": "cp scripts/debug-*.html build/client/ && cp scripts/minimal-*.html build/client/",
    "debug:serve": "npx serve build/client -l 8080",
    "clean": "rm -rf dist",
    "clean:force": "rm -rf dist node_modules tsconfig.tsbuildinfo tsup.config.bundled_*.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hierarchidb/common-api": "workspace:*",
    "@hierarchidb/common-type": "workspace:*",
    "@hierarchidb/basemap-plugin": "workspace:*",
    "@hierarchidb/folder-plugin": "workspace:*",
    "@hierarchidb/shape-plugin": "workspace:*",
    "@hierarchidb/styler-plugin": "workspace:*",
    "@hierarchidb/runtime-ui-landingpage": "workspace:*",
    "@hierarchidb/runtime-ui-plugin-dialog": "workspace:*",
    "@hierarchidb/runtime-ui-tour": "workspace:*",
    "@hierarchidb/runtime-worker": "workspace:^",
    "@hierarchidb/runtime-worker-bootstrap": "workspace:*",
    "@hierarchidb/common-auth": "workspace:*",
    "@hierarchidb/ui-auth": "workspace:*",
    "@hierarchidb/ui-core": "workspace:*",
    "@hierarchidb/ui-i18n": "workspace:*",
    "@hierarchidb/ui-import-export": "workspace:*",
    "@hierarchidb/ui-layout": "workspace:*",
    "@hierarchidb/ui-map": "workspace:*",
    "@hierarchidb/ui-navigation": "workspace:*",
    "@hierarchidb/ui-routing": "workspace:*",
    "@hierarchidb/ui-theme": "workspace:*",
    "@hierarchidb/ui-treeconsole-base": "workspace:*",
    "@hierarchidb/ui-treeconsole-breadcrumb": "workspace:*",
    "@hierarchidb/ui-treeconsole-toolbar": "workspace:*",
    "@hierarchidb/ui-usermenu": "workspace:*",
    "@react-router/fs-routes": "^7.8.1",
    "@react-router/node": "^7.8.1",
    "@types/react-router": "^5.1.20",
    "comlink": "^4.4.2",
    "isbot": "^5.1.30",
    "react-hook-geolocation": "^1.1.0",
    "react-router": "^7.8.2",
    "react-router-dom": "^7.8.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@hierarchidb/tools-vite-plugin-package-reader": "workspace:*",
    "@react-router/dev": "^7.8.2",
    "@react-router/node": "^7.8.1",
    "@vitejs/plugin-react": "^5.0.1",
    "gh-pages": "^6.3.0",
    "license-checker": "^25.0.1",
    "vite": "link:@react-router/dev/vite",
    "vite-plugin-comlink": "^5.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-logger": "^1.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": ">=7.0.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1"
  },
  "license": "MIT",
  "tsup": {
    "external": [
      "@mui/icons-material",
      "@mui/material",
      "react",
      "react-dom",
      "react-router"
    ]
  }
}
