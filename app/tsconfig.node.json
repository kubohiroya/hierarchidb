{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "node",
      "vite/client"
    ],
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./.generated/types/node",
    "jsx": "react-jsx"
  },
  "include": [
    "vite.config.ts",
    "vite-plugin-*.ts"
  ],
  "extends": "../tsconfig.base.json"
}
