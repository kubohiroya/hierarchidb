# Environment Configuration Example
# Copy this file to .env.development or .env.production and adjust values

# Application Configuration
VITE_APP_NAME=hierarchidb
VITE_APP_TITLE=HierarchiDB
VITE_APP_DESCRIPTION=High-performance tree-structured data management framework
VITE_APP_DETAILS=A powerful framework for managing hierarchical data in browser environments
VITE_APP_LOGO=logo.png
VITE_APP_FAVICON=favicon.svg
VITE_APP_THEME=light
VITE_APP_LOCALE=en-US
VITE_APP_ATTRIBUTION=Your Name
VITE_APP_HOMEPAGE=https://github.com/kubohiroya/hierarchidb

# API Configuration
VITE_API_BASE_URL=
APP_HOMEPAGE=https://github.com/kubohiroya/hierarchidb

# Routing Configuration
# Hash routing is enabled by default for better compatibility with static hosting
# Set to 'false' to use standard browser routing (requires proper server configuration)
# VITE_USE_HASH_ROUTING=true  # default, can be omitted
# VITE_USE_HASH_ROUTING=false # uncomment to disable hash routing

# Plugin Runtime Flags (optional)
# Per-host concurrency for shared download service (if plugin wiring present)
LOCATION_PER_HOST_CONCURRENCY=4
ROUTE_PER_HOST_CONCURRENCY=4

# Enable runtime worker adapters (Comlink) for heavy stages
LOCATION_RUNTIME_WORKER=false
ROUTE_RUNTIME_WORKER=false

# Shape download strategy (experimental)
# Set to true to enable strategy-based selection in shape plugin pipeline
SHAPE_DOWNLOAD_STRATEGY=false
