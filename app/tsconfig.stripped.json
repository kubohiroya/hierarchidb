{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "Node16",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*.ts": [
        "./src/*"
      ],
      "~/*.tsx": [
        "./src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
