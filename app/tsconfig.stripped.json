{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*.ts": [
        "./src/*"
      ],
      "~/*.tsx": [
        "./src/*"
      ],
      "@hierarchidb/runtime-ui-appbar": [
        "../packages/runtime-ui/appbar/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-appbar/*": [
        "../packages/runtime-ui/appbar/src/*"
      ],
      "@hierarchidb/runtime-ui-datasource": [
        "../packages/runtime-ui/datasource/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-datasource/*": [
        "../packages/runtime-ui/datasource/src/*"
      ],
      "@hierarchidb/runtime-ui-landingpage": [
        "../packages/runtime-ui/landingpage/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-landingpage/*": [
        "../packages/runtime-ui/landingpage/src/*"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog": [
        "../packages/runtime-ui/plugin-dialog/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-plugin-dialog/*": [
        "../packages/runtime-ui/plugin-dialog/src/*"
      ],
      "@hierarchidb/runtime-ui-search-result-window": [
        "../packages/runtime-ui/search-result-window/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-search-result-window/*": [
        "../packages/runtime-ui/search-result-window/src/*"
      ],
      "@hierarchidb/runtime-ui-tour": [
        "../packages/runtime-ui/tour/src/index.ts"
      ],
      "@hierarchidb/runtime-ui-tour/*": [
        "../packages/runtime-ui/tour/src/*"
      ]
    },
    "module": "NodeNext"
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}
