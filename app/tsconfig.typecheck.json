{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "composite": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    // Inherit full workspace path mappings from app/tsconfig.json.
    // Do not override `paths` here to avoid clobbering workspace aliases.
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/app-typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
