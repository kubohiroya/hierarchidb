{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "composite": false,
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "baseUrl": ".",
    // Override workspace path mappings to avoid pulling source from other packages during app typecheck.
    // Keep only local alias and resolve workspace deps via their published type entries in package.json.
    "paths": {
      "~/*": ["src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/app-typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*"
  ]
}
