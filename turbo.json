{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "storybook-static/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "reports/**"
      ]
    },
    "lint": {},
    "format": {
      "dependsOn": [
        "^format"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": false
    },
    "wfl": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "reports/runtime-worker/*.xml"
      ],
      "cache": false
    }
  }
}
