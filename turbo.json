{
  "$schema": "https://v2-8-3.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!plans/**",
        "!reports/**",
        "!coverage/**",
        "!artifacts/**",
        "!playwright-report/**",
        "!storybook-static/**",
        "!e2e-results/**",
        "!tmp/**",
        "!dist/**",
        "!build/**",
        "!**/*.tsbuildinfo"
      ],
      "outputs": ["dist/**", "build/**", "storybook-static/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    },
    "lint": {},
    "format": {
      "dependsOn": ["^format"],
      "outputs": []
    },
    "check:deps": {
      "outputs": []
    },
    "guard:deps:extra": {
      "outputs": []
    },
    "policy:ban-tsconfig-paths-dist-dts": {
      "outputs": []
    },
    "policy:ban-tsconfig-paths-src": {
      "outputs": []
    },
    "shims:check": {
      "outputs": []
    },
    "as-any:check": {
      "outputs": []
    },
    "preflight": {
      "dependsOn": [
        "check:deps",
        "guard:deps:extra",
        "policy:ban-tsconfig-paths-dist-dts",
        "policy:ban-tsconfig-paths-src",
        "shims:check",
        "as-any:check"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!docs/**",
        "!plans/**",
        "!reports/**",
        "!coverage/**",
        "!artifacts/**",
        "!playwright-report/**",
        "!storybook-static/**",
        "!e2e-results/**",
        "!tmp/**",
        "!dist/**",
        "!build/**",
        "!**/*.tsbuildinfo"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": false
    },
    "wfl": {
      "dependsOn": ["^build"],
      "outputs": ["reports/runtime-worker/*.xml"],
      "cache": false
    }
  }
}
