{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "typecheck",
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "storybook-static/**"
      ]
    },
    "build:types": {
      "dependsOn": [
        "^build:types"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "@hierarchidb/plugin-types#typecheck": {
      "dependsOn": [
        "^typecheck",
        "@hierarchidb/plugin-ui-sdk#build"
      ]
    },
    "@hierarchidb/plugin-registry#typecheck": {
      "dependsOn": [
        "^typecheck",
        "@hierarchidb/plugin-registry#build:types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "reports/**"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": false
    },
    "wfl": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "reports/runtime-worker/*.xml"
      ],
      "cache": false
    }
  }
}
